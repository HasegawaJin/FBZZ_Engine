/// @file    ManagedBridgeContract.inl
/// @brief   C++ と C# の固定 ABI・数値 ID・単純 API 呼び出しの共通定義。
/// @author  Hasegawa Jin
/// @date    2026-10-04
/// @note C++ はマクロ展開、C# は Roslyn の AdditionalFiles から読み取る。wire の意味を変える場合は schema hash も更新する。
/// @see Docs/design/csharp-scripting.md C++ と C# に共通する公開契約。

FBZZ_MANAGED_CONST(uint32_t, uint, kManagedBridgeAbiVersion, VERSION, 1)
/// @note Animator service selector50 adds opt-in distance/interval pose LOD; existing selectors and packet meanings are unchanged.
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedAnimatorUpdateLodSelector, ANIMATOR_UPDATE_LOD_SELECTOR, 50)
/// @note 世代 0B は CREATE の保存 Script ID、GET_TYPE の schema/要件/実行順、exact Component 寿命と Script 存在 query を共有する。
FBZZ_MANAGED_CONST(uint64_t, ulong, kManagedBridgeSchemaHash, SCHEMA_HASH, 0x46425A5A4D414E14)
/// @note Generation 14 ships Audio181 selectors46-56, Terrain194 selectors16-17/Scene190 selectors2-3, and AI340 index0 crowd/index1 world poses together.
/// @note 世代13は描画/実行Componentのexact birth、可変長の線/mesh転送とnative通知をC#へ公開する。
/// @note 世代12 は全幅 primitive、bounded store/material転送、COUNT由来のComponent容量とTerrain/Water/VFX/Sequence/Joint/Render/Display/Assetsを共有する。
/// @note 世代11 は Play 採用46..48、portable DataAsset49..54 と、既存サービスの staged store semantics を共有する。
/// @note Store192/193 selector14 は key のみと found 応答、22beginUTF8、23raw(token64/offset64/count32/reserved32/bytes<=65512)、24commit、25abort を使う。
/// @note DataAsset open/prepare flags0=begin、1=raw UTF8 chunk(reserved0/1=offset64)、2=finish。読取53 flags0 は64KiB byte page、1 は bounded review。
/// @note 世代 10 は ComponentRef の保存住所と exact epoch/birth、Material/Texture GUID 型、Material/Save/Config を共有する。
/// @note BIND_OWNER の UTF8 は ownerGuid+改行+adapter birth UUID。Resolve33 は同じ Scene の保存住所のみを明示解決し Script の birth も返す。
/// @note CAPTURE_RELOAD flags1 は Edit の保存設定/KeepOnReload を移行し、private runtime cache を復元しない。

/// @note 世代 0F は候補と Undo の完全値を保持し、外部 review の対象・変更・詳細だけを aggregate byte 予算でページ化する。
/// @note 世代 0E は owned code generation lease を持ち、parked Edit/current Play/candidate の共存を保持する。
/// @note 世代 0C は不変観測の OPEN/READ/CLOSE、READ_FIELD flags2 の非 snapshot summary、caller buffer と範囲転送を共有する。
/// @note MANAGED_COMPONENTS flags1 は physical offset/index、reply index=written、integer=next offset、flags1=eof、出力は uint64 ID 列。
/// @note SERVICE_READ flags257 は reserved0/1 の byte offset、reply generation=total bytes、flags1=eof、outputBytes=written。
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedFieldSetting, FIELD_SETTING, 1)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedFieldObservation, FIELD_OBSERVATION, 2)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedNullValue, NULL_VALUE, 4)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedFieldHidden, FIELD_HIDDEN, 8)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedFieldRange, FIELD_RANGE, 16)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedFieldRequired, FIELD_REQUIRED, 32)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedFieldReloadState, FIELD_RELOAD_STATE, 64)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedInternalMode, INTERNAL_MODE, 1)
/// @note 1 packet の byte 予算。caller の論理 collection 件数を制限しない。
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedBatchPacketMaxBytes, MAX_BATCH_PACKET_BYTES, 65536)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedBatchReferenceBytes, BATCH_REFERENCE_BYTES, 16)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedBatchSetItemBytes, BATCH_SET_ITEM_BYTES, 28)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedBatchReadItemBytes, BATCH_READ_ITEM_BYTES, 16)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedBatchStatusBytes, BATCH_STATUS_BYTES, 4)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedCollisionHeaderBytes, COLLISION_HEADER_BYTES, 68)
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedPhysicsHitBytes, PHYSICS_HIT_BYTES, 40)
/// @note 名前catalogの1 page byte予算。名前数や全UTF8bytesの上限ではない。
FBZZ_MANAGED_CONST(uint32_t, uint, kManagedInputCatalogPacketBytes, INPUT_CATALOG_PACKET_BYTES, 65536)

