# @file    EngineModuleBoundaries.cmake
# @brief   許可依存と直接・推移・バックエンド・リンクの禁止境界を検証する。
# @author  Hasegawa Jin
# @date    2026-10-31
cmake_minimum_required(VERSION 3.25)
include("${SOURCE_ROOT}/CMake/EngineModuleBoundaries.cmake")
if(DEFINED CASE)
    set(MODULE Audio)
    set(PROBE "${FIXTURE_ROOT}/Projects/Engine/src/Audio/Probe.cpp")
    file(MAKE_DIRECTORY "${FIXTURE_ROOT}/Projects/Engine/src/Audio"
        "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Asset"
        "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene"
        "${FIXTURE_ROOT}/Projects/Graphics/src/Renderer/Platform/DX12")
    file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Script.hpp" "#pragma once\n")
    file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Asset/AssetPath.hpp" "#pragma once\n")
    file(WRITE "${PROBE}" "#include <Engine/Asset/AssetPath.hpp>\n")
    if(CASE STREQUAL "direct")
        file(WRITE "${PROBE}" "#include <Engine/Scene/Script.hpp>\n")
    elseif(CASE STREQUAL "transitive")
        file(APPEND "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Asset/AssetPath.hpp" "#include <Engine/Scene/Script.hpp>\n")
    elseif(CASE STREQUAL "backend")
        file(WRITE "${FIXTURE_ROOT}/Projects/Graphics/src/Renderer/Platform/DX12/Backend.hpp" "#pragma once\n")
        file(WRITE "${PROBE}" "#include \"../../../Graphics/src/Renderer/Platform/DX12/Backend.hpp\"\n")
    elseif(CASE STREQUAL "link")
        fbzz_validate_engine_links(Audio FBZZGraphics)
    elseif(CASE MATCHES "^graphics_")
        set(MODULE Rendering)
        file(MAKE_DIRECTORY "${FIXTURE_ROOT}/Projects/Graphics/src/Renderer"
            "${FIXTURE_ROOT}/Projects/Graphics/include/Graphics/Renderer")
        file(WRITE "${FIXTURE_ROOT}/Projects/Graphics/src/Renderer/Private.hpp" "#pragma once\n")
        file(WRITE "${FIXTURE_ROOT}/Projects/Graphics/include/Graphics/Renderer/Contract.hpp" "#pragma once\n")
        if(CASE STREQUAL "graphics_private")
            file(WRITE "${PROBE}" "#include \"../../../Graphics/src/Renderer/Private.hpp\"\n")
        else()
            file(WRITE "${PROBE}" "#include <Graphics/Renderer/Contract.hpp>\n")
            if(CASE STREQUAL "graphics_transitive_private")
                file(APPEND "${FIXTURE_ROOT}/Projects/Graphics/include/Graphics/Renderer/Contract.hpp"
                    "#include \"../../../src/Renderer/Private.hpp\"\n")
            endif()
        endif()
    elseif(CASE MATCHES "^assets_")
        set(MODULE Assets)
        file(MAKE_DIRECTORY "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Systems"
            "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Components")
        file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Systems/PhysicsSystem.hpp" "#pragma once\n")
        file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Components/Probe.hpp" "#pragma once\n")
        file(WRITE "${PROBE}" "#include <Engine/Scene/Components/Probe.hpp>\n")
        if(CASE STREQUAL "assets_system")
            file(WRITE "${PROBE}" "#include <Engine/Scene/Systems/PhysicsSystem.hpp>\n")
        elseif(CASE STREQUAL "assets_render_system")
            file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Systems/RenderSystem.hpp" "#pragma once\n")
            file(WRITE "${PROBE}" "#include <Engine/Scene/Systems/RenderSystem.hpp>\n")
        elseif(CASE STREQUAL "assets_transitive_system")
            file(APPEND "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Components/Probe.hpp"
                "#include <Engine/Scene/Systems/PhysicsSystem.hpp>\n")
        elseif(CASE STREQUAL "assets_transitive_c_header")
            file(APPEND "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Components/Probe.hpp"
                "#include \"Probe.h\"\n")
            file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Components/Probe.h"
                "#include <Engine/Scene/Systems/PhysicsSystem.hpp>\n")
        elseif(CASE STREQUAL "assets_scene")
            file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Scene.hpp" "#pragma once\n")
            file(WRITE "${PROBE}" "#include <Engine/Scene/Scene.hpp>\n")
        elseif(CASE STREQUAL "assets_bake_runtime")
            file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/BoneBakeRuntime.hpp" "#pragma once\n")
            file(WRITE "${PROBE}" "#include <Engine/Scene/BoneBakeRuntime.hpp>\n")
        endif()
    elseif(CASE MATCHES "^(scene_|rendering_scene_|host_render_)")
        set(MODULE Scene)
        file(MAKE_DIRECTORY "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Systems"
            "${FIXTURE_ROOT}/Projects/Engine/src/Scene/Systems")
        file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Systems/UIInteraction.hpp" "#pragma once\n")
        file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Systems/UISystem.hpp" "#pragma once\n")
        file(WRITE "${FIXTURE_ROOT}/Projects/Engine/src/Scene/Systems/RenderPrivate.hpp" "#pragma once\n")
        file(WRITE "${PROBE}" "#include <Engine/Scene/Systems/UIInteraction.hpp>\n")
        if(CASE STREQUAL "scene_render_private")
            file(WRITE "${PROBE}" "#include \"../Scene/Systems/RenderPrivate.hpp\"\n")
        elseif(CASE STREQUAL "scene_render_public")
            file(WRITE "${PROBE}" "#include <Engine/Scene/Systems/UISystem.hpp>\n")
        elseif(CASE STREQUAL "scene_render_context")
            file(MAKE_DIRECTORY "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Systems/RenderPasses")
            file(WRITE "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Systems/RenderPasses/RenderPassContext.hpp" "#pragma once\n")
            file(WRITE "${PROBE}" "#include <Engine/Scene/Systems/RenderPasses/RenderPassContext.hpp>\n")
        elseif(CASE STREQUAL "scene_render_transitive")
            file(APPEND "${FIXTURE_ROOT}/Projects/Engine/include/Engine/Scene/Systems/UIInteraction.hpp"
                "#include <Engine/Scene/Systems/UISystem.hpp>\n")
        elseif(CASE STREQUAL "rendering_scene_allowed")
            set(MODULE Rendering)
        elseif(CASE STREQUAL "host_render_allowed")
            set(MODULE Host)
            file(WRITE "${PROBE}" "#include <Engine/Scene/Systems/UISystem.hpp>\n")
        endif()
    elseif(CASE STREQUAL "host_editor")
        set(MODULE Host)
        file(MAKE_DIRECTORY "${FIXTURE_ROOT}/Projects/Editor/include/Editor")
        file(WRITE "${FIXTURE_ROOT}/Projects/Editor/include/Editor/Probe.hpp" "#pragma once\n")
        file(WRITE "${PROBE}" "#include <Editor/Probe.hpp>\n")
    endif()
    fbzz_validate_engine_module("${FIXTURE_ROOT}" "${MODULE}" "${PROBE}")
    return()
endif()

set(FIXTURE_BASE "${CMAKE_CURRENT_BINARY_DIR}/EngineModuleBoundaryFixture")
set(SUFFIX 0)
while(EXISTS "${FIXTURE_BASE}-${SUFFIX}")
    math(EXPR SUFFIX "${SUFFIX} + 1")
endwhile()
foreach(CASE allowed direct transitive backend link host_editor
    scene_allowed scene_render_private scene_render_public scene_render_context scene_render_transitive rendering_scene_allowed host_render_allowed
    graphics_allowed graphics_private graphics_transitive_private
    assets_allowed assets_system assets_render_system assets_transitive_system assets_transitive_c_header assets_scene assets_bake_runtime)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DSOURCE_ROOT=${SOURCE_ROOT}" "-DCASE=${CASE}" "-DFIXTURE_ROOT=${FIXTURE_BASE}-${SUFFIX}/${CASE}"
        -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    if(CASE STREQUAL "allowed" OR CASE STREQUAL "assets_allowed" OR CASE STREQUAL "graphics_allowed" OR CASE MATCHES "_allowed$")
        if(NOT RESULT EQUAL 0)
            message(FATAL_ERROR "Allowed dependency rejected: ${OUTPUT}${ERROR}")
        endif()
    elseif(RESULT EQUAL 0 OR NOT "${ERROR}" MATCHES "Engine (link )?boundary")
        message(FATAL_ERROR "Forbidden ${CASE} dependency was not diagnosed: ${OUTPUT}${ERROR}")
    endif()
endforeach()
