# @file    SandboxProjectPreservation.cmake
# @brief   Sandbox初回配置と再ビルドが編集済み原本を保持することを検証する。
# @author  Hasegawa Jin
# @date    2026-10-30
cmake_minimum_required(VERSION 3.25)
set(fixture "${CMAKE_CURRENT_BINARY_DIR}/SandboxProjectPreservation")
file(REMOVE_RECURSE "${fixture}")
set(SOURCE_DIR "${fixture}/Template")
set(DEST_DIR "${fixture}/Project")
set(BUILD_DIR "${fixture}/Runtime")
set(MANAGED_STARTER_DIR "${fixture}/Managed")
set(ENGINE_ASSET_DIR "${fixture}/EngineAssets")
file(MAKE_DIRECTORY "${SOURCE_DIR}/Assets/Scenes" "${SOURCE_DIR}/ProjectSettings"
    "${MANAGED_STARTER_DIR}/Assets/Scripts" "${MANAGED_STARTER_DIR}/.vscode" "${ENGINE_ASSET_DIR}")
file(WRITE "${SOURCE_DIR}/Assets/Scenes/Main.scene" "template scene")
file(WRITE "${SOURCE_DIR}/Assets/Scenes/Main.scene.meta" "template guid")
file(WRITE "${SOURCE_DIR}/ProjectSettings/ProjectSettings.toml" "template settings")
file(WRITE "${MANAGED_STARTER_DIR}/Starter.Scripts.csproj" "starter project")
file(WRITE "${MANAGED_STARTER_DIR}/Fbzz.ScriptBuild.props" "starter props")
file(WRITE "${MANAGED_STARTER_DIR}/Assets/Scripts/Start.cs" "starter script")
file(WRITE "${MANAGED_STARTER_DIR}/Assets/Scripts/Start.cs.meta" "starter script guid")
file(WRITE "${ENGINE_ASSET_DIR}/Shared.hlsl" "engine shader")
include("${SOURCE_ROOT}/Projects/Sandbox/EnsureSandboxProject.cmake")
function(ExpectFile relative expected)
    if(NOT EXISTS "${DEST_DIR}/${relative}")
        message(FATAL_ERROR "Missing seeded file: ${relative}")
    endif()
    file(READ "${DEST_DIR}/${relative}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unexpected contents: ${relative}")
    endif()
endfunction()
ExpectFile("Assets/Scenes/Main.scene.meta" "template guid")
ExpectFile("Assets/Scripts/Start.cs.meta" "starter script guid")
ExpectFile("Fbzz.ScriptBuild.props" "starter props")
ExpectFile("Assets/Shared.hlsl" "engine shader")
file(WRITE "${DEST_DIR}/Assets/Scenes/Main.scene" "edited scene")
file(WRITE "${DEST_DIR}/Assets/Scenes/Main.scene.meta" "edited guid")
file(WRITE "${DEST_DIR}/ProjectSettings/ProjectSettings.toml" "edited settings")
file(WRITE "${DEST_DIR}/.fbzz_proj" "edited launch configuration")
file(WRITE "${DEST_DIR}/Assets/OnlyInProject.asset" "user asset")
file(REMOVE "${DEST_DIR}/Sandbox.Scripts.csproj")
include("${SOURCE_ROOT}/Projects/Sandbox/EnsureSandboxProject.cmake")
ExpectFile("Assets/Scenes/Main.scene" "edited scene")
ExpectFile("Assets/Scenes/Main.scene.meta" "edited guid")
ExpectFile("ProjectSettings/ProjectSettings.toml" "edited settings")
ExpectFile(".fbzz_proj" "edited launch configuration")
ExpectFile("Assets/OnlyInProject.asset" "user asset")
set(DEST_DIR "${fixture}/ExistingAsset")
file(MAKE_DIRECTORY "${DEST_DIR}/Assets/Scenes")
file(WRITE "${DEST_DIR}/Assets/Scenes/Main.scene" "existing without meta")
include("${SOURCE_ROOT}/Projects/Sandbox/EnsureSandboxProject.cmake")
ExpectFile("Assets/Scenes/Main.scene" "existing without meta")
if(EXISTS "${DEST_DIR}/Assets/Scenes/Main.scene.meta")
    message(FATAL_ERROR "Template GUID must not be assigned to an existing asset")
endif()
file(REMOVE_RECURSE "${fixture}")
