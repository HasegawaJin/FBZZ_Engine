# FBZZ Engine
# VFXLine.mat
# VFX Line (雷・ビーム) の既定マテリアル。加算・両面・HDR の芯とグロー。
# albedo / intensity / phase は VFXLineSystem が MaterialComponent の paramOverrides へ毎フレーム書く
# (共有アセットは汚れない)。ここの値は «何も書かれなかったときに成立する絵» の既定値。
version = 1
name = 'VFXLine'
shader = 'Assets/Shaders/Material/Effects/VFXLine.hlsl'
blend_mode = 'Additive'
double_sided = true
depth_write = false
render_queue = 3000
render_path = 'auto'
mesh_type = 'surface'

[params]
albedo = [ 0.35, 0.6, 1.0, 1.0 ]
coreColor = [ 1.0, 1.0, 1.0, 1.0 ]
coreWidth = 0.25
glowFalloff = 2.4
intensity = 4.0
phase = 0.0
breakup = 0.4
pulseSpeed = 0.0
pulseDensity = 0.0
endFade = 0.06
