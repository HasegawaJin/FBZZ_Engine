# FBZZ Engine
# Smoke09_Premultiplied.mat
# 煤煙。six-way lighting 前提。
# WHY: 素材 1 枚につき 1 マテリアルを置くことで、複数の Emitter から
#      同じ素材設定を共有できる。
# shader を空にしてあるのは «組み込み Particle.hlsl で描く» の意味。
# 素材: Assets/Textures/Particles/smoke_09.png
version = 1
shader = ""
blend_mode = "Premultiplied"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "Assets/Textures/Particles/smoke_09.png"

[params]
albedo = [1.0, 1.0, 1.0, 1.0]

[particle]
lighting_strength = 0.85
receive_shadows = true
shadow_strength = 0.7
six_way_lighting = true
smoke_back_scatter_power = 3.0
smoke_transmission = 1.1
smoke_wrap = 0.65
soft_particles = true
