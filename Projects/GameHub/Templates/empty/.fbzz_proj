# @file    .fbzz_proj
# @brief   C# プロジェクトの起動先と Standalone のビルド構成。
# @author  Hasegawa Jin
# @date    2026-05-25
[project]
name = "{{PROJECT_NAME}}"
project_id = "{{PROJECT_ID}}"
target_name = "{{TARGET_NAME}}"
standalone_target_name = "{{TARGET_NAME}}Standalone"
engine_version = "{{ENGINE_VERSION}}"
created_at = "{{CREATED_AT}}"
default_scene = "Assets/Scenes/Main.scene"
asset_root = "Assets/"
settings_path = "ProjectSettings/ProjectSettings.toml"
binary_root = "Binaries/"
build_root = "Build/VS/"

[engine]
sdk_id = "{{SDK_ID}}"
