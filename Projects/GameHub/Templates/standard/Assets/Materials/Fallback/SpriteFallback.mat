# FBZZ Engine
# SpriteFallback.mat
# SpriteRendererの既定Alpha Blend両面マテリアル
version = 1
shader = "Assets/Shaders/Material/Surface/Unlit.hlsl"
blend_mode = "AlphaBlend"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "auto"
mesh_type = "surface"

[textures]
albedo = ""

[params]
albedo = [1.0, 1.0, 1.0, 1.0]
