version = 1
shader = "Assets/Shaders/Material/Surface/PBR.hlsl"
blend_mode = "Opaque"
double_sided = false
render_queue = 2000
render_path = "auto"
mesh_type = "surface"

[textures]
albedo = ""
normal = ""
metallic = ""
emissive = ""
ao = ""

# SSR テスト用 - 濡れた床 (dielectric, roughness=0.02)
# 非金属でも roughness が非常に低いと Fresnel による SSR 反射が強く出る。
[params]
albedo = [0.6, 0.62, 0.65, 1.0]
metallic = [0.0]
roughness = [0.02]
normalStrength = [1.0]
occlusionStrength = [1.0]
emissiveColor = [0.0, 0.0, 0.0]
emissiveScale = [0.0]
uvTiling = [1.0, 1.0]
uvOffset = [0.0, 0.0]
alphaCutoff = [0.5]
