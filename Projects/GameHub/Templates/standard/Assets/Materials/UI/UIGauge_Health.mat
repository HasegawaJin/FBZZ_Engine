version = 1
shader = "Assets/Shaders/UI/Material/UIGauge.hlsl"
render_path = "ui"
blend_mode = "AlphaBlend"
double_sided = true
render_queue = 4000

[textures]

[params]
fillColor = [ 0.16, 0.89, 0.77, 1.0 ]
trackColor = [ 0.05, 0.07, 0.09, 0.85 ]
cornerRadius = [ 9.0, 9.0, 9.0, 9.0 ]
fillRatio = [ 1.0 ]
fillFromRight = [ 0.0 ]
edgeGlowWidth = [ 14.0 ]
edgeGlowGain = [ 0.8 ]
tickInterval = [ 0.0 ]
tickWidth = [ 2.0 ]
tickAlpha = [ 0.55 ]
