# FBZZ Engine
# Spark06_Additive.mat
# 放射状の火花。
# WHY: 素材 1 枚につき 1 マテリアルを置くことで、複数の Emitter から
#      同じ素材設定を共有できる。
# shader を空にしてあるのは «組み込み Particle.hlsl で描く» の意味。
# 素材: Assets/Textures/Particles/spark_06.png
version = 1
shader = ""
blend_mode = "Additive"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "Assets/Textures/Particles/spark_06.png"

[params]
albedo = [1.0, 1.0, 1.0, 1.0]

[particle]
emissive_scale = 3.5
