[[links]]
from = 1
to = 9
trigger = 1
delay = 0.0

[[groups]]
id = 1
title = "Flame Body"
note = "外炎(Alpha=輪郭) + 芯炎(加算=発光) + 陽炎。全部加算にすると白飽和して光の玉になる。"
x = 230.0
y = -90.0
width = 290.0
height = 620.0
color = [0.86, 0.46, 0.16, 0.16]

[[groups]]
id = 2
title = "Airborne"
note = "火の粉・煤煙・光。six-way lighting で煙が炎の色を拾う (strength は 1.0 未満に)。"
x = 550.0
y = -90.0
width = 290.0
height = 600.0
color = [0.48, 0.44, 0.52, 0.14]

[[groups]]
id = 3
title = "Air Flow"
note = "上昇加速度の唯一の出所。Emitter 側 gravity は全て 0 で、伸びはここだけで決まる。"
x = 850.0
y = -90.0
width = 290.0
height = 380.0
color = [0.28, 0.58, 0.52, 0.14]

# ------------------------------------------------------------------------------
# 公開パラメーター
# 注意: default は生成時に必ず [nodes.particle] のフィールドを上書きする
#       (VFXGraphSystem::ApplyVFXBindings)。ノード側の値を直したら、その leaf を
#       bind しているパラメーターの default も必ず同じ値へ揃えること。
#       揃っていないとノード側の編集が「保存はされるが効かない」状態になる。
# ------------------------------------------------------------------------------

[[parameters]]
name = "Intensity"
type = 0
minimum = 0.0
maximum = 300.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 60.0
[[bindings]]
paramName = "Intensity"
nodeId = 2
schemaPath = "particle.emitRate"

# 炎の高さは寿命で決まる (上昇速度は Convection 側が持つ)。
[[parameters]]
name = "Flame Height"
type = 0
minimum = 0.2
maximum = 2.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.6
[[bindings]]
paramName = "Flame Height"
nodeId = 2
schemaPath = "particle.lifetime"

[[parameters]]
name = "Heat Haze"
type = 0
minimum = 0.0
maximum = 0.12
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.022
[[bindings]]
paramName = "Heat Haze"
nodeId = 4
schemaPath = "particle.distortionStrength"

# 空気の乱れ。Emitter 固有ノイズではなく Updraft 力場を駆動するので、
# 炎・煙・火の粉が同時に同じ揺れ方をする。
[[parameters]]
name = "Turbulence"
type = 0
minimum = 0.0
maximum = 6.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 1.0
[[bindings]]
paramName = "Turbulence"
nodeId = 8
schemaPath = "forceField.strength"

# 炎の伸び。上昇加速度の唯一の出所なので、全レイヤーの高さがこれで揃って動く。
[[parameters]]
name = "Updraft"
type = 0
minimum = 0.0
maximum = 6.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 1.4
[[bindings]]
paramName = "Updraft"
nodeId = 9
schemaPath = "forceField.strength"

[[parameters]]
name = "Light Intensity"
type = 0
minimum = 0.0
maximum = 40.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 4.2
[[bindings]]
paramName = "Light Intensity"
nodeId = 7
schemaPath = "light.intensity"

# 炎の縦横比。1 に近づけるとキャンプファイアの丸い炎、Y を上げると松明の細い炎になる。
# 注意: この層は angularVelocity を 0 にしてある。回転させると Particle.hlsl が
#       回転の後に軸倍率を掛けるため、スプライトが平行四辺形へせん断される。
[[parameters]]
name = "Flame Shape"
type = 4
hasRange = false
[parameters.default]
source = 0
constantType = 4
vector3 = [0.85, 1.3, 1.0]
[[bindings]]
paramName = "Flame Shape"
nodeId = 2
schemaPath = "particle.sizeAxisScale"

# 火の粉の尾の長さ。0 で尾なし (点のみ) になる。
[[parameters]]
name = "Spark Trail"
type = 1
minimum = 1.0
maximum = 8.0
hasRange = true
[parameters.default]
source = 0
constantType = 1
int = 6
[[bindings]]
paramName = "Spark Trail"
nodeId = 5
schemaPath = "particle.trailPointCount"

# 色のばらつき。0 で単色、上げるほど炎の中に色温度差が出る。
[[parameters]]
name = "Color Variation"
type = 0
minimum = 0.0
maximum = 0.5
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.15
[[bindings]]
paramName = "Color Variation"
nodeId = 2
schemaPath = "particle.colorVariation"
[[bindings]]
paramName = "Color Variation"
nodeId = 3
schemaPath = "particle.colorVariation"
