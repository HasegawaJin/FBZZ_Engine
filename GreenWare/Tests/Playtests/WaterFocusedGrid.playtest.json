    { "do": "frames", "count": 60 },
    { "do": "capture", "view": "scene", "name": "WaterFocusedGrid/NearLitAdvanced" },
    { "do": "bus", "request": { "t": "editor.op.invoke", "id": "render.set_view_mode", "args": { "mode": "wireframe_unlit" } } },
    { "do": "frames", "count": 30 },
    { "do": "capture", "view": "scene", "name": "WaterFocusedGrid/NearWireframe" },
    { "do": "bus", "request": { "t": "viewport.camera", "position": [1, 25, -1200], "lookAt": [1, 19, -1050] } },
    { "do": "frames", "count": 2 },
    { "do": "capture", "view": "scene", "name": "WaterFocusedGrid/TranslatedWireframe" },
    { "do": "bus", "request": { "t": "component.set", "id": "cb59fb12-45ae-437d-86dc-139886244005", "comp": "WaterComponent", "field": "cameraFocusedGrid", "value": false } },
    { "do": "assert", "query": { "t": "node.components", "id": "cb59fb12-45ae-437d-86dc-139886244005" }, "path": "components.0.fields.cameraFocusedGrid", "op": "==", "value": false },
    { "do": "frames", "count": 30 },
    { "do": "capture", "view": "scene", "name": "WaterFocusedGrid/FixedWireframe" },
    { "do": "bus", "request": { "t": "component.set", "id": "cb59fb12-45ae-437d-86dc-139886244005", "comp": "WaterComponent", "field": "cameraFocusedGrid", "value": true } },
    { "do": "assert", "query": { "t": "node.components", "id": "cb59fb12-45ae-437d-86dc-139886244005" }, "path": "components.0.fields.cameraFocusedGrid", "op": "==", "value": true },
    { "do": "assert", "query": { "t": "node.components", "id": "cb59fb12-45ae-437d-86dc-139886244005" }, "path": "components.0.fields.nearCellSize", "op": "==", "value": 2.0 },
    { "do": "bus", "request": { "t": "editor.op.invoke", "id": "render.set_view_mode", "args": { "mode": "lit" } } },
    { "do": "frames", "count": 30 },
    { "do": "capture", "view": "scene", "name": "WaterFocusedGrid/RestoredLit" },
    { "do": "assert", "query": { "t": "shader.diagnostics" }, "path": "errorCount", "op": "==", "value": 0 }
  ]
