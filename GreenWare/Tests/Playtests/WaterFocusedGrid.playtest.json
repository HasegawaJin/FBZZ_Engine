{
  "name": "WaterFocusedGrid",
  "scene": "Assets/Scenes/Test/ShowcaseCoast.scene",
  "lockstep": 0.016666667,
  "steps": [
    { "do": "assert", "query": { "t": "node.components", "id": "cb59fb12-45ae-437d-86dc-139886244005" }, "path": "components.0.type", "op": "==", "value": "WaterComponent" },
    { "do": "assert", "query": { "t": "node.components", "id": "cb59fb12-45ae-437d-86dc-139886244005" }, "path": "components.0.fields.cameraFocusedGrid", "op": "==", "value": true },
    { "do": "assert", "query": { "t": "node.components", "id": "cb59fb12-45ae-437d-86dc-139886244005" }, "path": "components.0.fields.nearCellSize", "op": "==", "value": 2.0 },
    { "do": "bus", "request": { "t": "component.set", "id": "cb59fb12-45ae-437d-86dc-139886244005", "comp": "WaterComponent", "field": "nearCellSize", "value": 3.0 } },
    { "do": "assert", "query": { "t": "node.components", "id": "cb59fb12-45ae-437d-86dc-139886244005" }, "path": "components.0.fields.nearCellSize", "op": "==", "value": 3.0 },
    { "do": "bus", "request": { "t": "component.set", "id": "cb59fb12-45ae-437d-86dc-139886244005", "comp": "WaterComponent", "field": "nearCellSize", "value": 2.0 } },
    { "do": "bus", "request": { "t": "viewport.camera", "position": [0, 25, -1200], "lookAt": [0, 19, -1050] } },
    { "do": "bus", "request": { "t": "editor.op.invoke", "id": "render.set_view_mode", "args": { "mode": "lit" } } },
    { "do": "frames", "count": 60 },
    { "do": "capture", "view": "scene", "name": "WaterFocusedGrid/NearLit" },
