# 斜面を流れ落ちる水 — 液体の «見た目» のパラメーターを明示的に組んだ見本。
# softness / extinction / gloss / fresnel の 4 つが、粒の集まりを水面らしく見せる。
# 傾けた plane コライダーが滑り台で、水はそこを舐めて落ちる。
version = 2
kind = "liquid"
seed = 47

[liquid]
max_particles = 4000
particle_radius = 0.013
gravity = 5.0
viscosity = 0.12
cohesion = 0.45
solver_iterations = 5
floor = true
floor_height = -0.95
floor_friction = 0.35
particle_lifetime = 1.0

[[source]]
name = "Spill"
shape = "box"
center = [-0.35, 0.64, 0.0]
size = [0.22, 0.05, 0.12]
velocity = [0.25, -0.4, 0.0]
spread = 0.12
count = 1000
duration = 1.1

[[collider]]
name = "Slide"
shape = "plane"
center = [0.0, -0.1, 0.0]
direction = [0.16, 0.99, 0.0]
friction = 0.25

[render]
shading = "liquid"
liquid_color = [0.32, 0.62, 0.88, 0.88]
liquid_radius_scale = 2.7
liquid_threshold = 0.45
liquid_softness = 0.12
liquid_extinction = 42.0
liquid_gloss = 128.0
liquid_fresnel = 0.035
specular = 1.0

[output]
frame_size = 256
columns = 8
rows = 8
supersampling = 2
duration = 1.2
warmup = 0.0
loop = false
motion_vectors = true

[bake]
mode = "3d"
volume_resolution = 96
ray_steps = 192
shadow_steps = 16
solver = "cpu"
