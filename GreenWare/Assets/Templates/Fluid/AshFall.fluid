# 降る灰 — «沈む気体» の見本。weight (密度に比例する下向き) が buoyancy を上回ると、
# 同じソルバーのまま煙が落ちる。上から湧かせて風で流し、drag で終端速度を作る。
# detail_period を長くすると細部ノイズが流れに引き伸ばされ、落ちる筋になる。
version = 2
kind = "gas"
seed = 73

[gas]
buoyancy = 0.15
weight = 0.55
vorticity = 0.3
turbulence = 0.25
turbulence_scale = 3.0
density_dissipation = 0.18
temperature_dissipation = 2.0
velocity_damping = 0.08
detail_period = 2.4
wind = [0.12, 0.0, 0.0]

[[source]]
name = "Fall"
shape = "box"
center = [0.0, 0.85, 0.0]
size = [0.9, 0.06, 0.5]
density = 2.2
temperature = 0.0
noise = 0.9
velocity = [0.0, -0.35, 0.0]
duration = 0.0

[[force]]
name = "Terminal"
type = "drag"
strength = 0.5

[[force]]
name = "Drift"
type = "noise"
strength = 0.7
noise_frequency = 2.0
noise_speed = 0.35

[render]
shading = "smoke"
smoke_color = [0.58, 0.57, 0.56, 1.0]
shadow_color = [0.13, 0.12, 0.12, 1.0]
opacity = 1.6
self_shadow = 1.2
detail_strength = 0.5
detail_scale = 9.0

[output]
frame_size = 256
columns = 8
rows = 8
supersampling = 2
duration = 3.0
warmup = 2.0
loop = true
motion_vectors = true

[bake]
mode = "3d"
volume_resolution = 96
ray_steps = 192
shadow_steps = 16
solver = "gpu"
six_way_lightmaps = true
scattering_octaves = 4
