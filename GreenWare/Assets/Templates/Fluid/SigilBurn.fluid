# 焼き付く紋章 — texture 形状の湧き口の見本。画像の «形» のまま燃料が湧き、
# 点火して崩れながら昇る。板は direction が法線で、既定の (0,0,1) なら画像が正面を向く。
# 画像は白黒でなく «アルファ» が形。差し替えれば別の紋章になる。
version = 2
kind = "gas"
seed = 53

[gas]
buoyancy = 1.5
weight = 0.04
vorticity = 0.6
turbulence = 0.22
turbulence_scale = 6.0
density_dissipation = 0.7
temperature_dissipation = 1.1
burn_rate = 3.0
burn_heat = 1.3
burn_smoke = 0.5
burn_expansion = 0.25
ignition_temperature = 0.18

[[source]]
name = "Sigil"
shape = "texture"
texture = "Assets/Textures/Particles/symbol_02.png"
center = [0.0, -0.2, 0.0]
size = [1.6, 1.6, 0.06]
direction = [0.0, 0.0, 1.0]
density = 1.4
temperature = 1.9
fuel = 3.6
noise = 0.35
velocity = [0.0, 0.35, 0.0]
duration = 0.35

[[force]]
name = "Lift"
type = "wind"
direction = [0.0, 1.0, 0.0]
strength = 0.55
start_time = 0.3

[render]
shading = "fire"
smoke_color = [0.26, 0.24, 0.24, 1.0]
shadow_color = [0.05, 0.04, 0.04, 1.0]
opacity = 2.2
self_shadow = 1.4
detail_strength = 0.45
detail_scale = 12.0
fire_intensity = 1.3
fire_kelvin = 1600.0

[output]
frame_size = 256
columns = 8
rows = 8
supersampling = 2
duration = 1.5
warmup = 0.0
loop = false
motion_vectors = true

[bake]
mode = "2d"
blackbody_emission = true
scattering_octaves = 4
