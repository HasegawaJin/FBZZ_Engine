# 配管に当たる冷却水 — capsule のコライダーの見本。
# size.x = 管の太さ (半径)、size.y = 芯の半分の長さ、direction = 管の軸。
# 横から当てた噴流が管を舐めて左右へ割れる。管そのものは焼いた絵に写らない。
version = 2
kind = "liquid"
seed = 83

[liquid]
max_particles = 3500
particle_radius = 0.012
gravity = 5.5
viscosity = 0.05
cohesion = 0.25
solver_iterations = 4
floor = true
floor_height = -0.95
floor_friction = 0.5
particle_lifetime = 0.9

[[source]]
name = "Nozzle"
shape = "sphere"
center = [-0.72, 0.34, 0.0]
size = [0.07, 0.07, 0.07]
velocity = [3.2, 0.5, 0.0]
spread = 0.22
count = 1200
duration = 0.9

[[collider]]
name = "Pipe"
shape = "capsule"
center = [0.08, 0.1, 0.0]
size = [0.13, 0.42, 0.0]
direction = [0.28, 1.0, 0.0]
friction = 0.35

[render]
shading = "liquid"
liquid_color = [0.46, 0.74, 0.92, 0.8]
liquid_radius_scale = 2.6
liquid_threshold = 0.48
liquid_softness = 0.1
liquid_extinction = 48.0
liquid_gloss = 120.0
liquid_fresnel = 0.03
specular = 1.0

[output]
frame_size = 256
columns = 8
rows = 8
supersampling = 2
duration = 1.3
warmup = 0.0
loop = false
motion_vectors = true

[bake]
mode = "3d"
volume_resolution = 96
ray_steps = 192
shadow_steps = 16
solver = "cpu"
