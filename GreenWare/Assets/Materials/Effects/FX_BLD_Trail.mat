# FX_BLD_Trail.mat
# 刀が掃いた面そのもの。BladeTrailComponent が 2 つのソケットの跡から張る帯へ差す。
#
# WHY 刀の色 (赤青) を持たないか:
#   軌跡は «斬った» を伝える層で、«どちらの刀か» は当たりの光条と一閃 (刀の色) が言う。
#   毎振り画面いっぱいに赤青を撒くと、当たった瞬間の色が振った跡に埋もれる。
#   色は金 → 白熱の 1 系統に固定し、段や溜めの差は heat (明るさと色温度) だけで出す。
#
# 何をどちらが持つか:
#   phase / heat / flash … スクリプトが毎フレーム書く。位相・«一振りの格»・命中は
#                          どれもゲームの状態なので静的値にできない。
#   それ以外     … ここが正本。«軌跡の質» は段でも刀でも変わらない。
#
# 2026-09-12 の見直し (刀身の残像から帯へ戻したとき):
#   殻を 1 枚にした (BladeTrailComponent の Shells) ので、層で稼いでいた明るさを
#   intensity と opacity へ戻した。節・火花・繊維は «速さ» を足す飾りで、強いと
#   帯の上に模様が浮いて «何かの柄» に見える ─ 刃の筋 (rail) より必ず弱くした。
version = 1
name = 'FX_BLD_Trail'
shader = 'guid:1f521ab179121645ef7960a975eeb14c'
blend_mode = 'Premultiplied'
# 掃過面は «裏» から見る時間の方が長い (振り抜いた後はカメラの反対を向く)。
double_sided = true
depth_write = false
render_queue = 3000
render_path = 'auto'
mesh_type = 'surface'

[params]
debugMode = 0.0

# ── 色 ──────────────────────────────────────────────────────────────────────
# 芯は白熱 (わずかに暖色)、主色は金、縁は冷たい青へ抜ける。
# WHY 縁を補色にするか: 金一色だと «明るい金の板» で厚みが出ない。抜けていく側だけ
#     色相を離すと、同じ帯の中に温度差が生まれて «熱を持った面» として読める。
coreColor = [ 3.4, 3.15, 2.75, 1.0 ]
edgeColor = [ 2.10, 1.30, 0.42, 1.0 ]
fringeColor = [ 0.30, 0.52, 1.05, 1.0 ]

# スクリプトが書くまでの値。
phase = 0.0
heat = 0.0
flash = 0.0

# 1 枚 + 薄い暈なので、殻 3 枚の頃 (1.10) より上げる。
intensity = 0.95
# 芯だけが背景を隠す。層が 1 枚になったので 0.30 → 0.45 へ戻した。
# 上げすぎると明るい背景で «灰色の板» が出る。
opacity = 0.45

# ── 弧位置 ──────────────────────────────────────────────────────────────────
# uv.x は «弧のどこか» (0 が刃側、1 が振り始め)。一振りはその場に残り、
# 消えるときに BladeTrailComponent が uv.x を進める (尾から抜ける)。
# 1.0 で線形。上げるほど尾側が暗く «刃側だけ» の短い弧に見える。
lifeFalloff = 0.9
# 刃の直後に残る白熱の長さ [経過比]。ここが刀身と光を繋ぐ。
headLength = 0.12
headBoost = 1.6
# 帯の «地»。鋭さは «暗い地に細い線» でしか作れないので、筋より十分暗く保つ。
bodyGain = 0.28

# ── 刃の横断 ────────────────────────────────────────────────────────────────
# 切っ先へ向かって明るくする。1.0 で線形、上げるほど «切っ先だけが光る»。
# 2.2 → 1.8: 帯が太くなった分、内側まで少し地を残して «面» として読ませる。
bodyFalloff = 1.8
# 白熱の筋は切っ先のすぐ内側。1.0 に置くと帯の端で半分が切れて線が細く見える。
railBias = 0.88
# 細く・強く。«鋭い» は幅ではなく地との差が作る。
railWidth = 0.07
railBoost = 2.8
dispersion = 0.012
# 鍔側の立ち上がり。0 にすると帯の根元が四角く切れて «光る板» が生えて見える。
rootFade = 0.12
tipFade = 0.07
# 内側の弧 (鍔の側) の縁。位置は rootFade がそのまま決める。
# 切っ先の筋より必ず弱く ─ 同じ明るさで 2 本引くと、どちらが刃なのかが読めなくなる。
spineWidth = 0.085
spineBoost = 0.35

# ── 節 ──────────────────────────────────────────────────────────────────────
# 掃過方向へ流れる刻み。0 だと静止画で «ただの帯» になる。
# 5 → 3 本・削り 0.55 → 0.25: 深く削ると帯が «連なった塊» に割れ、柄に見える。
bandCount = 3.0
# 位相の巻き取り (64) で飛ばないよう 1/2^n を選ぶ。
bandSpeed = 0.5
# «く» の字に寝かせる。0 にすると帯に直交した «梯子» になって模様として読まれる。
bandSkew = 1.6
bandSharp = 2.2
bandDepth = 0.25
bandBoost = 0.2

# ── 絹の繊維 ────────────────────────────────────────────────────────────────
# 帯を «速く流れている面» に見せる層。0 にすると 1 枚の板に戻る。
streakDensity = 18.0
streakSharp = 4.0
streakGain = 0.32
# 位相の巻き取りで飛ばないよう 1/2^n を選ぶ。
streakDrift = 0.25

# ── 掠める角 ────────────────────────────────────────────────────────────────
# 真横から見たときに軌跡が消えないための唯一の項。0 にすると «振ったのに何も
# 出ない角度» ができる。
rimPower = 1.6
rimBoost = 0.85

# ── 抜け ────────────────────────────────────────────────────────────────────
# 細かい砂で抜けるより、大きめの塊で柔らかく溶ける方が «刃の跡» として品が出る。
dissolveScale = 4.0
dissolveSoft = 0.24
# 鍔側から先に千切れる指数。下げると帯全体が同時に抜けて «一斉に消えた» になる。
dissolveBias = 1.8

# ── 火花 ────────────────────────────────────────────────────────────────────
# 当たりの火花 (FX_BLD_SlashHit) と一閃が別にあるので、帯の上の火花は «ちらつき» 程度に。
sparkDensity = 20.0
sparkRate = 0.15
sparkBoost = 0.7
