# FBZZ Engine
# FX_BLD_Trail.mat
# 刀が掃いた面そのもの。BladeTrailComponent が 2 つのソケットの跡から張る帯へ差す。
#
# WHY 極性色を持たないか:
#   軌跡は «斬った» を伝える層で、«どちらの剣か» は自分の纏いと環が受け持つ。
#   毎振り画面いっぱいに赤青を撒くと、盤面の極が軌跡に埋もれる (企画書 12.2) ─
#   極性色の弧 (旧 FX_BLD_Slash) を 2026-09-06 に廃したのはこれが理由。
#   色は金 → 白熱の 1 系統に固定し、段や溜めの差は heat (明るさと色温度) だけで出す。
#
# 何をどちらが持つか:
#   phase / heat / flash … スクリプトが毎フレーム書く。位相・«一振りの格»・命中は
#                          どれもゲームの状態なので静的値にできない。
#   それ以外     … ここが正本。«軌跡の質» は段でも極でも変わらない。
version = 1
name = 'FX_BLD_Trail'
shader = 'Assets/Shaders/Material/Effects/WeaponTrail.hlsl'
blend_mode = 'Premultiplied'
# 掃過面は «裏» から見る時間の方が長い (振り抜いた後はカメラの反対を向く)。
double_sided = true
depth_write = false
render_queue = 3000
render_path = 'auto'
mesh_type = 'surface'

[params]
debugMode = 0.0

# ── 色 ──────────────────────────────────────────────────────────────────────
# 芯は白熱 (わずかに暖色)、主色は金、縁は冷たい青へ抜ける。
# WHY 縁を補色にするか: 金一色だと «明るい金の板» で厚みが出ない。抜けていく側だけ
#     色相を離すと、同じ帯の中に温度差が生まれて «熱を持った面» として読める。
coreColor = [ 3.2, 2.95, 2.55, 1.0 ]
edgeColor = [ 2.10, 1.30, 0.42, 1.0 ]
fringeColor = [ 0.30, 0.52, 1.05, 1.0 ]

# スクリプトが書くまでの値。
phase = 0.0
heat = 0.0
flash = 0.0

# 殻が 3 枚 + 暈で 4 層重なるので、1 層あたりは以前より控えめにする。
intensity = 1.10
# 芯だけが背景を隠す。上げすぎると明るい背景で «灰色の板» が出る。
# WHY 下げたか: 隠す量は層の数だけ積み上がる。厚みを付けた 2026-09-06 に
#     0.55 のままだと、4 層ぶんが重なって帯が乳白色に潰れた。
opacity = 0.30

# ── 弧位置 ──────────────────────────────────────────────────────────────────
# uv.x は 2026-09-07 から «経過» ではなく «弧のどこか» (0 が刃側、1 が振り始め)。
# 一振りはその場に残り、消えるときに BladeTrailComponent が uv.x を進める (尾から抜ける)。
# 1.0 で線形。上げるほど尾側が暗く «刃側だけ» の短い弧に見える。
# WHY 下げたか (1.55 → 0.9): 跡が空間に残るようになったので、三日月の形は幾何が出す。
#     尾を明るさで消すと、振り始めの半分が最初から見えず «半分の弧» になる。
lifeFalloff = 0.9
# 刃の直後に残る白熱の長さ [経過比]。ここが刀身と光を繋ぐ。
headLength = 0.10
headBoost = 2.4
# WHY 下げたか: 帯の «地» が明るいほど、その上の筋も節も差が出なくなる。
#     鋭さは «暗い地に細い線» でしか作れないので、地は控えて線に予算を回す。
bodyGain = 0.50

# ── 刃の横断 ────────────────────────────────────────────────────────────────
# 切っ先へ向かって明るくする。1.0 で線形、上げるほど «切っ先だけが光る»。
# WHY 控えめか: BladeTrailComponent が古い側を鍔から詰める (Tail Taper) ので、跡の
#     後ろ半分はもともと切っ先の近くしか残っていない。ここまで強く落とすと、
#     痩せた帯が二重に暗くなって尾が消える。
bodyFalloff = 2.2
# 白熱の筋は切っ先のすぐ内側。1.0 に置くと帯の端で半分が切れて線が細く見える。
railBias = 0.88
# 細く・強く。«鋭い» は幅ではなく地との差が作る。
railWidth = 0.105
railBoost = 3.6
dispersion = 0.06
# 鍔側の立ち上がり。0 にすると帯の根元が四角く切れて «光る板» が生えて見える。
rootFade = 0.10
tipFade = 0.07

# 内側の弧 (鍔の側) の縁。位置は rootFade がそのまま決める。
# 切っ先の筋 (railBoost 2.9) より必ず弱く ─ 同じ明るさで 2 本引くと、
# どちらが刃なのかが三日月から読めなくなる。
spineWidth = 0.085
spineBoost = 1.15

# ── 節 ──────────────────────────────────────────────────────────────────────
# 掃過方向へ流れる刻み。これが 0 だと、帯の色は横断方向の 1 本のグラデーションしか
# 持たず、静止画にすると «ただの帯» になる (2026-09-06 «のっぺり» の主因)。
bandCount = 5.0
# 位相の巻き取り (64) で飛ばないよう 1/2^n を選ぶ。
bandSpeed = 0.5
# «く» の字に寝かせる。0 にすると帯に直交した «梯子» になって模様として読まれる。
bandSkew = 1.6
bandSharp = 2.2
# 削る深さ。上げるほど «連なった塊» に分離するが、1 に近づけると帯が途切れて見える。
bandDepth = 0.55
bandBoost = 1.5

# ── 絹の繊維 ────────────────────────────────────────────────────────────────
# 帯を «速く流れている面» に見せる層。0 にすると 1 枚の板に戻る。
streakDensity = 22.0
streakSharp = 3.5
streakGain = 0.75
# 位相の巻き取りで飛ばないよう 1/2^n を選ぶ。
streakDrift = 0.25

# ── 掠める角 ────────────────────────────────────────────────────────────────
# 真横から見たときに軌跡が消えないための唯一の項。0 にすると «振ったのに何も
# 出ない角度» ができる。
rimPower = 1.6
rimBoost = 2.2

# ── 抜け ────────────────────────────────────────────────────────────────────
dissolveScale = 5.5
dissolveSoft = 0.18
# 鍔側から先に千切れる指数。下げると帯全体が同時に抜けて «一斉に消えた» になる。
dissolveBias = 1.8

# ── 火花 ────────────────────────────────────────────────────────────────────
sparkDensity = 20.0
sparkRate = 0.22
sparkBoost = 2.4
