# FBZZ Engine
# FX_WPN_Beam.mat
# 極性エミッターの照射ビーム。PolarityGunComponent が LineRenderer へ差して使う。
# 素材: Assets/VFX/Textures/T_Beam_Stripe.png (X 方向シームレス。必須)
#
# WHY 事前乗算か: 芯は背景を隠して光り、縁は加算グローとして素通しにするため。
#      詳細は Assets/Shaders/Material/Effects/Beam.hlsl のヘッダー。
#      LineRenderer が blend_mode を握り潰さなくなったので、ここの指定が実際に効く。
#
# 何をどちらが持つか:
#   albedo             … LineRenderer が startColor から毎フレーム書く (極性色 × 明るさ)。
#   layer / surge      … PolarityGunComponent が層と手応えを毎フレーム書く。
#   乱れ (phase 以下)  … 同じくスクリプト。残量と命中で動くので静的な値では成立しない。
#   立体・撚り・リング … ここが正本。線の «質» はゲームの状態で変わらないので、
#                        Inspector ではなく .mat 側で決める (絵の調整はここだけを触る)。
version = 1
name = 'FX_WPN_Beam'
shader = 'Assets/Shaders/Material/Effects/Beam.hlsl'
blend_mode = 'Premultiplied'
double_sided = true
depth_write = false
render_queue = 3000
render_path = 'auto'
mesh_type = 'surface'

[textures]
albedo = "guid:a359f1c0b98e9f5f2481834e44ae12eb"

[params]
albedo = [ 1.0, 0.12, 0.14, 1.0 ]
coreWidth = 0.34
edgeFalloff = 2.4
coreBoost = 2.0
intensity = 1.0
tiling = 6.0
scroll = 0.0
muzzleFade = 0.04
tipFade = 0.08
phase = 0.0
arcAmp = 0.35
arcFreq = 9.0
crackle = 0.45
flicker = 0.25
beadDensity = 4.0
beadFalloff = 12.0
layer = 1.0
surge = 0.0

# 帯を円柱として解く。volume を下げると従来どおりの平らな線に戻る。
volume = 1.0
detail = 0.65
# 芯の白熱。上げすぎると ＋ (赤) と − (青) が同じ白線に見える (企画書 12.2)。
coreWhite = 0.34

# 管の «壁»。shellRadius は帯の半幅比なので、1.0 に寄せるほど輪郭ぎりぎりを走る。
shellRadius = 0.58
shellWidth = 0.17
shellBoost = 0.55
dispersion = 0.05

# 撚り。braidTwist は «タイル 1 枚あたりの巻き数» なので、距離が変わっても
# 1m あたりの巻き密度は変わらない。
filaments = 3.0
braid = 0.42
braidTwist = 0.45
braidSpeed = 0.25

# 衝撃波リング。ringSpeed は位相 (巻き取り周期 128) に掛かるので 1/2^n を選ぶ。
ringDensity = 0.4
ringSpeed = 0.25
ringSharpness = 14.0
ringBoost = 1.1

# 端の閃光。帯の長さに対する割合。
muzzleFlare = 0.1
tipFlare = 0.14
axialGlint = 1.6
