# FBZZ Engine
# FX_BLD_Slash.mat
# 双剣の斬撃。SlashArcComponent が手続きメッシュの帯へ差して使う。
#
# WHY ＋と− で .mat を分けないか:
#   撃破コア (FX_POL_Core_Plus/Minus) が分かれているのは ParticlePass が材質を
#   materialPath でグローバルに 1 つだけ持ち、GameObject ごとの override が
#   届かないため。斬撃は MeshRenderer なので MaterialInstance が効く。
#   極性色は SlashArcComponent が albedo へ per-instance で書く。
#
# 何をどちらが持つか:
#   albedo / progress / decay / flash / phase … スクリプトが毎フレーム書く。
#                        振った剣の極と 2 本の時計はゲームの状態なので静的値にできない。
#   それ以外           … ここが正本。«弧の質» は極でも段でも変わらない。
#                        絵の調整はこのファイルだけを触る。
version = 1
name = 'FX_BLD_Slash'
shader = 'Assets/Shaders/Material/Effects/PolaritySlash.hlsl'
blend_mode = 'Premultiplied'
double_sided = true
depth_write = false
render_queue = 3000
render_path = 'auto'
mesh_type = 'surface'

[params]
# 切り分け用。0 = 通常。
#   1 … 帯を単色で塗る。模様を一切通さないので、ここで縞や途切れが見えたら
#        原因は «帯の張り方 / UV / 描画状態» で、このシェーダーの模様ではない。
#   2 … uv を色で出す (R = 弧に沿った進み / G = 横断)。R が端から端へ一度だけ
#        0→1 へ登れば UV は正しい。何度も繰り返すならそれが «繰り返し» の正体。
#   3 … 在る量だけを白で出す。時計と寿命の確認用。
debugMode = 0.0

# スクリプトが書くまでの見え方。＋ (赤) を既定にしておく。
albedo = [ 1.0, 0.12, 0.14, 1.0 ]
progress = 0.0
decay = 0.0
phase = 0.0
flash = 0.0

# 頭は «刃» なので鋭く。尾は帯の半分強まで熱を残す。
headSharp = 0.03
tailLength = 0.55
intensity = 1.15

# 峰を中央より刃の側へ寄せる。中央 (0.5) に置くと帯が左右対称になり、どちらが刃で
# どちらが尾なのかが 1 枚の弧から読めない。
#
# NOTE: 帯のどちら側が «刃» になるかは AddRibbonFacing の側ベクトル
#   (Cross(視線, 進行方向)) が決めるので、カメラの位置関係で反転しうる。
#   峰が尾の側に付いて見えたら 0.62 を 0.38 にする (1 から引くだけ)。
edgeBias = 0.62
edgeWidth = 0.13
edgeBoost = 2.6
bodyFalloff = 2.0

# 白熱。上げすぎると ＋ (赤) と − (青) が同じ白い弧に見える (企画書 12.2)。
edgeWhite = 0.55
heatLength = 0.14
dispersion = 0.07

rootFade = 0.05
tipFade = 0.09

# ── ギザギザ ──
# 峰そのものを折る。線は繋がったまま «うねる» ので、ここを上げても弧は途切れない。
# 上げすぎると折れが «のこぎりの歯» として模様に見えてくる。
serrateAmp = 0.035
serrateScale = 11.0
serrateGrowth = 1.2
# 外周の崩れの深さ。**弧が途切れて見えるときはまずここを 0 にすること。**
# 0 で崩れが完全に消え、弧は必ず 1 本の繋がった帯になる (切り分け用の逃げ道)。
serrateBite = 0.30

# ── 雷 ──
# 3 本。増やすほど «太い 1 本» に見えてくるので、密度は boltTwist で稼ぐ。
boltCount = 3.0
boltWidth = 0.085
boltWander = 0.42
boltJag = 0.30
boltTwist = 7.0
# 位相の巻き取り (128) で飛ばないよう 1/2^n を選ぶ。
boltSpeed = 0.5
boltBreak = 9.0
# 8 割が点いている。下げるほど放電が疎になるが、下げすぎると弧の «上» が
# まばらになって、帯そのものが途切れているように読まれる。
boltGate = 0.80
boltBoost = 2.2
boltWhite = 0.62

# ── びりびり (火花) ──
sparkDensity = 26.0
sparkRate = 0.30
sparkSharp = 22.0
sparkBoost = 2.6

# ── 残光 ──
# 刃が通った場所が保つ明るさの «床»。掃過の熱が引いてもここまでは必ず残るので、
# 弧は端から端まで 1 本に繋がる。下げるほど «頭だけの短い光» に寄る。
residueGain = 0.42
# 全体を引き始める時点。それまでは形を保ったまま «在る»。
residueFadeStart = 0.45
dissolveScale = 6.5
dissolveSoft = 0.16
# 崩れを外周へ寄せる指数。下げると峰まで崩れて弧が途切れる。
dissolveBias = 2.4
# 崩れながら «散る» 動き。VS が頂点を動かすので、色を落とすだけの消え方にならない。
# 上げすぎると跡が膨らんで «煙» に見え、刃の軌跡として読めなくなる。
residueSpread = 0.32
residueLift = 0.22

# ── 刃先 ──
# 切っている «点» そのもの。狭くて強いほど «刃» に見える。
headFlare = 0.075
headBoost = 3.2
