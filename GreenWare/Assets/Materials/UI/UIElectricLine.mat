version = 1
name = 'UIElectricLine'
shader = "Assets/Shaders/UI/Material/UIElectricLine.hlsl"
render_path = "ui"
blend_mode = "Additive"
double_sided = true
render_queue = 4000

[textures]

[params]
# 刀の芯の色 (BladeColors と同じ)。
plusColor = [ 1.0, 0.415686, 0.360784, 1.0 ]
minusColor = [ 0.388235, 0.643137, 1.0, 1.0 ]
coreColor = [ 1.0, 0.97, 0.92, 0.9 ]
# burst / phase は ScreenDressingComponent が要素ごとに上書きする。既定は «出ていない»。
burst = 0.0
phase = 0.0
# 下線の位置は Logo_Rule.png の線の高さに合わせる (矩形の上から 50%)。
lineY = 0.5
amplitude = 0.22
thickness = 1.2
glowWidth = 9.0
segments = 14.0
