# FBZZ Engine
# Flame05_Premultiplied.mat
# 炎の body。輪郭を作る層。
# WHY: 素材 1 枚につき 1 マテリアルを置くことで、複数の Emitter から
#      同じ素材設定を共有できる。
# shader を空にしてあるのは «組み込み Particle.hlsl で描く» の意味。
# 素材: Assets/Textures/Particles/flame_05.png
version = 1
shader = ""
blend_mode = "Premultiplied"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "guid:00b36765479641c58b3b4f9cbfb5539a"

[params]
albedo = [1.0, 1.0, 1.0, 1.0]

[particle]
soft_particle_fade_distance = 0.35
soft_particles = true
