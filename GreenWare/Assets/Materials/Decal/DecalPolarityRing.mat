version = 1
name = 'DecalPolarityRing'
shader = 'Assets/Shaders/Material/Decal/Material/DecalPolarityRing.hlsl'
render_path = 'decal'
blend_mode = 'AlphaBlend'
double_sided = true
render_queue = 3000

[params]
# 極の色は 1 枚ごとの override が決める (PolarityRingComponent / PolarityFieldComponent)。
# 共有 .mat へ極の色を書くと、＋の環を出した瞬間に残っている−の環まで赤くなる。
# ここに置くのは «無極のときの色» で、白へ寄せず読める青灰に留める。
ringColor = [ 0.55, 0.80, 1.00, 0.75 ]
fillColor = [ 0.30, 0.55, 0.95, 0.10 ]

# 環は OBB の外接円のすぐ内側。1.0 ぴったりだと角度フェードの縁と重なって薄くなる。
ringRadius = 0.94
ringWidth = 0.030
edgeSoftness = 0.35
fillStrength = 0.55

# 目盛りは 24 本。多いと «輪» に潰れ、少ないと時計に見える。
tickCount = 24.0
tickWidth = 0.30
tickLength = 0.075
spin = 0.0

# 実線率。切れ目を入れると «計器» に寄り、実線だと «壁» に見える。
dashRatio = 0.55
pulse = 1.0

# 掃きは既定で «終わっている» = 出さない。弾けた瞬間だけ呼び出し側が 0 から進める。
sweep = 1.0
sweepWidth = 0.18

# 中心をどこまで抜くか。自機と敵の足元が塗りで潰れない値。
innerFade = 0.55
