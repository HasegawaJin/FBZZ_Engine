# @file    Glass.mat
# @brief   物理的な屈折・透過を実装するまでの alpha 合成による透明球。
# @author  Hasegawa Jin
# @date    2026-09-30
blend_mode = 'AlphaBlend'
depth_test = 'LessEqual'
depth_write = false
double_sided = false
mesh_type = 'surface'
render_path = 'auto'
render_queue = 3000
shader = 'guid:73d100e5a351425aaf52953c23425438|Assets/Shaders/Material/Surface/PBR.hlsl'
version = 1

[params]
albedo = [ 0.9599999785423279, 0.9800000190734863, 1.0, 0.18000000715255737 ]
alphaCutoff = 0.0
anisotropy = 0.0
clearcoat = 0.0
clearcoatRoughness = 0.0
emissiveColor = [ 0.0, 0.0, 0.0 ]
emissiveScale = 0.0
metallic = 0.0
normalStrength = 1.0
occlusionStrength = 1.0
roughness = 0.02500000037252903
sheen = 0.0
sheenColor = [ 0.0, 0.0, 0.0 ]
uvOffset = [ 0.0, 0.0 ]
uvTiling = [ 1.0, 1.0 ]

[textures]
albedo = ''
ao = ''
emissive = ''
metallic = ''
normal = ''
tex5 = ''
tex6 = ''
tex7 = ''
