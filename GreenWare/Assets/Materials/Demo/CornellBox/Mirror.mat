emissiveScale = 0.0
metallic = 1.0
normalStrength = 1.0
occlusionStrength = 1.0
roughness = 0.014999999664723873
sheen = 0.0
sheenColor = [ 0.0, 0.0, 0.0 ]
uvOffset = [ 0.0, 0.0 ]
uvTiling = [ 1.0, 1.0 ]

[textures]
albedo = ''
ao = ''
emissive = ''
metallic = ''
normal = ''
tex5 = ''
