# GreenWare
# M_E_ArmorGrey_Dissolve.mat
# 蛇の撃破ディゾルブ用。無傷 (dissolveAmount = 0) のあいだは元の M_E_ArmorGrey と同じ絵。
# 差し替えは EnemyDeathVfxComponent が撃破の瞬間に行い、dissolveAmount だけを 0 -> 1 へ動かす。
#
# ボス 1 と数値が違うのは形の差。あちらは全高 6.6m の «立っているもの» で足元から
# 崩れるが、蛇は床の上に伏せた 24m の弧で、高さは山の 3.5m しかない。掃引の軸を
# 上向き (+Y) にして «床に近い所から溶けて山だけが残る» 順にし、範囲は床下に潜っている
# 分 (-6m) まで含めて 9m を取る。ノイズはボス 1 (2.4) より粗い ─ 24m を同じ細かさで
# 食うと、遠目には «一様に薄くなった» にしか見えない。
blend_mode = 'Opaque'
double_sided = false
mesh_type = 'skinned'
name = 'M_E_ArmorGrey_Dissolve'
render_path = 'auto'
shader = 'Assets/Shaders/Material/Skinned/SkinnedEnemyDissolve.hlsl'
version = 1

[params]
albedo = [ 0.34, 0.35, 0.37, 1.0 ]
metallic = 0.0
roughness = 0.45
# 0 = 無傷。スクリプトがここだけを動かす。
dissolveAmount = 0.0
# 掃引の «先に残る» 向き。+Y なので低い所から食われる。
dissolveAxis = [ 0.0, 1.0, 0.0 ]
dissolveRange = 9.0
# 0 = 全身同時に穴が開く / 1 = 端から順に食われる。
dissolveSweep = 0.45
dissolveNoiseScale = 1.6
dissolveEdgeWidth = 0.22
# 縁の色は帯 (M_E_Ring_Idle) と同じ琥珀。撃破の粒とも揃える。
dissolveEdgeColor = [ 1.0, 0.72, 0.30 ]
dissolveEdgeIntensity = 7.0
