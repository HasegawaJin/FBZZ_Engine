# GreenWare
# M_E_Hazard_Dissolve.mat
# 撃破ディゾルブ用。無傷 (dissolveAmount = 0) のあいだは元の M_E_Hazard と同じ絵になる。
blend_mode = 'Opaque'
double_sided = false
mesh_type = 'skinned'
name = 'M_E_Hazard_Dissolve'
render_path = 'auto'
shader = 'Assets/Shaders/Material/Skinned/SkinnedEnemyDissolve.hlsl'
version = 1

[params]
albedo = [ 0.045, 0.048, 0.055, 1.0 ]
metallic = 0.0
roughness = 0.6
dissolveAmount = 0.0
dissolveAxis = [ 0.0, -1.0, 0.0 ]
dissolveRange = 7.5
dissolveSweep = 0.7
dissolveNoiseScale = 2.4
dissolveEdgeWidth = 0.2
dissolveEdgeColor = [ 0.62, 1.0, 0.78 ]
dissolveEdgeIntensity = 7.0
