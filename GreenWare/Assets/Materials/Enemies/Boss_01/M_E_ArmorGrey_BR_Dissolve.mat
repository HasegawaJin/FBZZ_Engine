# GreenWare
# M_E_ArmorGrey_BR_Dissolve.mat
# 部位: 右後脚（M_E_ArmorGrey_BR / メッシュ分割で部位単位に分けたぶん）
# 撃破ディゾルブ用。無傷 (dissolveAmount = 0) のあいだは元の M_E_ArmorGrey と同じ絵になる。
# 差し替えは EnemyDeathVfxComponent が撃破の瞬間に行い、dissolveAmount だけを 0 -> 1 へ動かす。
#
# 雑魚と数値が違うのは体格の差だけ。ボスは全高 6.6m あるので、範囲を雑魚のまま (1.6)
# 使うと «足首から下だけ» で崩壊が終わり、ノイズも細かすぎて遠目には無地に見える。
blend_mode = 'Opaque'
double_sided = false
mesh_type = 'skinned'
name = 'M_E_ArmorGrey_BR_Dissolve'
render_path = 'auto'
shader = 'Assets/Shaders/Material/Skinned/SkinnedEnemyDissolve.hlsl'
version = 1

[params]
albedo = [ 0.215, 0.225, 0.245, 1.0 ]
metallic = 0.0
roughness = 0.4
# 0 = 無傷。スクリプトがここだけを動かす。
dissolveAmount = 0.0
# 先に消える向き (ローカル空間)。既定は足元から。
dissolveAxis = [ 0.0, -1.0, 0.0 ]
dissolveRange = 7.5
# 0 = 全身同時に穴が開く / 1 = 端から順に食われる。
dissolveSweep = 0.7
dissolveNoiseScale = 2.4
dissolveEdgeWidth = 0.2
dissolveEdgeColor = [ 0.62, 1.0, 0.78 ]
dissolveEdgeIntensity = 7.0
