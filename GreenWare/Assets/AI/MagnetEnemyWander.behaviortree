# GreenWare — Behavior Tree
# ノードの木構造は parent / order が持つ。order が左→右の優先順位。
#
# MagnetEnemyWander — 磁力ミニゲームの敵が、極を付けられるまで
# ランダムなウェイポイント (NavMeshPatrolComponent) を無限に巡回し続けるだけの最小構成。
#
#   Repeat (count=0=無限)
#    └─ Patrol
#
# 実際のウェイポイント前後・待機・速度上書きは NavMeshPatrolSystem が行う。
# このノードは「巡回させ続ける意思表示」として Running を返し続けるだけで、
# MagnetEnemyComponent::AssignPole() が呼ばれた瞬間に BehaviorTreeComponent.enabled が
# false になり評価が止まる (巡回自体は Patrol/Agent 側の enabled=false でも止める)。

version = 1
name = "Magnet Enemy Wander"
description = "ランダムなウェイポイントを巡回し続ける"
nextNodeId = 3

[[nodes]]
id = 1
parent = 0
order = 0
type = 6              # Repeat
name = "Loop"
repeatCount = 0        # 0 = 無限
editorX = 80.0
editorY = 120.0

[[nodes]]
id = 2
parent = 1
order = 0
type = 11              # Patrol
name = "Patrol"
editorX = 380.0
editorY = 120.0
