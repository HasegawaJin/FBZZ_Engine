# --- 0.01s: 粒。極の色を体のまわりに残す --------------------------------------
[[nodes]]
id = 5
type = 2
name = "Charge Motes"
duration = 0.80
editorX = 560.0
editorY = 200.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.particle]
cullingEnabled = false
lodEnabled = false
duration = 0.80
loop = false
emitRate = 0.0
maxParticles = 48
shape = 1
sphereRadius = 0.35
sizeStart = 0.28
sizeEnd = 0.02
lifetime = 0.55
lifetimeRandom = 0.4
velocitySpread = 1.6
velocityDamping = 3.2
gravity = [0.0, 0.4, 0.0]
materialPath = "Assets/Materials/Effects/FX_GlowSoft_Additive.mat"
sortMode = 0
# 外へ散らしつつ縦軸で回す。まっすぐ散ると «爆ぜた» に見えて、帯電の «纏った» にならない。
