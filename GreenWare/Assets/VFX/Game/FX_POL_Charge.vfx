# ── 公開パラメーター ──────────────────────────────────────────────────────────

[[parameters]]
name = "Polarity Color"
type = 3
hasRange = false
[parameters.default]
source = 0
constantType = 3
color = [1.0, 1.0, 1.0, 1.0]
[[bindings]]
paramName = "Polarity Color"
nodeId = 2
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 3
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 4
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 5
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 6
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 7
schemaPath = "light.color"

# ＋ / − の記号。極ごとにグラフを 2 本に割らないための差し替え口。
[[parameters]]
name = "Symbol Material"
type = 5
hasRange = false
[parameters.default]
source = 0
constantType = 5
asset = "Assets/Materials/Effects/FX_SymPlus_Additive.mat"
[[bindings]]
paramName = "Symbol Material"
nodeId = 6
schemaPath = "particle.materialPath"

# 記号を出す高さ。敵の背丈が Mite / Serpent / Roller で違うので、呼び出し側が合わせる。
[[parameters]]
name = "Symbol Offset"
type = 4
hasRange = false
[parameters.default]
source = 0
constantType = 4
vector3 = [0.0, 1.4, 0.0]
[[bindings]]
paramName = "Symbol Offset"
nodeId = 6
schemaPath = "localPosition"

# 体の太さに合わせて輪を広げる。大型敵で輪が体に埋まるときに上げる。
[[parameters]]
name = "Halo Size"
type = 0
minimum = 0.5
maximum = 8.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 2.8
[[bindings]]
paramName = "Halo Size"
nodeId = 3
schemaPath = "particle.sizeEnd"
