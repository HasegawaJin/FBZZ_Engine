orbitalVelocity = 3.0
orbitalAxis = [0.0, 1.0, 0.0]
renderPriority = 50
colorVariation = 0.1
colorStart = [1.0, 1.0, 1.0, 1.0]
colorEnd = [0.0, 0.0, 0.0, 0.0]
bursts = [{ time = 0.0, count = 22, cycles = 1, interval = 0.02, probability = 1.0 }]

# --- 0.03s: 頭上の記号。＋ / − は Symbol Material で差し替える -----------------
[[nodes]]
id = 6
type = 2
name = "Symbol Pop"
duration = 0.70
editorX = 860.0
editorY = -60.0
position = [0.0, 1.4, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.particle]
cullingEnabled = false
lodEnabled = false
duration = 0.70
loop = false
emitRate = 0.0
maxParticles = 2
shape = 0
# 大きく出して読める大きさへ落ち着かせる。小さく出して大きくすると «飛んできた» に見える。
sizeStart = 1.1
sizeEnd = 0.62
sizeCurvePower = 0.4
lifetime = 0.55
velocitySpread = 0.0
gravity = [0.0, 0.0, 0.0]
materialPath = "Assets/Materials/Effects/FX_SymPlus_Additive.mat"
sortMode = 0
# 記号は立っていないと読めない。回転を明示的に止める。
angularVelocityMin = 0.0
angularVelocityMax = 0.0
renderPriority = 80
colorStart = [1.0, 1.0, 1.0, 1.0]
colorEnd = [0.0, 0.0, 0.0, 0.0]
bursts = [{ time = 0.0, count = 1, cycles = 1, interval = 0.02, probability = 1.0 }]

# --- 光源。周りの無彩色の装甲を極の色で一瞬染める ----------------------------
[[nodes]]
id = 7
type = 5
name = "Charge Light"
duration = 0.28
editorX = 860.0
editorY = 200.0
position = [0.0, 0.5, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.light]
color = [1.0, 1.0, 1.0]
# 12.2 の «発光を強くしすぎると赤と青の区別が消える»。届けばよいので低く抑える。
intensity = 6.0
range = 4.0
useIntensityCurve = true
intensityCurve = [[0.0, 1.0], [0.2, 0.6], [1.0, 0.0]]

