version = 5
name = "FX_POL_Charge"
description = "極性が乗った瞬間 (企画書 12.1 / 12.3)。極性弾にダメージが無いぶん、«塗れた» はこの 0.5 秒が全部背負う。"
tags = ["greenware", "polarity", "hit", "short"]
requiredRoles = ["core", "sparks"]
thumbnailTime = 0.06
maxParticles = 120
maxLights = 1
maxAudioVoices = 0

# ------------------------------------------------------------------------------
# FX_POL_Charge — なぞりで 1 体を塗り切った / タップで点付与した瞬間。
#
# WHY 短く小さいか:
#   なぞりは 1 回のジェスチャーで 3〜5 体を塗る操作 (6.1)。1 体ぶんが派手だと、
#   線を引き終える頃には画面が同じ絵で埋まって «何体塗れたか» が数えられなくなる。
#   ここは «1 体につき 1 回、確かに乗った» を返すだけの層に留める。
#
# WHY 記号 (＋ / −) を出すか:
#   12.3 の「頭上または身体に記号表示」。色だけに頼ると、赤と青の判別が
#   色覚特性・遠距離・ブルームのいずれでも落ちる。形でも読めるようにする。
#   ＋ / − の差し替えは Symbol Material パラメーターが受け持つので、
#   グラフは極ごとに 2 本に割らない。
#
# WHY 中和をここに入れないか:
#   12.4 は中和のフィードバックを «仕様» として別扱いにしている。同じ絵で返すと、
#   狙って中和したのか事故だったのかが区別できない。中和は FX_POL_Neutralize.vfx。
# ------------------------------------------------------------------------------

[[nodes]]
id = 1
type = 0
name = "Entry"
duration = 0.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]

# --- 0.00s: 乗った瞬間の芯 ----------------------------------------------------
[[nodes]]
id = 2
type = 2
name = "Charge Flash"
duration = 0.14
editorX = 260.0
editorY = -60.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.particle]
cullingEnabled = false
lodEnabled = false
duration = 0.14
loop = false
emitRate = 0.0
maxParticles = 4
shape = 0
sizeStart = 1.5
sizeEnd = 0.15
sizeCurvePower = 2.4
lifetime = 0.09
velocitySpread = 0.0
gravity = [0.0, 0.0, 0.0]
materialPath = "Assets/Materials/Effects/FX_GlowCore_Additive.mat"
sortMode = 0
angularVelocityMin = 0.0
angularVelocityMax = 0.0
renderPriority = 70
colorStart = [1.0, 1.0, 1.0, 1.0]
colorEnd = [0.0, 0.0, 0.0, 0.0]
bursts = [{ time = 0.0, count = 2, cycles = 1, interval = 0.02, probability = 1.0 }]

# --- 0.00s: 帯電が体を包む輪 --------------------------------------------------
[[nodes]]
id = 3
type = 2
name = "Charge Ring"
duration = 0.36
editorX = 260.0
editorY = 150.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.particle]
cullingEnabled = false
lodEnabled = false
duration = 0.36
loop = false
emitRate = 0.0
maxParticles = 3
shape = 0
sizeStart = 0.4
sizeEnd = 2.8
sizeCurvePower = 0.35
lifetime = 0.28
velocitySpread = 0.0
gravity = [0.0, 0.0, 0.0]
materialPath = "Assets/Materials/Effects/FX_RingGrad_Additive.mat"
# WHY 水平ビルボードにしないか: 衝突の衝撃波と違って «床を走る波» ではなく
#     «体を包む殻» なので、どの角度から見ても輪として読めるカメラ正対にする。
renderMode = 0
sortMode = 0
angularVelocityMin = 0.0
angularVelocityMax = 0.0
renderPriority = 55
colorStart = [1.0, 1.0, 1.0, 1.0]
colorEnd = [0.0, 0.0, 0.0, 0.0]
bursts = [{ time = 0.0, count = 1, cycles = 1, interval = 0.02, probability = 1.0 }]

# --- 0.00s: 電弧。«帯電した» ことを形で言う ------------------------------------
