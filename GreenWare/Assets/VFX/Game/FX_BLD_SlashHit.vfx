# FX_BLD_SlashHit.vfx — 刀が当たった瞬間 (presentation.md «斬撃»)
# 弾き (FX_PLR_Parry) の流用をやめた理由: 輪と閃光は «弾いた» の印で、当たりに輪が
# 出ると 1 秒に何度も弾いているように読める。ここにあるのは
#   Impact Rays  … 放射の光条 1 枚 (刀の色)。食い込んだ点を 1 コマ焼く
#   Impact Ring  … 衝撃の輪 (刀の色)。一瞬で広がって消える。強い当たりほど大きい
#   Hit Flash    … 芯の小さな閃光 (刀の色)
#   Sparks       … 熱色の火花。刃が抜けた向きへ噴く (向きは SlashHitVfxComponent が書く)
#   Glint        … 金属の «キラッ» 1 粒
#   Hit Light    … 当たった対象を刀の色で一瞬照らす点光源
# 全部 0.35 秒で消える。煙・焦げ・輪は無い。毎秒出ても盤面に残らない。
# 2026-09-11: 斬撃の絵を刀身の残像 (BladeSlashFx) へ替えたのに合わせて控えめにした
#   (乱数で傾く弧 → 向きのある線 1 本、火花・キラッ・光を約半分)。
# 2026-09-12: 斬った向きの線はパーティクルでは描けない (回転が乱数で入る) ので、
#   一閃は SlashCutFxComponent が帯で張る。ここは光条と向きのある火花を受け持つ。

[scene]
format_version = 1

[prefab]
format_version = 1
root_count = 1

[[gameobjects]]
name = "FX_BLD_SlashHit"
instanceId = "6c2d3aa2-70fe-4bf4-a90e-6923a2e41367"
tag = "Untagged"
layer = 0
active = true
prefabAssetPath = ""
prefabSourceId = ""
parent = ""
parentInstanceId = ""

[gameobjects.transform]
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0, 1.0]
scale = [1.0, 1.0, 1.0]

[gameobjects.VFXComponent]
enabled = true
playOnAwake = true
loop = false
speed = 1.0
duration = 0.0
autoDestroy = true

[[gameobjects.ScriptComponents]]
type = "SlashHitVfxComponent"
enabled = true

[gameobjects.ScriptComponents.fields]
tint = [1.0, 1.0, 1.0, 1.0]
sparkPower = 10.0
flashLight = 3.0
arcSize = 1.4
sweepLateral = -1.0
sweepTilt = 0.0

[[gameobjects]]
name = "Impact Rays"
instanceId = "8aefb44d-91e8-432e-a01c-ba508717e2d3"
tag = "Untagged"
layer = 0
active = true
