# FX_BLD_SlashHit.vfx — 刀が当たった瞬間 (presentation.md «斬撃»)
# 弾き (FX_PLR_Parry) の流用をやめた理由: 輪と閃光は «弾いた» の印で、当たりに輪が
# 出ると 1 秒に何度も弾いているように読める。ここにあるのは
#   Slash Arc … 刃が通った «弧» 1 枚 (極性色)。0.12 秒 (トレイルと同じ寿命)
#   Hit Flash … 芯の小さな閃光 (極性色)
#   Sparks    … 熱色の火花 (無彩色側。極性色を乗せない)
#   Glint     … 金属の «キラッ» 2 粒
#   Hit Light … 当たった対象の輪郭を極の色で一瞬照らす点光源
# 全部 0.35 秒で消える。煙・焦げ・輪は無い。毎秒出ても盤面に残らない。

[scene]
format_version = 1

[prefab]
format_version = 1
root_count = 1

