gravity = [0.0, 0.0, 0.0]
materialPath = "Assets/Materials/Effects/FX_BurstRays_Additive.mat"
sortMode = 0
renderPriority = 74
colorStart = [1.0, 1.0, 1.0, 1.0]
colorEnd = [1.0, 1.0, 1.0, 0.0]
bursts = [{ time = 0.0, count = 1, cycles = 1, interval = 0.01, probability = 1.0 }]

