[gameobjects.transform]
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0, 1.0]
scale = [1.0, 1.0, 1.0]

# 放射の光条 1 枚。放射なので向きを持たず、回転が乱数で入っても崩れない。
# 大きさは SlashHitVfxComponent が当たりの強さ (arcSize) から書き直す。
[gameobjects.ParticleEmitter]
cullingEnabled = false
lodEnabled = false
loop = false
emitRate = 0.0
duration = 0.1
maxParticles = 2
shape = 0
sizeStart = 0.7
sizeEnd = 0.12
sizeCurvePower = 0.5
lifetime = 0.055
velocitySpread = 0.0
