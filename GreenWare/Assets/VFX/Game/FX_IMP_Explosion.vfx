# --- 0.00s: 火花。床で跳ねて止まる --------------------------------------------
[[nodes]]
id = 8
type = 2
name = "Sparks"
duration = 1.20
editorX = 860.0
editorY = -80.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.particle]
cullingEnabled = false
lodEnabled = false
duration = 1.20
loop = false
emitRate = 0.0
maxParticles = 260
shape = 1
sphereRadius = 0.15
sizeStart = 0.22
sizeEnd = 0.02
lifetime = 0.65
lifetimeRandom = 0.45
velocitySpread = 11.0
velocityDamping = 2.4
gravity = [0.0, -14.0, 0.0]
materialPath = "Assets/Materials/Effects/FX_SparkStreak_Additive.mat"
# 素材の頭と尾が横方向に決まっているので、速度方向へ寝かせないと尾が嘘になる。
renderMode = 1
stretchedVelocityScale = 0.14
stretchedLengthScale = 2.6
collisionMode = 3
collisionResponse = 0
collisionRadius = 0.02
collisionBounciness = 0.35
collisionDamping = 0.55
renderPriority = 50
# 尾を引かせて «どこから飛んだか» を読ませる。
# NOTE: トレイルは位置履歴を使うため CPU シミュレーション限定 (simulationMode = 0)。
simulationMode = 0
trailEnabled = true
trailPointCount = 5
trailSampleInterval = 0.012
trailWidthScale = 0.28
trailAlphaScale = 0.22
colorVariation = 0.15
# WHY 火花だけ極性色を乗せないか: 金属片が熱を持って飛ぶ «物» で、帯電の表示ではない。
#     ここまで極性色にすると、盤面の赤青が «誰が帯電しているか» を指さなくなる。
useColorGradient = true
colorGradient = [
  [0.0, 1.00, 0.94, 0.78, 1.0],
  [0.35, 1.00, 0.66, 0.24, 1.0],
  [1.0, 0.70, 0.18, 0.03, 0.0],
]
bursts = [{ time = 0.0, count = 70, cycles = 1, interval = 0.01, probability = 1.0 }]

# --- 0.05s: 粉塵。無彩色のまま残す --------------------------------------------
