note = "画面演出は ImpactFeedbackManagerComponent が持つ。ここへ足すと二重に掛かる。"
x = 1130.0
y = -130.0
width = 290.0
height = 560.0
color = [0.36, 0.42, 0.62, 0.14]

# ── 公開パラメーター ──────────────────────────────────────────────────────────
# 既定はすべて «無彩色 / 標準の強さ»。エディタのプレビューが白で出るのは意図どおりで、
# 実行時は VfxManagerComponent が衝突した極の色を Polarity Color へ差し込む。

[[parameters]]
name = "Polarity Color"
type = 3
hasRange = false
[parameters.default]
source = 0
constantType = 3
color = [1.0, 1.0, 1.0, 1.0]
[[bindings]]
paramName = "Polarity Color"
nodeId = 2
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 3
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 4
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 5
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 6
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 7
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 11
schemaPath = "light.color"

# 衝突速度をそのまま火花の散り方へ流す。柱への叩きつけほど広がる。
[[parameters]]
name = "Spark Power"
type = 0
minimum = 2.0
maximum = 26.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 11.0
[[bindings]]
paramName = "Spark Power"
nodeId = 8
schemaPath = "particle.velocitySpread"

# 煙の最終的な大きさ。盤面が煙で埋まるときはここを下げる。
[[parameters]]
name = "Smoke Amount"
type = 0
minimum = 0.0
maximum = 8.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 4.2
[[bindings]]
paramName = "Smoke Amount"
nodeId = 9
schemaPath = "particle.sizeEnd"

# 床の跡。柱・壁への叩きつけだけ «ひび» へ差し替える (7.5 の敵↔柱・壁)。
[[parameters]]
name = "Ground Mark"
type = 5
hasRange = false
[parameters.default]
source = 0
constantType = 5
asset = "Assets/VFX/Textures/T_Scorch_Decal.png"
[[bindings]]
paramName = "Ground Mark"
nodeId = 13
schemaPath = "decal.albedoPath"

# 光の強さ。集束で複数体が同時に潰れるときは、後続を弱めて画面を守る。
[[parameters]]
name = "Blast Light"
type = 0
minimum = 0.0
maximum = 60.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 22.0
[[bindings]]
paramName = "Blast Light"
nodeId = 11
schemaPath = "light.intensity"
