version = 5
name = "FX_IMP_Explosion"
description = "極性衝突の爆発 (企画書 12.6)。本作で唯一のダメージ源なので、盤面で最も派手な 1 発にする。極性色は Polarity Color から乗る。"
tags = ["greenware", "impact", "polarity", "explosion"]
requiredRoles = ["core", "body", "sparks"]
# 立ち上がりの 0.10 秒で絵が決まる。既定の 25% (0.4 秒) では芯が終わっている。
thumbnailTime = 0.10
maxParticles = 2600
maxLights = 1
maxAudioVoices = 0

# ------------------------------------------------------------------------------
# FX_IMP_Explosion — 敵が敵 / 柱へ叩きつけられた瞬間。
#
# WHY 画面演出 (ScreenEffect / CameraShake / TimeScale) のノードを 1 つも置かないか:
#   ヒットストップ・カメラ揺れ・振動・画面効果は ImpactFeedbackManagerComponent が
#   1 箇所で配分している (12.6 の「多重衝突の処理」がそこに書いてある)。ここにも置くと、
#   同じ 1 回の衝突に対して 2 系統が別々の強さで掛かり、集束で 5 体潰れたときに
#   画面が壊れる。このグラフは «その場所に何が見えるか» だけを持つ。
#
# WHY 炎の橙ではなく極性色か:
#   12.2 は赤 = ＋ / 青 = − / 無彩色 = 非帯電を全アセット共通の制約にしている。
#   爆発だけ橙にすると、盤面で最も明るいものが極性の外側の色になり、
#   「いま何極どうしがぶつかったか」が一瞬で読めなくなる。煙と破片だけ無彩色に残す。
#
# 層 (奥 → 手前):
#   煙 → 爆風の外側 → 衝撃波リング → 電弧 → 爆風の芯 → スプラッシュ → 閃光 → 歪み
# ------------------------------------------------------------------------------

[[nodes]]
id = 1
type = 0
name = "Entry"
duration = 0.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]

# --- 0.00s: 閃光。1〜2 フレーム相当で消える -----------------------------------
[[nodes]]
id = 2
type = 2
name = "Flash Core"
duration = 0.16
editorX = 260.0
editorY = -80.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.particle]
# 複数 Emitter で 1 つの演出 Bounds を作るため、Emitter 単位のカリングと距離 LOD を使わない。
cullingEnabled = false
lodEnabled = false
duration = 0.16
loop = false
emitRate = 0.0
maxParticles = 8
shape = 0
sizeStart = 2.4
sizeEnd = 0.2
sizeCurvePower = 2.6
lifetime = 0.11
velocitySpread = 0.0
gravity = [0.0, 0.0, 0.0]
materialPath = "Assets/Materials/Effects/FX_GlowCore_Additive.mat"
sortMode = 0
angularVelocityMin = 0.0
angularVelocityMax = 0.0
renderPriority = 70
colorStart = [1.0, 1.0, 1.0, 1.0]
colorEnd = [0.0, 0.0, 0.0, 0.0]
bursts = [{ time = 0.0, count = 3, cycles = 1, interval = 0.02, probability = 1.0 }]

