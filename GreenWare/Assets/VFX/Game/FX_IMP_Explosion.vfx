# 12.2 の «無彩色» の側。極性色を乗せない唯一の理由がこれ。
useColorGradient = true
colorGradient = [
  [0.0, 0.58, 0.58, 0.60, 0.0],
  [0.12, 0.50, 0.50, 0.53, 0.72],
  [1.0, 0.42, 0.42, 0.45, 0.0],
]
bursts = [{ time = 0.0, count = 12, cycles = 1, interval = 0.03, probability = 1.0 }]

