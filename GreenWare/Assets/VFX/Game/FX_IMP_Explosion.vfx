# --- 光源。周りの無彩色の装甲を極の色で染める --------------------------------
[[nodes]]
id = 11
type = 5
name = "Blast Light"
duration = 0.40
editorX = 1160.0
editorY = -80.0
position = [0.0, 0.3, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.light]
color = [1.0, 0.85, 0.7]
intensity = 22.0
range = 9.0
# 定数の明るさでは «0.4 秒つく電球» になる。弾けて即落ちる形にする。
useIntensityCurve = true
intensityCurve = [[0.0, 1.0], [0.12, 0.55], [1.0, 0.0]]

# --- 力場。火花と煙を外へ押し出す --------------------------------------------
[[nodes]]
id = 12
type = 9
name = "Blast Push"
duration = 0.25
editorX = 1160.0
editorY = 160.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.forceField]
fieldType = 2
strength = 20.0
radius = 4.5
falloffPower = 2.0

# --- 床の跡 -------------------------------------------------------------------
[[nodes]]
id = 13
type = 7
name = "Ground Mark"
duration = 4.0
editorX = 1160.0
editorY = 340.0
# 衝突は宙で起きる。投影箱の中心を下げ、Y (投影の厚み) を伸ばして床まで届かせる。
# WHY 回転を掛けないか: DecalPass はローカル +Y を投影軸として使う。無回転なら
#     そのまま真下を向くので、床の跡は回転させないのが正しい。
position = [0.0, -1.2, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [2.6, 3.2, 2.6]
[nodes.decal]
albedoPath = "Assets/VFX/Textures/T_Scorch_Decal.png"
color = [0.14, 0.13, 0.13, 0.9]
normalStrength = 0.0
emissiveScale = 0.0
fadeTime = 1.0
# 濃いまま残ってから引く。線形だと置いた直後から薄まり «跡が残った» にならない。
useFadeCurve = true
fadeCurve = [[0.0, 1.0], [0.65, 0.95], [1.0, 0.0]]
# 斜面で伸びた汚れに見えるのを防ぐ。
angleFadeStrength = 1.0
angleFadeDegrees = 70.0

