# FBZZ Engine
# FX_PLR_RunDust.vfx — 走っている足が着くたびに床から立つ土煙。
#
# WHY 極性色を持たないか (12.2 / VFX/Game/README.md):
#   土煙は «床の色» であって帯電の表示ではない。プレイヤーの足元は画面のほぼ中央に
#   出続けるので、ここへ赤青を乗せると盤面の «誰が帯電しているか» が最も見たい場所で
#   潰れる。差し替えるのは床の色 (Dust Color) だけ。
#
# WHY 3 層に割るか:
#   Ground Wash は «床に触った» ことだけを示す平たい円で、水平ビルボードなので
#   斜め上から見ても床に貼り付いて見える。Dust Puff はその上へ立ち上がる本体。
#   Grit は不透明な粒で、輪郭のはっきりした 1 層が無いと煙全体がぼやけて速さが出ない。
#
# WHY 光源を置かないか:
#   足元は 1 秒に 7 回近く鳴る。その回数の点光源はシャドウマップを毎回組み直すのと
#   同義で、走っているあいだじゅう他の演出の光を押し出す。
[scene]
format_version = 1

[prefab]
format_version = 1
root_count = 1

[[gameobjects]]
name = "FX_PLR_RunDust"
instanceId = "bd53287a-5689-4854-8bcb-e080d8882fd4"
tag = "Untagged"
layer = 0
active = true
prefabAssetPath = ""
prefabSourceId = ""
