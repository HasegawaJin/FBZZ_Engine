# ── 公開パラメーター ──────────────────────────────────────────────────────────
# 既定は «無彩色 / 標準の強さ»。実行時は BeamScorchComponent が照射中の極を差し込む。

[[parameters]]
name = "Polarity Color"
type = 3
hasRange = false
[parameters.default]
source = 0
constantType = 3
color = [1.0, 1.0, 1.0, 1.0]
[[bindings]]
paramName = "Polarity Color"
nodeId = 5
schemaPath = "particle.colorStart"

# 火の粉の量。なぞる速さで «削れている量» が変わって見えるように、呼び出し側が振る。
# WHY 上限を 60 で止めるか: これ以上は 1 点あたりの加算枚数が増えるだけで、
#     0.30m 間隔で連なると壁全体が白へ抜ける (README「加算の枚数を数える」)。
[[parameters]]
name = "Ember Rate"
type = 0
minimum = 0.0
maximum = 60.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 26.0
[[bindings]]
paramName = "Ember Rate"
nodeId = 2
schemaPath = "particle.emitRate"

# 焼け跡の広さ。デカールの Size に合わせると、光っている範囲と焦げの範囲が一致する。
[[parameters]]
name = "Sear Size"
type = 0
minimum = 0.05
maximum = 2.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.42
[[bindings]]
paramName = "Sear Size"
nodeId = 3
schemaPath = "particle.sizeStart"
