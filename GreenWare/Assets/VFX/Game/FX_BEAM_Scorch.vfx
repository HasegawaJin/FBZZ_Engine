version = 5
name = "FX_BEAM_Scorch"
description = "極性レーザーが地形を焼いた点 (企画書 6.2 / 12.1)。跡が «残る» だけでなく «燻り続ける» ことで、線がどこを通ったかを時間の情報として残す。"
tags = ["greenware", "beam", "surface", "lingering"]
requiredRoles = ["core", "body", "sparks"]
thumbnailTime = 0.08
maxParticles = 96
maxLights = 0
maxAudioVoices = 0

# ------------------------------------------------------------------------------
# FX_BEAM_Scorch — なぞりが地形へ触れた 1 点。BeamScorchComponent が焦げデカールを
# 置くのと同じ間隔・同じ点で鳴らす。
#
# WHY 一瞬の火花ではなく «一定時間» 出し続けるか (6.2 / 12.1):
#   6.2 は「対象は敵のみ。地形には極性が乗らない」と決めている。壁をなぞっている間、
#   盤面の状態は何も変わらない。ここで返せるのは «焼いた» という事実だけで、それが
#   一瞬で消えると、線がどこを通ったのかが 1 フレームぶんしか残らない。
#   1〜2 秒燻らせると、なぞった軌跡が «まだ熱い点の列» として画面に残り、
#   「どこを通したか」「どこを外したか」が結果として読める。
#
# WHY 火花と煙に極性色を乗せないか (12.2 / VFX/Game/README.md):
#   赤青は «誰が帯電しているか» の表示専用に空けてある。地形は極性を帯びないので、
#   ここが赤や青に光ると «壁が帯電した» と読めてしまう。熱の色 (橙〜白) だけで出す。
#   極性色を乗せてよいのは «撃った側の電気» である Sear Arc の 1 層だけ。
#
# WHY 光源を置かないか:
#   なぞりは 0.30m 間隔で連続して置かれる (BeamScorchComponent の spacing)。
#   1 点につき 1 灯を立てると、壁を 1 回なぞるだけで数十灯が同じ面を照らし、
#   12.2 が守ろうとしている赤青の対比がその場所だけ飛ぶ。熱は加算の板で出す。
#
# 呼び出し側は «面の法線を向く回転» を渡すこと (VfxManagerComponent::PlayBeamScorch)。
# Cone はローカル +Z へ吹くので、渡し忘れると火花が常に +Z へ飛び、壁でも床でも
# 同じ方向へ散る。
# ------------------------------------------------------------------------------

[[nodes]]
id = 1
type = 0
name = "Entry"
duration = 0.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]

# --- 0.00s: 焼けた点から跳ね続ける火の粉 --------------------------------------
# バーストではなく emitRate で出す。バーストにすると «1 回弾けて終わり» になり、
# «焼き続けている» にならない。duration が燻る時間そのものになる。
