# FX_BOSS_Execute.vfx — とどめ (break-parry.md «とどめ (Execute)»)
# 居合の斬り下ろしで脚 / 節が «もげる» 瞬間。切った面が赤熱して冷める、が芯:
#   Cut Arc     … 刃が通った大きな弧 (白)。0.14 秒
#   Cut Flash   … 芯の閃光
#   Cut Seam    … 溶断の縫い目 (T_Cut_Line)。白熱 → 橙 → 暗く冷める 0.9 秒
#   Molten Sparks … 長い溶断スパーク。尾を引き、床で跳ねる (熱色。極性色を乗せない)
#   Embers      … 火の粉が漂う 1.2 秒 (黒体放射で色を作る)
#   Metal Shards … 切断面から飛ぶ金属片 (無彩色)
#   Smoke Wisps … 細い煙が立つ
#   Heat Haze   … 切断面の空気が歪む
#   Cut Light   … 白〜橙の点光源 0.35 秒
# 足元の土煙は VfxManager::PlayGroundDust が別に出す。ScreenEffect / CameraShake / TimeScale は置かない。

[scene]
format_version = 1

[prefab]
format_version = 1
root_count = 1

