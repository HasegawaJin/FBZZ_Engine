# ── 公開パラメーター ──────────────────────────────────────────────────────────

[[parameters]]
name = "Polarity Color"
type = 3
hasRange = false
[parameters.default]
source = 0
constantType = 3
color = [1.0, 1.0, 1.0, 1.0]
[[bindings]]
paramName = "Polarity Color"
nodeId = 2
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 3
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 4
schemaPath = "particle.colorStart"
[[bindings]]
paramName = "Polarity Color"
nodeId = 5
schemaPath = "light.color"

# 撃ち出し速度をそのまま尾へ流す。7.3 は距離と impactSeconds から速度を逆算するので、
# 遠くから引かれた個体ほど速く、尾も長くなる。
# NOTE: Vector3 で持つのは emitVelocity が Cone のローカル速度ベクトルだから。
#       float を束縛すると型が合わず、黙って既定値のままになる。
[[parameters]]
name = "Wake Velocity"
type = 4
hasRange = false
[parameters.default]
source = 0
constantType = 4
vector3 = [0.0, 0.0, 7.0]
[[bindings]]
paramName = "Wake Velocity"
nodeId = 2
schemaPath = "particle.emitVelocity"
