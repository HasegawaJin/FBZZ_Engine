version = 5
name = "FX_ATR_Launch"
description = "溜めを終えて撃ち出される瞬間 (企画書 7.3 ②)。17 章が «最も重要» とした «ギュンッ» の頭。"
tags = ["greenware", "polarity", "attraction", "short"]
requiredRoles = ["sparks"]
thumbnailTime = 0.05
maxParticles = 200
maxLights = 1
maxAudioVoices = 0

# ------------------------------------------------------------------------------
# FX_ATR_Launch — 引力の ① 溜めが終わり、② 一気に最高速へ乗る瞬間。
#
# WHY 加速そのものではなく «置き去りにされた空気» を描くか:
#   7.3 は撃ち出しを漸進させず 1 ステップで最高速へ乗せると決めている。つまり
#   加速の «途中» が存在しないので、速さは動いている本体からは読めない。読めるのは
#   出発点に何が残ったかだけ。だから火花も光も進行方向の «後ろ» へ置き去りにする。
#
# WHY このグラフだけ回転を要求するか:
#   Cone は local +Z へ吹く。呼び出し側は «飛ぶ向き» の逆を向く回転で出すこと
#   (VfxManagerComponent::PlayDirectional が担当する)。回転を渡し忘れると
#   置き去りの尾が常に +Z 固定になり、どの方向へ飛んでも同じ絵になる。
# ------------------------------------------------------------------------------

[[nodes]]
id = 1
type = 0
name = "Entry"
duration = 0.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]

