# ── 公開パラメーター ──────────────────────────────────────────────────────────

# 敵の背丈が Mite / Serpent / Roller で違う。呼び出し側がバツ印の高さを合わせる。
[[parameters]]
name = "Symbol Offset"
type = 4
hasRange = false
[parameters.default]
source = 0
constantType = 4
vector3 = [0.0, 1.4, 0.0]
[[bindings]]
paramName = "Symbol Offset"
nodeId = 4
schemaPath = "localPosition"

# 畳み込む範囲。大型敵では体の外から吸わないと «内側で光っただけ» に見える。
[[parameters]]
name = "Collapse Radius"
type = 0
minimum = 0.3
maximum = 6.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 1.1
[[bindings]]
paramName = "Collapse Radius"
nodeId = 3
schemaPath = "particle.sphereRadius"
