version = 5
name = "FX_POL_Neutralize"
description = "逆極を当てて中和した瞬間 (企画書 12.4)。付与と «逆向き» に、外から芯へ畳んで極を捨てる。"
tags = ["greenware", "polarity", "warning", "short"]
requiredRoles = ["core"]
thumbnailTime = 0.08
maxParticles = 90
maxLights = 1
maxAudioVoices = 0

# ------------------------------------------------------------------------------
# FX_POL_Neutralize — 帯電を失った瞬間。
#
# WHY 付与と «逆向き» に畳むか:
#   12.4 は「中和・延長した瞬間にも明確なフィードバックを返す」を演出ではなく仕様として
#   要求している。同じ «広がる» 絵で色だけ変えると、狙って中和したのか事故だったのかが
#   一瞬では判別できない。付与は外へ開き、中和は外から芯へ畳む。動きの向きが逆なら、
#   色を見る前に何が起きたかが分かる。
#
# WHY 赤でも青でもなく黄か:
#   6.5 の中和警告と同じ kColorWarning。極性色を使うと «中和された» ではなく
#   «別の極が乗った» に読める。12.2 が赤青に与えた意味をここで壊さない。
#
# WHY 明るくしないか:
#   中和は «何も得られなかった» 結果である。付与より派手にすると、事故が起きたときの方が
#   気持ちいいという逆の学習をさせてしまう。
# ------------------------------------------------------------------------------

[[nodes]]
id = 1
type = 0
name = "Entry"
duration = 0.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]

# --- 0.00s: 打ち消しの芯。角の立たないグローで «鈍い» 反応にする ---------------
[[nodes]]
id = 2
type = 2
name = "Null Flash"
duration = 0.16
editorX = 260.0
editorY = -60.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.particle]
cullingEnabled = false
lodEnabled = false
duration = 0.16
loop = false
emitRate = 0.0
maxParticles = 4
shape = 0
sizeStart = 1.2
sizeEnd = 0.2
sizeCurvePower = 2.0
lifetime = 0.11
velocitySpread = 0.0
gravity = [0.0, 0.0, 0.0]
materialPath = "Assets/Materials/Effects/FX_GlowSoft_Additive.mat"
sortMode = 0
angularVelocityMin = 0.0
angularVelocityMax = 0.0
renderPriority = 70
colorStart = [1.0, 0.82, 0.1, 1.0]
colorEnd = [0.0, 0.0, 0.0, 0.0]
bursts = [{ time = 0.0, count = 2, cycles = 1, interval = 0.02, probability = 1.0 }]

# --- 0.00s: 外から芯へ吸い込まれる粒。付与の Charge Motes と逆向き ------------
[[nodes]]
id = 3
type = 2
name = "Collapse Motes"
duration = 0.60
editorX = 260.0
editorY = 180.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.particle]
cullingEnabled = false
lodEnabled = false
duration = 0.60
loop = false
emitRate = 0.0
maxParticles = 40
# 外周に生んで内向きの速度を与える。Point から出すと «畳む» 動きが作れない。
shape = 1
sphereRadius = 1.1
sizeStart = 0.26
sizeEnd = 0.01
lifetime = 0.34
lifetimeRandom = 0.25
velocitySpread = 0.4
velocityDamping = 0.5
gravity = [0.0, 0.0, 0.0]
materialPath = "Assets/Materials/Effects/FX_GlowSoft_Additive.mat"
sortMode = 0
# 負の radialVelocity = 中心へ向かう。これが «逆向き» の正体。
radialVelocity = -4.2
renderPriority = 50
colorVariation = 0.12
# 黄 → 無彩色。極の色が抜けて金属に戻る、という 12.2 の «帯電していない状態» へ着地する。
useColorGradient = true
colorGradient = [
  [0.0, 1.00, 0.82, 0.10, 0.9],
  [0.55, 0.72, 0.70, 0.62, 0.7],
  [1.0, 0.55, 0.57, 0.60, 0.0],
]
bursts = [{ time = 0.0, count = 26, cycles = 1, interval = 0.02, probability = 1.0 }]

