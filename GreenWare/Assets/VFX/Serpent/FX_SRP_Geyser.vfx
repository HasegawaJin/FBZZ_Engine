# FBZZ Engine
# FX_SRP_Geyser.vfx — 床の口から «噴き上がる» 縦の柱。
#
# WHY FX_BOSS_ShockDust と分けるか:
#   あちらは «床が横へ押し退けられた» 絵で、層の噴出はローカル +Z (水平) が主役。
#   突き上げ (Thrust) は下から噴き上がる手なので、シルエットが «縦» でなければ
#   «何が来たか» を色を増やさずに読ませる仕組み (縦 / 横 / 面) が成立しない。
#   実際、以前は PlayGroundDust へ Vector3::UP を渡していたが、あの口は y 成分を
#   捨ててから正規化するので、真上を渡しても水平のパフに落ちていた。
#
# WHY 胴が口を通るときも同じグラフを使うか:
#   «この穴から何かが噴き上がった» という 1 つの出来事で、違うのは規模だけ。
#   枠は VfxManager がタグ (Thrust / Mouth) で分けて回すので、攻撃の 1 発が
#   出入りの土煙を押し出すことはない。
#
# WHY 爆発 (FX_IMP_Explosion) を混ぜないか:
#   閃光は «壊れた / 斬った» の印 (VFX/Game/README.md)。突き上げも出入りも
#   何も壊していないので、光は縁の琥珀が一瞬強まる程度に留める。
#   陽炎の層も置かない ─ 1 回に 3 口が吹くので、そのぶん全画面コピーが増える。
[scene]
format_version = 1

[prefab]
format_version = 1
root_count = 1

[[gameobjects]]
name = "FX_SRP_Geyser"
instanceId = "3c81f0a4-51d6-4b7a-9e23-71ac0d5f8b16"
tag = "Untagged"
layer = 0
active = true
prefabAssetPath = ""
prefabSourceId = ""
