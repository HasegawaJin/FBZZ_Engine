# FBZZ Engine
# FX_SRP_Bite.vfx — 噛みつきの «喉の溜め» と «外した着弾»。
#
# WHY 1 つのグラフで両方を持つか:
#   噛みつきは «喉が溜まって → 突っ込む» の 1 続きで、外した瞬間に溜めた光が
#   そこで途切れることに意味がある。2 本に割ると «溜めだけ出て着弾が出ない» /
#   «着弾だけ出て溜めが無い» という組み合わせが作れてしまう。
#   姿の選択は SerpentBiteVfxComponent の Impact Pose が持ち、要らない側の層を畳む。
#
# WHY ここに絵が要るか (boss-serpent.md「撃破までの形」):
#   終盤まで頭は床下にいて触れず、«頭を斬りたい» だけが動機として置かれている。
#   その頭がこちら側へ出てくる唯一の手が噛みつきなので、ここに何も無いと
#   «近づいてよい 1 秒» がプレイヤーに伝わらない。以前は外しても無音無絵だった。
#
# WHY 溜めを «吸い込み» で作るか:
#   噴き出す絵にすると «もう撃った» と読める。外から内へ集まる火の粉なら、
#   «まだ来ていない / これから来る» が 1 目で分かる。放射を負に取るのがその実装。
[scene]
format_version = 1

[prefab]
format_version = 1
root_count = 1

[[gameobjects]]
name = "FX_SRP_Bite"
instanceId = "4d6208fb-3e71-4a95-8c02-b17e5943da60"
tag = "Untagged"
layer = 0
active = true
prefabAssetPath = ""
prefabSourceId = ""
parent = ""
