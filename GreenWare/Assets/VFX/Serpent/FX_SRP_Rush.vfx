# FBZZ Engine
# FX_SRP_Rush.vfx — 15 m/s で走り抜ける胴が床を削った 1 点。
#
# WHY 走行の土煙 (FX_PLR_RunDust) や重量の土煙 (FX_BOSS_ShockDust) を流用しないか:
#   どちらも «1 点で起きた» 絵で、寿命のあいだその場に留まる。走りは 0.12 秒ごとに
#   1.8 m 間隔で置かれるので、留まる絵だと点が数珠に並んで «足跡» に見える。
#   ここは 1 発の中で «後ろへ流れて薄れる» を作り、置いた点が線として読めるようにする。
#
# WHY 火花を混ぜるか:
#   煙だけでは «速い» が出ない。装甲が床を削って散る火花は速度そのものの表示で、
#   遅い胴 (斬ってよい) と速い胴 (触れると痛い / しきい値 8 m/s) を絵で分ける
#   唯一の手掛かりになる。
#
# WHY 1 発を軽く作るか:
#   走りは 3 ホップで 2 秒ほど続き、その間ずっと 0.12 秒ごとに鳴る (約 16 発)。
#   1 発を重くすると «壁» になって走っている胴そのものが見えなくなる。
#   陽炎も光源も置かない ─ どちらも同時生存数がそのまま負荷になる。
[scene]
format_version = 1

[prefab]
format_version = 1
root_count = 1

[[gameobjects]]
