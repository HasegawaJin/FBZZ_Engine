# FBZZ Engine
# FX_SRP_Slam.vfx — 11 m の胴が持ち上がって落ち、床を «帯» で叩いた。
#
# WHY 締め上げ (FX_SRP_Snap) と別のグラフか:
#   以前はどちらも «中心に爆発 1 発 + 両側に土煙 2 発» で、渡す向きの意味まで同じだった。
#   叩きつけは «線» が落ちてくる手で、危険なのは 2 つの口を結ぶ帯そのもの。逃げるのは
#   帯から «横» へ。締め上げは «角» が寄る手で、逃げるのは角から «外» へ。
#   同じ絵で出していた間、予兆のデカールを見ていなければ 2 つを区別できなかった。
#
# WHY 層は «ローカル +Z が帯の向き» で置くか:
#   呼ぶ側 (SerpentAiComponent) は弧の 2 つの足元を知っている。その 2 点を向く回転を
#   渡せば、あとは長さ (Length) を Z へ伸ばすだけで帯になる。点を 11 m ぶん並べると
#   枠 (VfxManager の Pool) をその数だけ食う。
#
# WHY 閃光を置かないか:
#   閃光は «壊れた / 斬った» の印 (VFX/Game/README.md)。叩きつけは床が凹んだ出来事で、
#   明るくすると «撃破» と読み違える。光は «影が一瞬動く» 程度に絞る。
[scene]
format_version = 1

[prefab]
format_version = 1
root_count = 1

