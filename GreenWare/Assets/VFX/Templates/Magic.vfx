color = [0.34, 0.52, 0.66, 0.14]

[[parameters]]
name = "Cast Time"
type = 0
minimum = 0.0
maximum = 5.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 1.2
[[bindings]]
paramName = "Cast Time"
nodeId = 7
schemaPath = "duration"

[[parameters]]
name = "Charge Pull"
type = 0
minimum = 0.0
maximum = 300.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 90.0
[[bindings]]
paramName = "Charge Pull"
nodeId = 2
schemaPath = "particle.emitRate"

[[parameters]]
name = "Release Power"
type = 0
minimum = 0.0
maximum = 40.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 11.0
[[bindings]]
paramName = "Release Power"
nodeId = 8
schemaPath = "particle.velocitySpread"

[[parameters]]
name = "Arcane Distortion"
type = 0
minimum = 0.0
maximum = 0.25
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.065
[[bindings]]
paramName = "Arcane Distortion"
nodeId = 9
schemaPath = "particle.distortionStrength"

[[parameters]]
name = "Magic Color"
type = 3
minimum = 0.0
maximum = 1.0
hasRange = false
[parameters.default]
source = 0
constantType = 3
color = [0.58, 0.74, 1.0, 1.0]
[[bindings]]
paramName = "Magic Color"
nodeId = 11
schemaPath = "light.color"

# 詠唱の渦の速さ。上げるほど激しく巻き込み、0 にすると真っ直ぐ吸い込まれる。
# 力場ではなくエミッター原点基準の運動なので、詠唱者が移動しても渦が付いてくる。
[[parameters]]
name = "Swirl Speed"
type = 0
minimum = 0.0
maximum = 20.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 4.5
[[bindings]]
paramName = "Swirl Speed"
nodeId = 2
schemaPath = "particle.orbitalVelocity"

# 中心へ吸い込む強さ。負の値が内向き。0 でその場を周回するだけになる。
[[parameters]]
name = "Pull Strength"
type = 0
minimum = -12.0
maximum = 0.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = -3.2
[[bindings]]
paramName = "Pull Strength"
nodeId = 2
schemaPath = "particle.radialVelocity"

# 粒が引く尾の長さ。1 で点、大きいほど軌跡が長く残る。
[[parameters]]
name = "Mote Trail"
type = 1
minimum = 1.0
maximum = 8.0
hasRange = true
[parameters.default]
source = 0
constantType = 1
int = 6
[[bindings]]
paramName = "Mote Trail"
nodeId = 2
schemaPath = "particle.trailPointCount"
[[bindings]]
paramName = "Mote Trail"
nodeId = 8
schemaPath = "particle.trailPointCount"
