+            return;
+        }
+    }
+    std::mutex m_mutex;
+    std::array<std::vector<renderer::RenderMeshItem>, 2> m_items;
+    std::array<std::vector<renderer::RenderObject>, 2> m_objects;
+};
+
+const std::shared_ptr<RenderGeometryStorage>& GeometryStorage()
+{
