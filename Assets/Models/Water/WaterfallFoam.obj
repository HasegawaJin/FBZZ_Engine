# @file    WaterfallFoam.obj
# @brief   Y-up mesh in metres; UVs carry the authored flow direction.
# @author  Hasegawa Jin
# @date    2026-11-06

o WaterfallFoam
v -0.500000 0.000000 -0.500000
v 0.500000 0.000000 -0.500000
v 0.500000 0.000000 0.500000
v -0.500000 0.000000 0.500000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 1.000000 1.000000
vt 0.000000 1.000000
f 1/1 3/3 2/2
f 1/1 4/4 3/3
