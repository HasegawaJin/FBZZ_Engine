# @file    ForestPineSway.sequence
# @brief   Loop a small tilt about the pine's ground-level pivot.
# @author  Hasegawa Jin
# @date    2026-11-04
version = 1

[sequence]
name = 'Forest Pine Sway'
duration = 3.2
wrapMode = 'Loop'
timeMode = 'Scaled'

[[tracks]]
type = 'Transform'
name = 'Wind Tilt'
binding = '$self'
space = 'RelativeToStart'
interp = 'Cubic'
rotations = [
    { time = 0.0, value = [0.0, 0.0, 0.0, 1.0] },
    { time = 0.8, value = [0.00945, 0.0, 0.0192, 0.999771] },
    { time = 1.6, value = [0.00175, 0.0, 0.0035, 0.999992] },
    { time = 2.4, value = [-0.00873, 0.0, -0.01483, 0.999852] },
    { time = 3.2, value = [0.0, 0.0, 0.0, 1.0] },
]
