# @file    Grass.mat
# @brief   Alpine の手塗り・ベイク済み層に用いる反復可能な簡易地形材質。
# @author  Hasegawa Jin
# @date    2026-11-04
version = 1
blend_mode = 'Opaque'
depth_test = 'LessEqual'
depth_write = true
double_sided = false
mesh_type = 'surface'
render_path = 'auto'
render_queue = 2000
shader = ''

[params]
roughness = 0.93
ambientOcclusion = 1.0
normalStrength = 0.65
tilingX = 256.0
tilingZ = 256.0
heightBlend = 0.25
triplanar = 1.0
triplanarSharpness = 4.0
macroScale = 0.03125
macroStrength = 0.2
autoBlendEnabled = 0.0

[textures]
diffuse = 'guid:0a0df76e2b345f81946161509166e41c|Assets/Terrain/Alpine/Grass_Color.png'
normal = 'guid:2546d42c527c5f0b8bc8e8ef9845bb8b|Assets/Terrain/Alpine/Grass_Normal.png'
height = 'guid:9bbb36f95033511e931490993e58ad30|Assets/Terrain/Alpine/Grass_Height.png'
