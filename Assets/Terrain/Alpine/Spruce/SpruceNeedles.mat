albedo = [0.76, 0.94, 0.76, 1.0]
roughness = 0.9
roughness_factor = 0.9
metallic = 0.0
metallic_factor = 0.0
alphaCutoff = 0.32

[textures]
albedo = 'guid:57b7201b41cf5782bbc00203216d5207|Assets/Terrain/Alpine/Spruce/SpruceNeedleSpray_Color.png'
