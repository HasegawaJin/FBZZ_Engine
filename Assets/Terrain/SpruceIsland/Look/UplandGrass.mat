# @file    UplandGrass.mat
# @brief   Reusable surface for the Spruce Island outdoor look.
# @author  Hasegawa Jin
# @date    2026-11-04
version = 1
shader = ''
blend_mode = 'Opaque'
depth_test = 'LessEqual'
depth_write = true
double_sided = false
mesh_type = 'surface'
render_path = 'auto'
render_queue = 2000

[params]
roughness = 0.9
ambientOcclusion = 1.0
tilingX = 1024.0
tilingZ = 1024.0
triplanar = 1.0
triplanarSharpness = 4.0
heightBlend = 0.0
normalStrength = 0.33
macroScale = 0.029
macroStrength = 0.32
autoBlendEnabled = 0.0

[textures]
diffuse = 'guid:0a0df76e2b345f81946161509166e41c|Assets/Terrain/Alpine/Grass_Color.png'
normal = 'guid:b409163b43c2478cbeac49e0ef245e85|Assets/Textures/Terrain/Grass/Grass_Normal.png'
