# @file    CoastalBiomes.pcg
# @brief   Coastal vegetation and exposed rock bands using the world PCG shoreline query.
# @author  Hasegawa Jin
# @date    2026-11-10
# @see https://dev.epicgames.com/documentation/unreal-engine/procedural-content-generation-pcg-biome-core-and-sample-plugins-reference-guide-in-unreal-engine Epic PCG Biome, filters.

format = "fbzz.pcg"
version = 1
key = "CoastalBiomes"
name = "Coastal biomes: shore, transition and upland"
seed = "20261110"
maxInstances = 24000
maxCandidates = 64000
maxPlacementsPerCell = 130
exclusions = []

[grid]
origin = [0.0, 0.0, 0.0]
cellSize = 128.0

[bounds]
