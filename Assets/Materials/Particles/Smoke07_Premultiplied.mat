# FBZZ Engine
# Smoke07_Premultiplied.mat
# 爆煙の柱。
# WHY: 素材 1 枚につき 1 マテリアルを置くことで、複数の Emitter から
#      同じ素材設定を共有できる。
# shader を空にしてあるのは «組み込み Particle.hlsl で描く» の意味。
# 素材: Assets/Textures/Particles/smoke_07.png
version = 1
shader = ""
blend_mode = "Premultiplied"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "guid:d3f86fd7d88444d382396d2e86ef81a8"

[params]
albedo = [1.0, 1.0, 1.0, 1.0]

[particle]
lighting_strength = 0.85
receive_shadows = true
shadow_strength = 0.85
six_way_lighting = true
smoke_back_scatter_power = 2.5
smoke_transmission = 1.4
smoke_wrap = 0.6
soft_particle_fade_distance = 0.7
soft_particles = true
