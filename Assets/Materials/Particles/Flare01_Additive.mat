# FBZZ Engine
# Flare01_Additive.mat
# 爆発の初期フラッシュ。
# WHY: 素材 1 枚につき 1 マテリアルを置くことで、複数の Emitter から
#      同じ素材設定を共有できる。
# shader を空にしてあるのは «組み込み Particle.hlsl で描く» の意味。
# 素材: Assets/Textures/Particles/flare_01.png
version = 1
shader = ""
blend_mode = "Additive"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "guid:5e4fc956d6b04aca9d5ab8798f3580dc"

[params]
albedo = [1.0, 1.0, 1.0, 1.0]

[particle]
emissive_scale = 5.0
soft_particle_fade_distance = 0.6
soft_particles = true
