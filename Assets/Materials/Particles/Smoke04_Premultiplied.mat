# FBZZ Engine
# Smoke04_Premultiplied.mat
# 煙の基部。
# WHY: 素材 1 枚につき 1 マテリアルを置くことで、複数の Emitter から
#      同じ素材設定を共有できる。
# shader を空にしてあるのは «組み込み Particle.hlsl で描く» の意味。
# 素材: Assets/Textures/Particles/smoke_04.png
version = 1
shader = ""
blend_mode = "Premultiplied"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "guid:1738fb3fc2964e1c89d891b6c103776e"

[params]
albedo = [1.0, 1.0, 1.0, 1.0]

[particle]
lighting_strength = 0.9
receive_shadows = true
shadow_strength = 0.9
six_way_lighting = true
smoke_transmission = 0.9
smoke_wrap = 0.7
soft_particle_fade_distance = 0.4
soft_particles = true
