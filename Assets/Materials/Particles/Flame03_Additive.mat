# FBZZ Engine
# Flame03_Additive.mat
# 炎の芯 (hot core)。
# WHY: 素材 1 枚につき 1 マテリアルを置くことで、複数の Emitter から
#      同じ素材設定を共有できる。
# shader を空にしてあるのは «組み込み Particle.hlsl で描く» の意味。
# 素材: Assets/Textures/Particles/flame_03.png
version = 1
shader = ""
blend_mode = "Additive"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "guid:561a2ac4387d4a63b059c5ed5632b5e5"

[params]
albedo = [1.0, 1.0, 1.0, 1.0]

[particle]
emissive_scale = 1.8
soft_particle_fade_distance = 0.3
soft_particles = true
