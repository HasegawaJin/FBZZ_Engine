# FBZZ Engine
# Smoke01_Premultiplied.mat
# 着弾の土煙。
# WHY: 素材 1 枚につき 1 マテリアルを置くことで、複数の Emitter から
#      同じ素材設定を共有できる。
# shader を空にしてあるのは «組み込み Particle.hlsl で描く» の意味。
# 素材: Assets/Textures/Particles/smoke_01.png
version = 1
shader = ""
blend_mode = "Premultiplied"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "guid:5bcf2c4afd17403c8b3a099a2e92c736"

[params]
albedo = [1.0, 1.0, 1.0, 1.0]

[particle]
lighting_strength = 0.85
receive_shadows = true
shadow_strength = 0.9
six_way_lighting = true
smoke_back_scatter_power = 6.0
smoke_transmission = 0.5
smoke_wrap = 0.55
soft_particle_fade_distance = 0.4
soft_particles = true
