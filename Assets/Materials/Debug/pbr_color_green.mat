version = 1
shader = "Assets/Shaders/Material/Surface/PBR.hlsl"
blend_mode = "Opaque"
double_sided = false
render_queue = 2000
render_path = "auto"
mesh_type = "surface"

[textures]
albedo = ""
normal = ""
metallic = ""
emissive = ""
ao = ""

# PBR テスト用 - カラーバリアント Row3: 緑 (dielectric, roughness=0.3)
[params]
albedo = [0.05, 0.72, 0.12, 1.0]
metallic = [0.0]
roughness = [0.3]
normalStrength = [1.0]
occlusionStrength = [1.0]
emissiveColor = [0.0, 0.0, 0.0]
emissiveScale = [0.0]
uvTiling = [1.0, 1.0]
uvOffset = [0.0, 0.0]
alphaCutoff = [0.5]
