# @file    WaterSediment.mat
# @brief   検証した海底接触から舞い上がる砂の共有粒子材質。
# @author  Hasegawa Jin
# @date    2026-10-09
version = 1
shader = ""
blend_mode = "AlphaBlend"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "guid:f9e05e34474942639e3e139ac6c31528"

[params]
# @note Material opacity multiplies the particle lifetime alpha; retain visible suspended sediment without adding emission.
# @see https://dev.epicgames.com/documentation/unreal-engine/how-to-create-a-sparks-effect-in-niagara?application_version=4.27 Smoke Emitter: Particle Update Scale Alpha.
albedo = [0.42, 0.32, 0.19, 0.50]

[particle]
# @note Existing Particle shaders use emissive_scale as final output gain; zero six-way emission separates self emission.
# @see https://dev.epicgames.com/documentation/en-us/unreal-engine/niagara-renderers?application_version=4.27 Sprite Renderer: assigned material controls sprite rendering.
emissive_scale = 1.0
six_way_emission_color = [0.0, 0.0, 0.0]
six_way_emission_scale = 0.0
six_way_lighting = true
lighting_strength = 1.0
punctual_lighting = true
receive_shadows = true
shadow_strength = 1.0
soft_particles = true
soft_particle_fade_distance = 0.4
camera_fade_near = 0.05
camera_fade_far = 0.2
