# @file    WaterBubbles.mat
# @brief   水中の再利用気泡粒子を弱い反射光で描く共有材質。
# @author  Hasegawa Jin
# @date    2026-10-09
version = 1
shader = ""
blend_mode = "Additive"
double_sided = true
depth_write = false
render_queue = 3000
render_path = "particle"
mesh_type = "surface"

[textures]
albedo = "guid:5a3f2a1eacdc4fd8add33d31f66254cb"

[params]
albedo = [0.7, 0.88, 1.0, 0.45]

[particle]
# @note Existing Particle shaders use emissive_scale as final output gain; zero six-way emission separates self emission.
# @see https://dev.epicgames.com/documentation/en-us/unreal-engine/niagara-renderers?application_version=4.27 Sprite Renderer: assigned material controls sprite rendering.
emissive_scale = 1.0
six_way_emission_color = [0.0, 0.0, 0.0]
six_way_emission_scale = 0.0
six_way_lighting = true
lighting_strength = 1.0
punctual_lighting = true
receive_shadows = true
shadow_strength = 1.0
soft_particles = true
soft_particle_fade_distance = 0.12
camera_fade_near = 0.05
camera_fade_far = 0.2
