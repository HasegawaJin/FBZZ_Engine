wave0Wavelength = 23.0
wave1Amplitude = 0.44
wave1Direction = [ -0.17, 0.98 ]
wave1Steepness = 0.62
wave1Wavelength = 61.0
wave2Amplitude = 0.08
wave2Direction = [ 0.87, 0.49 ]
wave2Steepness = 0.58
wave2Wavelength = 9.6
wave3Amplitude = 0.05
wave3Direction = [ -0.70, 0.71 ]
