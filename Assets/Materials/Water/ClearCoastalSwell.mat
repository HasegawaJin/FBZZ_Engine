# @file    ClearCoastalSwell.mat
# @brief   浅瀬の透過と沖の反射を分けて調整した、局所うねり向けの海材質。
# @author  Hasegawa Jin
# @date    2026-11-10
# @see https://dev.epicgames.com/documentation/en-us/unreal-engine/single-layer-water-shading-model-in-unreal-engine Single Layer Waterの吸収・散乱係数。
blend_mode = 'AlphaBlend'
depth_test = 'LessEqual'
depth_write = true
double_sided = false
mesh_type = 'surface'
render_path = 'auto'
render_queue = 3000
shader = 'guid:c496f8e37c024b17aac1fce28730e300|Assets/Shaders/Water/Water.hlsl'
version = 1

[params]
crestFoamThreshold = 0.5
crestFoamFade = 0.2
crestFoamStrength = 0.6
crestFoamLifetime = 1.45
foamColor = [ 0.95, 0.98, 1.0 ]
foamRoughness = 0.78
causticsIntensity = 0.54
causticsSpeed = 0.15
causticsTiling = 0.62
currentSpeed = 0.0
deepColor = [ 0.014, 0.078, 0.092 ]
deepDepth = 8.0
opticalMode = 1.0
# @note RGB 係数は world m^-1。赤を早く吸収し、長い光路の散乱は青を主体にする。
absorptionCoefficients = [ 0.30, 0.086, 0.027 ]
scatteringCoefficients = [ 0.004, 0.014, 0.022 ]
phaseG = 0.38
underwaterLightStrength = 1.0
underwaterMaxDistance = 120.0
underwaterLightSteps = 48.0
underwaterTransitionDepth = 0.15
underwaterDistortion = 0.001
detailScale = 0.59
detailSpeed = 0.6
detailStrength = 0.9
detailAnisotropy = 1.5
detailWarp = 0.85
edgeFade = 20.15999984741211
enableCaustics = 1.0
flowDirection = [ 1.0, 0.0 ]
flowSpeed = 0.6899999976158142
foamFade = 0.35
foamNoiseScale = 0.550000011920929
foamStrength = 0.74
foamThreshold = 0.78
fresnelBias = 0.0204
fresnelPower = 5.8
minShallowAlpha = 0.28
normalStrength = 0.97
opacity = 0.8999999761581421
reflectivity = 1.0
refractionStrength = 0.026
rimGlowStrength = 0.02
rippleRingColor = [ 0.8799999952316284, 0.9700000286102295, 1.0 ]
rippleRingStrength = 0.7200000286102295
shallowColor = [ 0.035, 0.38, 0.32 ]
shallowDepth = 3.1700000762939453
skyReflectTint = [ 0.11, 0.29, 0.46 ]
skyReflection = 1.0
smoothness = 0.86
specularStrength = 0.55
sssColor = [ 0.045, 0.34, 0.25 ]
sssStrength = 0.4
# @see https://developer.nvidia.com/gpugems/gpugems/part-i-natural-effects/chapter-1-effective-water-simulation-physical-models GPU Gems, Chapter 1, wave parameters and direction.
wave0Amplitude = 0.32
wave0Direction = [ 0.55, 0.84 ]
