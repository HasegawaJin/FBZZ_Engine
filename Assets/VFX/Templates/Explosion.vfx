flashColor = [1.0, 0.88, 0.72]
flashIntensity = 0.34
bloomBoost = 1.1
chromaticAberration = 0.008
lensDistortion = 0.06
vignette = 0.18
fadeInTime = 0.02
fadeOutTime = 0.38

