id = 10
type = 11
name = "Blast Flash"
duration = 0.5
editorX = 860.0
editorY = 300.0
position = [0.0, 0.0, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
