# 火の粉の尾の長さ。0 に近づけると点の飛散、大きくすると流星のような軌跡になる。
[[parameters]]
name = "Spark Trail"
type = 1
minimum = 1.0
maximum = 8.0
hasRange = true
[parameters.default]
source = 0
constantType = 1
int = 7
[[bindings]]
paramName = "Spark Trail"
nodeId = 5
schemaPath = "particle.trailPointCount"

# 煙・破片が影を受ける強さ。屋外の強い日差しでは 1.0 まで上げると地面に馴染む。
[[parameters]]
name = "Shadow Response"
type = 0
minimum = 0.0
maximum = 1.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.85
[[bindings]]
paramName = "Shadow Response"
nodeId = 7
schemaPath = "particle.shadowStrength"
[[bindings]]
paramName = "Shadow Response"
nodeId = 6
schemaPath = "particle.shadowStrength"

# 火球の色ばらつき。0 で単色、上げるほど内部に色温度差が出て体積感が増す。
