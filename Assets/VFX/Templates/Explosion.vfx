# --- 焦げ跡 -------------------------------------------------------------------
[[nodes]]
id = 13
type = 7
name = "Scorch Decal"
duration = 6.0
editorX = 1160.0
editorY = 310.0
position = [0.0, 0.02, 0.0]
rotation = [-90.0, 0.0, 0.0]
scale = [4.5, 4.5, 1.0]
[nodes.decal]
albedoPath = "Assets/Textures/Particles/scorch_01.png"
color = [0.12, 0.10, 0.09, 0.9]
normalStrength = 0.0
emissiveScale = 0.0
fadeTime = 1.2
# 焦げ跡は「しばらく濃く残ってから消える」。線形フェードだと最初から薄まり始めて
# 跡が残った感じにならない。終盤まで濃度を保ち、最後に落とす。
useFadeCurve = true
fadeCurve = [[0.0, 1.0], [0.6, 0.95], [0.85, 0.6], [1.0, 0.0]]

# --- 0.00s: 膨張する衝撃波シェル ----------------------------------------------
# WHY: 歪みだけだと背景が無地のときに何も起きていないように見える。
#      加算の球シェルを重ねることで、どんな背景でも輪郭が読める。
#      マテリアル未割当なので VFXMeshFallback.mat (加算/両面/Unlit) が使われ、
#      色とフェードは Color Start -> Color End が albedo を毎フレーム上書きする。
[[nodes]]
id = 14
type = 10
name = "Shockwave Shell"
duration = 0.42
editorX = 260.0
editorY = 480.0
position = [0.0, 0.35, 0.0]
rotation = [0.0, 0.0, 0.0]
scale = [1.0, 1.0, 1.0]
[nodes.mesh]
meshPath = "primitive:sphere"
materialPath = ""
scaleStart = 0.3
scaleEnd = 9.5
scaleEasePower = 0.3
colorStart = [1.0, 0.72, 0.34, 1.0]
colorEnd = [0.0, 0.0, 0.0, 0.0]

