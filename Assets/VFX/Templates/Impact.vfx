[[parameters]]
name = "Impact Power"
type = 0
minimum = 0.0
maximum = 30.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 8.0
[[bindings]]
paramName = "Impact Power"
nodeId = 3
schemaPath = "particle.velocitySpread"

[[parameters]]
name = "Shock Distortion"
type = 0
minimum = 0.0
maximum = 0.25
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.09
[[bindings]]
paramName = "Shock Distortion"
nodeId = 4
schemaPath = "particle.distortionStrength"

[[parameters]]
name = "Dust Amount"
type = 0
minimum = 0.0
maximum = 4.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 1.6
[[bindings]]
paramName = "Dust Amount"
nodeId = 5
schemaPath = "particle.sizeEnd"

[[parameters]]
name = "Hit Light"
type = 0
minimum = 0.0
maximum = 40.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 14.0
[[bindings]]
paramName = "Hit Light"
nodeId = 7
schemaPath = "light.intensity"

# ここより下は今回追加した表現軸のパラメーター。
# 素材 (金属 / 石 / 土) の作り分けはこの3つでほぼ足りる。

# 火花の尾。金属ヒットは長く、土や布は短く (1) する。
[[parameters]]
name = "Spark Trail"
type = 1
minimum = 1.0
maximum = 8.0
hasRange = true
[parameters.default]
source = 0
constantType = 1
int = 5
[[bindings]]
paramName = "Spark Trail"
nodeId = 3
schemaPath = "particle.trailPointCount"

# 粉塵・破片が影を受ける強さ。
[[parameters]]
name = "Shadow Response"
type = 0
minimum = 0.0
maximum = 1.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.9
[[bindings]]
paramName = "Shadow Response"
nodeId = 5
schemaPath = "particle.shadowStrength"
[[bindings]]
paramName = "Shadow Response"
nodeId = 6
schemaPath = "particle.shadowStrength"

# 粉塵の広がり方。Y を下げるほど地面を這い、上げるほど巻き上がる。
[[parameters]]
name = "Dust Shape"
type = 4
hasRange = false
[parameters.default]
source = 0
constantType = 4
vector3 = [1.4, 0.7, 1.0]
[[bindings]]
paramName = "Dust Shape"
nodeId = 5
schemaPath = "particle.sizeAxisScale"
