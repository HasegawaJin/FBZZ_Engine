[[parameters]]
name = "Density"
type = 0
minimum = 0.0
maximum = 120.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 26.0
[[bindings]]
paramName = "Density"
nodeId = 2
schemaPath = "particle.emitRate"

[[parameters]]
name = "Plume Height"
type = 0
minimum = 0.5
maximum = 10.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 2.0
[[bindings]]
paramName = "Plume Height"
nodeId = 2
schemaPath = "particle.lifetime"

[[parameters]]
name = "Spread"
type = 0
minimum = 0.5
maximum = 16.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 4.2
[[bindings]]
paramName = "Spread"
nodeId = 3
schemaPath = "particle.sizeEnd"

[[parameters]]
name = "Warm Air Distortion"
type = 0
minimum = 0.0
maximum = 0.08
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.014
[[bindings]]
paramName = "Warm Air Distortion"
nodeId = 5
schemaPath = "particle.distortionStrength"

# 影の受け具合。屋外の強い日差しでは 1.0、屋内や夜は下げて煙自体の明度を残す。
[[parameters]]
name = "Shadow Response"
type = 0
minimum = 0.0
maximum = 1.0
hasRange = true
[parameters.default]
source = 0
constantType = 0
float = 0.9
[[bindings]]
paramName = "Shadow Response"
nodeId = 3
schemaPath = "particle.shadowStrength"
[[bindings]]
paramName = "Shadow Response"
nodeId = 2
schemaPath = "particle.shadowStrength"

# 上層の潰れ方。風の強い場面ほど X を上げると横へ流れて見える。
# sizeAxisScale は Vector3 の leaf なので、成分ごとには bind できず 3 軸まとめて指定する。
[[parameters]]
name = "Haze Shape"
type = 4
minimum = 0.0
maximum = 0.0
hasRange = false
[parameters.default]
source = 0
constantType = 4
vector3 = [1.5, 0.85, 1.0]
[[bindings]]
paramName = "Haze Shape"
nodeId = 4
schemaPath = "particle.sizeAxisScale"
