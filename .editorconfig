# @file    .editorconfig
# @brief   ソースとアセットメタデータの文字コード・改行・インデント設定。
# @author  Hasegawa Jin
# @date    2026-05-15
root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{hpp,cpp}]
charset = utf-8
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.meta]
charset = utf-8
end_of_line = lf
