# @file    EngineModuleBoundaries.cmake
# @brief   Engine 内部モジュールの直接・推移 include と外部リンク依存を検査する。
# @author  Hasegawa Jin
# @date    2026-10-31

function(fbzz_engine_include_domain ROOT HEADER OUT)
    file(RELATIVE_PATH RELATIVE "${ROOT}/Projects" "${HEADER}")
    string(REPLACE "\\" "/" RELATIVE "${RELATIVE}")
    if(RELATIVE MATCHES "^Editor/" OR RELATIVE MATCHES "^Graphics/src/" OR RELATIVE MATCHES "/Platform/DX[0-9]+/")
        set(DOMAIN Forbidden)
    elseif(RELATIVE STREQUAL "Engine/include/Engine/Api.hpp")
        set(DOMAIN Api)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Reflection/")
        set(DOMAIN Reflection)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Scene/(Reflection.hpp|Entity.hpp|EntityRef.hpp|ObjectReference.hpp|PrefabRef.hpp|DataAssetRef.hpp|ScriptAssetRef.hpp|ParticleCurve.hpp|Ref.hpp)$")
        set(DOMAIN Reflection)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Asset/(AssetPath.hpp|SynthAsset.hpp|GuidRefCodec.hpp)$")
        set(DOMAIN AssetContracts)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Format/")
        set(DOMAIN AssetContracts)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/[^/]+\\.hpp$")
        set(DOMAIN HostContracts)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/(Core/Application.hpp|Profiler/ScriptProfiler.hpp)$")
        set(DOMAIN HostContracts)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Renderer/")
        set(DOMAIN RenderingContracts)
    elseif(RELATIVE STREQUAL "Engine/include/Engine/Scene/Systems/RenderSceneExtractor.hpp")
        set(DOMAIN RenderingContracts)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Scene/Systems/(Render|UISystem)" OR
        RELATIVE MATCHES "^Engine/src/Scene/(SceneRenderResources\\.cpp|Systems/UISystem\\.cpp)$")
        set(DOMAIN Rendering)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Scene/Managed/")
        set(DOMAIN ManagedContracts)
    elseif(RELATIVE MATCHES "^Engine/src/Scene/Managed/")
        set(DOMAIN Managed)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Scene/(Script.hpp|ScriptProxy/|ScriptRuntime.hpp)")
        set(DOMAIN Scene)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Scene/Components/" OR
        RELATIVE MATCHES "^Engine/include/Engine/Scene/(TerrainSplat.hpp|TerrainSurfaceGeometry.hpp|Fields/FlowField.hpp|TomlReflector.hpp)$")
        set(DOMAIN SceneContracts)
    elseif(RELATIVE MATCHES "^Engine/include/Engine/Scene/")
        set(DOMAIN Scene)
    elseif(RELATIVE MATCHES "^Engine/(include/Engine|src)/(Core|Input|Util|Profiler)/")
        set(DOMAIN Platform)
    elseif(RELATIVE MATCHES "^Engine/(include/Engine|src)/Audio/")
        set(DOMAIN Audio)
    elseif(RELATIVE MATCHES "^Engine/(include/Engine|src)/AI/")
        set(DOMAIN AI)
    elseif(RELATIVE MATCHES "^Engine/(include/Engine|src)/Asset/")
        set(DOMAIN Assets)
    elseif(RELATIVE MATCHES "^Engine/(include/Engine|src)/Renderer/|^Engine/src/Scene/Systems/(Render|TerrainRenderCache)")
        set(DOMAIN Rendering)
    elseif(RELATIVE MATCHES "^Engine/src/Scene/")
        set(DOMAIN Scene)
    elseif(RELATIVE MATCHES "^(Core|Math|Physics|Fluid|Graphics)/")
        set(DOMAIN "${CMAKE_MATCH_1}")
    else()
        set(DOMAIN Unknown)
    endif()
    set(${OUT} "${DOMAIN}" PARENT_SCOPE)
endfunction()

function(fbzz_validate_engine_module ROOT MODULE)
    set(COMMON Api Reflection Platform Core Math)
    set(ALLOWED_Platform Api Platform Core Math)
    set(ALLOWED_Audio ${COMMON} Audio AssetContracts)
    set(ALLOWED_AI ${COMMON} AI AssetContracts)
    set(ALLOWED_Assets ${COMMON} Assets AssetContracts Audio AI SceneContracts RenderingContracts Graphics Physics Fluid)
    set(ALLOWED_Scene ${COMMON} HostContracts Scene SceneContracts AssetContracts Assets Audio AI Managed ManagedContracts RenderingContracts Graphics Physics Fluid)
    set(ALLOWED_Rendering ${COMMON} HostContracts Rendering RenderingContracts Scene SceneContracts ManagedContracts Assets AssetContracts Audio AI Graphics Physics Fluid)
    set(ALLOWED_Managed ${COMMON} HostContracts Managed ManagedContracts Scene SceneContracts RenderingContracts Assets AssetContracts Audio AI Graphics Physics Fluid)
    set(ALLOWED_Host ${COMMON} HostContracts Managed ManagedContracts Scene SceneContracts Rendering RenderingContracts Assets AssetContracts Audio AI Graphics Physics Fluid)
    if(NOT DEFINED ALLOWED_${MODULE})
        message(FATAL_ERROR "Engine boundary: unknown module ${MODULE}")
    endif()
    string(SHA256 VISIT_KEY "${ROOT}/${MODULE}")
    set(PENDING ${ARGN})
    while(PENDING)
        list(POP_BACK PENDING SOURCE)
        if(NOT SOURCE MATCHES "\\.(c|cc|cpp|h|hpp|inl)$")
            continue()
        endif()
        get_filename_component(SOURCE "${SOURCE}" ABSOLUTE)
        get_property(VISITED GLOBAL PROPERTY "FBZZ_BOUNDARY_${VISIT_KEY}")
        if(SOURCE IN_LIST VISITED)
            continue()
        endif()
        set_property(GLOBAL APPEND PROPERTY "FBZZ_BOUNDARY_${VISIT_KEY}" "${SOURCE}")
        # @note ファイル追加だけでなく既存 include の変更でも構成時検査を再実行する。
        if(NOT CMAKE_SCRIPT_MODE_FILE)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SOURCE}")
        endif()
        file(STRINGS "${SOURCE}" INCLUDES REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
        get_filename_component(PARENT "${SOURCE}" DIRECTORY)
        foreach(LINE IN LISTS INCLUDES)
            string(REGEX MATCH "[<\"]([^>\"]+)[>\"]" MATCH "${LINE}")
            set(INCLUDE "${CMAKE_MATCH_1}")
            set(CANDIDATES "${PARENT}/${INCLUDE}")
            foreach(LAYER Engine Core Math Physics Fluid Graphics Editor)
                list(APPEND CANDIDATES "${ROOT}/Projects/${LAYER}/include/${INCLUDE}")
            endforeach()
            foreach(CANDIDATE IN LISTS CANDIDATES)
                if(NOT EXISTS "${CANDIDATE}")
                    continue()
                endif()
                get_filename_component(HEADER "${CANDIDATE}" ABSOLUTE)
                fbzz_engine_include_domain("${ROOT}" "${HEADER}" DOMAIN)
                if(NOT DOMAIN IN_LIST ALLOWED_${MODULE})
                    message(SEND_ERROR "Engine boundary ${MODULE} -> ${DOMAIN}: ${SOURCE} includes ${INCLUDE}")
                endif()
                list(APPEND PENDING "${HEADER}")
                break()
            endforeach()
        endforeach()
    endwhile()
endfunction()

function(fbzz_validate_engine_links MODULE)
    set(ALLOWED_Platform FBZZCore FBZZMath TomlPlusPlus)
    set(ALLOWED_Audio FBZZCore FBZZMath)
    set(ALLOWED_AI FBZZCore FBZZMath TomlPlusPlus)
    set(ALLOWED_Assets FBZZGraphics FBZZPhysics FBZZFluid FBZZMath TomlPlusPlus)
    set(ALLOWED_Scene ${ALLOWED_Assets})
    set(ALLOWED_Rendering ${ALLOWED_Assets})
    set(ALLOWED_Managed ${ALLOWED_Assets})
    foreach(DEPENDENCY IN LISTS ARGN)
        if(NOT DEPENDENCY IN_LIST ALLOWED_${MODULE})
            message(FATAL_ERROR "Engine link boundary ${MODULE}: forbidden target ${DEPENDENCY}")
        endif()
    endforeach()
endfunction()
