# @file    GuardFBZZSDKPreview.cmake
# @brief   Contain isolated SDK preview staging within the configured binary directory.
# @author  Hasegawa Jin
# @date    2026-10-05

# @note Standalone -P execution must retain modern non-following GLOB_RECURSE link semantics.
cmake_minimum_required(VERSION 3.25)

foreach(required BINARY_ROOT SDK_ROOT SDK_ID)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "GuardFBZZSDKPreview: ${required} is required")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${BINARY_ROOT}")
    message(FATAL_ERROR "GuardFBZZSDKPreview: binary directory does not exist")
endif()
if(SDK_ID MATCHES "[/\\\\]" OR SDK_ID STREQUAL "." OR SDK_ID STREQUAL "..")
    message(FATAL_ERROR "GuardFBZZSDKPreview: SDK_ID must be a single directory name")
endif()

get_filename_component(previewRoot "${SDK_ROOT}" ABSOLUTE)
get_filename_component(expectedRoot "${BINARY_ROOT}/SDKPreview/${SDK_ID}" ABSOLUTE)
cmake_path(NORMAL_PATH previewRoot)
cmake_path(NORMAL_PATH expectedRoot)
if(WIN32)
    string(TOLOWER "${previewRoot}" previewRootComparable)
    string(TOLOWER "${expectedRoot}" expectedRootComparable)
else()
    set(previewRootComparable "${previewRoot}")
    set(expectedRootComparable "${expectedRoot}")
endif()
if(NOT previewRootComparable STREQUAL expectedRootComparable)
    message(FATAL_ERROR "GuardFBZZSDKPreview: output must be BINARY_ROOT/SDKPreview/SDK_ID")
endif()

# @note Resolve the nearest existing ancestor explicitly, including a junction above an as-yet-uncreated preview leaf.
set(existingAncestor "${previewRoot}")
set(missingSuffix "")
while(NOT EXISTS "${existingAncestor}" AND NOT IS_SYMLINK "${existingAncestor}")
    get_filename_component(leaf "${existingAncestor}" NAME)
    get_filename_component(parent "${existingAncestor}" DIRECTORY)
    if(parent STREQUAL existingAncestor)
        message(FATAL_ERROR "GuardFBZZSDKPreview: output has no existing ancestor")
    endif()
    set(missingSuffix "/${leaf}${missingSuffix}")
    set(existingAncestor "${parent}")
endwhile()
if(NOT EXISTS "${existingAncestor}")
    message(FATAL_ERROR "GuardFBZZSDKPreview: dangling output link is forbidden")
endif()
file(REAL_PATH "${BINARY_ROOT}" binaryRootReal)
file(REAL_PATH "${existingAncestor}" existingAncestorReal)
set(previewRootReal "${existingAncestorReal}${missingSuffix}")
set(expectedRootReal "${binaryRootReal}/SDKPreview/${SDK_ID}")
cmake_path(NORMAL_PATH previewRootReal)
cmake_path(NORMAL_PATH expectedRootReal)
cmake_path(IS_PREFIX binaryRootReal "${previewRootReal}" NORMALIZE withinBinaryRoot)
if(WIN32)
    string(TOLOWER "${previewRootReal}" previewRootRealComparable)
    string(TOLOWER "${expectedRootReal}" expectedRootRealComparable)
else()
    set(previewRootRealComparable "${previewRootReal}")
    set(expectedRootRealComparable "${expectedRootReal}")
endif()
if(NOT withinBinaryRoot OR NOT previewRootRealComparable STREQUAL expectedRootRealComparable)
    message(FATAL_ERROR "GuardFBZZSDKPreview: existing links redirect the fixed preview output")
endif()

# @note The publisher recursively replaces include; verify that exact removal target before the first staging mutation.
set(includeRoot "${previewRoot}/include")
if(EXISTS "${includeRoot}" OR IS_SYMLINK "${includeRoot}")
    if(NOT EXISTS "${includeRoot}")
        message(FATAL_ERROR "GuardFBZZSDKPreview: dangling include link is forbidden")
    endif()
    file(REAL_PATH "${includeRoot}" includeRootReal)
    set(expectedIncludeRootReal "${previewRootReal}/include")
    cmake_path(IS_PREFIX previewRootReal "${includeRootReal}" NORMALIZE includeWithinPreviewRoot)
    if(WIN32)
        string(TOLOWER "${includeRootReal}" includeRootReal)
        string(TOLOWER "${expectedIncludeRootReal}" expectedIncludeRootReal)
    endif()
    if(NOT includeWithinPreviewRoot OR NOT includeRootReal STREQUAL expectedIncludeRootReal)
        message(FATAL_ERROR "GuardFBZZSDKPreview: include removal target is redirected")
    endif()
endif()

# @note An old SDK child link could redirect install/stage writes even when the preview root itself is safe.
if(EXISTS "${previewRoot}")
    file(GLOB_RECURSE existingEntries LIST_DIRECTORIES TRUE "${previewRoot}/*")
    foreach(entry IN LISTS existingEntries)
        if(IS_SYMLINK "${entry}")
            message(FATAL_ERROR "GuardFBZZSDKPreview: linked preview entries are forbidden: ${entry}")
        endif()
        file(REAL_PATH "${entry}" entryReal)
        cmake_path(IS_PREFIX previewRootReal "${entryReal}" NORMALIZE withinPreviewRoot)
        if(NOT withinPreviewRoot)
            message(FATAL_ERROR "GuardFBZZSDKPreview: preview entry escapes its root: ${entry}")
        endif()
    endforeach()
endif()
