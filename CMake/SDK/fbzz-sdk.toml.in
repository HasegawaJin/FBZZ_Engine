# @file    fbzz-sdk.toml.in
# @brief   SDK の版数、ABI と構成別ランタイム公開契約。
# @author  Hasegawa Jin
# @date    2026-07-15

[sdk]
schema = 2
id = "@FBZZ_SDK_ID@"
version = "@PROJECT_VERSION@"
source_revision = "@FBZZ_SDK_REVISION@"
architecture = "x64"
compiler = "MSVC"
msvc_version = "@FBZZ_SDK_MSVC_VERSION@"
compiler_version = "@FBZZ_SDK_COMPILER_VERSION@"
toolset_version = "@FBZZ_SDK_MSVC_TOOLSET_VERSION@"
runtime_debug = "MultiThreadedDebugDLL"
runtime_development = "MultiThreadedDLL"
runtime_release = "MultiThreadedDLL"
abi_policy = "exact"

[runtime]
dx12_enabled = @FBZZ_SDK_DX12_ENABLED@
fingerprint = "@FBZZ_SDK_RUNTIME_FINGERPRINT@"
agility_package = "@FBZZ_AGILITY_PACKAGE_VERSION@"
agility_sdk_version = @FBZZ_SDK_AGILITY_VERSION@
agility_path = '@FBZZ_AGILITY_SDK_PATH@'
core_file_version = "@FBZZ_AGILITY_CORE_FILE_VERSION@"
core_sha256 = "@FBZZ_SDK_CORE_SHA256@"
layers_sha256 = "@FBZZ_SDK_LAYERS_SHA256@"
dxc_version = "@FBZZ_DXC_PACKAGE_VERSION@"
dxc_exe_sha256 = "@FBZZ_SDK_DXC_EXE_SHA256@"
dxc_compiler_sha256 = "@FBZZ_SDK_DXC_COMPILER_SHA256@"
dxc_validator_sha256 = "@FBZZ_SDK_DXC_VALIDATOR_SHA256@"
