# @file    PruneFBZZSDKAssets.cmake
# @brief   Remove retired SDK assets after installing the authoritative source asset tree.
# @author  Hasegawa Jin
# @date    2026-11-06
cmake_minimum_required(VERSION 3.25)
foreach(REQUIRED SOURCE_ASSETS SDK_ROOT)
    if(NOT DEFINED ${REQUIRED} OR NOT IS_ABSOLUTE "${${REQUIRED}}")
        message(FATAL_ERROR "PruneFBZZSDKAssets: absolute ${REQUIRED} is required")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${SOURCE_ASSETS}" OR NOT IS_DIRECTORY "${SDK_ROOT}/share/fbzz/Assets")
    message(FATAL_ERROR "PruneFBZZSDKAssets: source and installed SDK assets must exist")
endif()
file(REAL_PATH "${SDK_ROOT}" SDK_REAL)
set(DESTINATION "${SDK_REAL}/share/fbzz/Assets")
file(REAL_PATH "${DESTINATION}" DESTINATION_REAL)
file(REAL_PATH "${SOURCE_ASSETS}" SOURCE_REAL)
cmake_path(IS_PREFIX SOURCE_REAL "${DESTINATION}" NORMALIZE DESTINATION_IN_SOURCE)
cmake_path(IS_PREFIX DESTINATION "${SOURCE_REAL}" NORMALIZE SOURCE_IN_DESTINATION)
if(NOT DESTINATION_REAL STREQUAL DESTINATION OR DESTINATION_IN_SOURCE OR SOURCE_IN_DESTINATION)
    message(FATAL_ERROR "PruneFBZZSDKAssets: redirected or overlapping asset roots are not supported")
endif()
file(GLOB_RECURSE ENTRIES LIST_DIRECTORIES true "${DESTINATION}/*")
foreach(ENTRY IN LISTS ENTRIES)
    file(REAL_PATH "${ENTRY}" ENTRY_REAL)
    cmake_path(IS_PREFIX DESTINATION "${ENTRY_REAL}" NORMALIZE INSIDE_DESTINATION)
    if(NOT INSIDE_DESTINATION OR IS_SYMLINK "${ENTRY}")
        message(FATAL_ERROR "PruneFBZZSDKAssets: refusing redirected entry ${ENTRY}")
    endif()
endforeach()
foreach(ENTRY IN LISTS ENTRIES)
    if(IS_DIRECTORY "${ENTRY}")
        continue()
    endif()
    file(RELATIVE_PATH RELATIVE "${DESTINATION}" "${ENTRY}")
    if(NOT EXISTS "${SOURCE_REAL}/${RELATIVE}")
        file(REMOVE "${ENTRY}")
    endif()
endforeach()
