# @file    StageFBZZEngineAssets.cmake
# @brief   Mirror SDK-owned assets and notices without touching project assets.
# @author  Hasegawa Jin
# @date    2026-11-06
cmake_minimum_required(VERSION 3.25)

foreach(REQUIRED SDK_ROOT RUNTIME_DIR)
    if(NOT DEFINED ${REQUIRED} OR NOT IS_ABSOLUTE "${${REQUIRED}}")
        message(FATAL_ERROR "StageFBZZEngineAssets: absolute ${REQUIRED} is required")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${SDK_ROOT}/share/fbzz/Assets")
    message(FATAL_ERROR "StageFBZZEngineAssets: SDK assets are missing: ${SDK_ROOT}/share/fbzz/Assets")
endif()
file(MAKE_DIRECTORY "${RUNTIME_DIR}")
file(REAL_PATH "${RUNTIME_DIR}" RUNTIME_ROOT)

# @note These two directories are exclusively SDK-owned; validate every existing destination before copying or deleting files.
foreach(TREE EngineAssets EngineLicenses)
    set(DESTINATION_ROOT "${RUNTIME_ROOT}/${TREE}")
    foreach(SOURCE_TREE Assets licenses)
        file(REAL_PATH "${SDK_ROOT}/share/fbzz/${SOURCE_TREE}" SOURCE_REAL)
        cmake_path(IS_PREFIX SOURCE_REAL "${DESTINATION_ROOT}" NORMALIZE DESTINATION_IN_SOURCE)
        cmake_path(IS_PREFIX DESTINATION_ROOT "${SOURCE_REAL}" NORMALIZE SOURCE_IN_DESTINATION)
        if(DESTINATION_IN_SOURCE OR SOURCE_IN_DESTINATION)
            message(FATAL_ERROR "StageFBZZEngineAssets: SDK source overlaps destination ${DESTINATION_ROOT}")
        endif()
    endforeach()
    file(REAL_PATH "${DESTINATION_ROOT}" DESTINATION_REAL)
    if(NOT DESTINATION_REAL STREQUAL DESTINATION_ROOT)
        message(FATAL_ERROR "StageFBZZEngineAssets: refusing redirected destination ${DESTINATION_ROOT}")
    endif()
    file(GLOB_RECURSE EXISTING_ENTRIES LIST_DIRECTORIES true "${DESTINATION_ROOT}/*")
    foreach(ENTRY IN LISTS EXISTING_ENTRIES)
        file(REAL_PATH "${ENTRY}" ENTRY_REAL)
        cmake_path(IS_PREFIX DESTINATION_ROOT "${ENTRY_REAL}" NORMALIZE INSIDE_DESTINATION)
        if(NOT INSIDE_DESTINATION OR IS_SYMLINK "${ENTRY}")
            message(FATAL_ERROR "StageFBZZEngineAssets: refusing redirected entry ${ENTRY}")
        endif()
    endforeach()
endforeach()

foreach(TREE EngineAssets EngineLicenses)
    if(TREE STREQUAL "EngineAssets")
        set(SOURCE_ROOT "${SDK_ROOT}/share/fbzz/Assets")
    else()
        set(SOURCE_ROOT "${SDK_ROOT}/share/fbzz/licenses")
    endif()
    set(DESTINATION_ROOT "${RUNTIME_ROOT}/${TREE}")
    file(GLOB_RECURSE SOURCE_FILES LIST_DIRECTORIES false RELATIVE "${SOURCE_ROOT}" "${SOURCE_ROOT}/*")
    foreach(RELATIVE IN LISTS SOURCE_FILES)
        get_filename_component(PARENT "${DESTINATION_ROOT}/${RELATIVE}" DIRECTORY)
        file(MAKE_DIRECTORY "${PARENT}")
        # @see https://cmake.org/cmake/help/v3.25/command/file.html#copy-file ONLY_IF_DIFFERENT preserves unchanged destination files.
        file(COPY_FILE "${SOURCE_ROOT}/${RELATIVE}" "${DESTINATION_ROOT}/${RELATIVE}" ONLY_IF_DIFFERENT)
    endforeach()
    file(GLOB_RECURSE DESTINATION_FILES LIST_DIRECTORIES false RELATIVE "${DESTINATION_ROOT}" "${DESTINATION_ROOT}/*")
    foreach(RELATIVE IN LISTS DESTINATION_FILES)
        if(NOT RELATIVE IN_LIST SOURCE_FILES)
            file(REMOVE "${DESTINATION_ROOT}/${RELATIVE}")
        endif()
    endforeach()
endforeach()
