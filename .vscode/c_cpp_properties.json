// @file    c_cpp_properties.json
// @brief   VS Code C/C++ 拡張の IntelliSense 設定。includePath が唯一の情報源。
// @author  Hasegawa Jin
// @date    2026-05-19
//
// @note compileCommands は使わない。VS ジェネレーターは CMAKE_EXPORT_COMPILE_COMMANDS を無視し compile_commands.json を作らない。
// @note compilerPath は書かない。未指定なら拡張が vswhere で最新 MSVC を検出し、VS 更新で壊れず VcBuild.ps1 ともずれない。
{
    "configurations": [
        {
            "name": "FBZZ Engine",
            "includePath": [
                // @name 自作レイヤー
                "${workspaceFolder}/Projects/Math/include",
                "${workspaceFolder}/Projects/Physics/include",
                "${workspaceFolder}/Projects/Fluid/include",
                "${workspaceFolder}/Projects/Engine/include",
                "${workspaceFolder}/Projects/Engine/src",
                "${workspaceFolder}/Projects/Editor/include",
                "${workspaceFolder}/Projects/Editor/src",
                "${workspaceFolder}/Projects/EditorLauncher/src",
                "${workspaceFolder}/Projects/Sandbox/src",
                "${workspaceFolder}/Projects/Tests",
                // @name サードパーティ
                "${workspaceFolder}/ThirdParty/ImGui",
                "${workspaceFolder}/ThirdParty/ImGui/backends",
                "${workspaceFolder}/ThirdParty/ImGuizmo/src",
                "${workspaceFolder}/ThirdParty/ImNodes",
                "${workspaceFolder}/ThirdParty/Stb",
                "${workspaceFolder}/ThirdParty/TinyExr",
                "${workspaceFolder}/ThirdParty/TomlPlusPlus/include",
                "${workspaceFolder}/ThirdParty/DirectXTex/include",
                "${workspaceFolder}/ThirdParty/Assimp/include"
            ],
            "defines": [
                // @note IntelliSense は単一構成しか持てないため Debug 相当で解決する。
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "NOMINMAX",
                "TOML_EXCEPTIONS=0",
                "IMGUI_DEFINE_MATH_OPERATORS",
                // @note CMake が $<CONFIG> から焼くマクロ。未定義だと参照箇所がグレーアウトする。
                "FBZZ_CMAKE_CONFIG=\"Debug\""
            ],
            "windowsSdkVersion": "10.0.26100.0",
            "cppStandard": "c++20",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}
