// @file    tasks.json
// @brief   VS Code から人がビルド・テスト・SDK 公開を叩くタスク一覧。入口は Tools/VcBuild.ps1。
// @author  Hasegawa Jin
// @date    2026-05-15
//
// @note Visual Studio の場所を知るのは Tools/VcBuild.ps1 だけ。ここに絶対パスを書かない。
// @note ビルドタスクは Configure へ dependsOn しない。VcBuild.ps1 が未 configure 時だけ configure し、CMakeLists.txt の変更は ZERO_CHECK が拾う。
// @note C++ ビルドは Kill: Engine Processes に依存させる。起動中のプロセスが DLL を掴むと LNK1168 でリンクが落ちる。
{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": [
                    "/d",
                    "/c"
                ]
            }
        }
    },
    "presentation": {
        "panel": "shared",
        "reveal": "always",
        "clear": true
    },
    "tasks": [
        // @name プロセス停止
        // @note taskkill は対象が居ないと exit 1 を返すので、exit 0 へ潰してタスク連鎖を止めない。
        {
            // @note テスト exe とベンチも DLL を掴み、終了時に入力待ちで残るので一緒に落とす。
            "label": "Kill: Engine Processes",
            "type": "shell",
            "command": "taskkill /F /T /IM FBZZEditor.exe >nul 2>&1 & taskkill /F /T /IM Sandbox.exe >nul 2>&1 & taskkill /F /T /IM SandboxStandalone.exe >nul 2>&1 & taskkill /F /T /IM FBZZTestsMathAuto.exe >nul 2>&1 & taskkill /F /T /IM FBZZTestsCoreAuto.exe >nul 2>&1 & taskkill /F /T /IM FBZZTestsPhysicsAuto.exe >nul 2>&1 & taskkill /F /T /IM FBZZTestsFluidAuto.exe >nul 2>&1 & taskkill /F /T /IM FBZZTestsEngineAuto.exe >nul 2>&1 & taskkill /F /T /IM FBZZTestsEditorAuto.exe >nul 2>&1 & taskkill /F /T /IM FBZZTestsCoreManual.exe >nul 2>&1 & taskkill /F /T /IM FBZZTestBench.exe >nul 2>&1 & exit 0",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        },
        {
            "label": "Kill: GameHub",
            "type": "shell",
            "command": "taskkill /F /T /IM FBZZGameHub.exe >nul 2>&1 & exit 0",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        },
        {
            "label": "Kill: All FBZZ Processes",
            "dependsOn": [
                "Kill: Engine Processes",
                "Kill: GameHub"
            ],
            "problemMatcher": []
        },

        // @name CMake Configure
        // @note 通常は不要。CMakePresets.json やキャッシュ変数を変えた後に明示的に作り直すときだけ使う。
        {
            "label": "CMake: Configure (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" configure debug",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Configure (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" configure development",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Configure (Release)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" configure release",
            "problemMatcher": "$msCompile"
        },

        // @name CMake Build — 全ターゲット
        // @note 全体ビルド成功後に VcBuild.ps1 が同構成の SDK を直列公開する。
        {
            "label": "CMake: Build All (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build debug debug",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build All (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build development development",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build All (Release)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build release release",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },

        // @name ビルド時間の計測
        // @note 増分を測るときは直前に 1 ファイルだけ保存し直してから走らせる。
        {
            "label": "Profile: Build Timing (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& '${workspaceFolder}\\Tools\\VcBuild.ps1' -Verb build -ConfigurePreset development -BuildPreset development -CMakeArguments @('--target', 'FBZZEditorLauncher', '--', '/clp:PerformanceSummary', '/v:m'); exit $LASTEXITCODE\"",
            "group": "build",
            "problemMatcher": []
        },

        // @name CMake Build — エディター
        // @note FBZZSDK を通して同構成の Editor と Engine を公開し、通常起動先を更新する。
        {
            "label": "CMake: Build Editor (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build debug debug --target FBZZSDK",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Editor (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build development development --target FBZZSDK",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Editor (Release)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build release release --target FBZZSDK",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },

        // @name CMake Build — Sandbox
        {
            "label": "CMake: Build Sandbox (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build debug debug --target Sandbox",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Sandbox (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build development development --target Sandbox",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Sandbox (Release)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build release release --target Sandbox",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },

        // @name テスト
        // @note --target を書き漏らしたスイートはエラーも警告も無くビルドされない。スイートを足したら下の 3 タスクへも足す。
        {
            "label": "CMake: Build Tests (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build debug debug --target FBZZTestsMathAuto --target FBZZTestsCoreAuto --target FBZZTestsPhysicsAuto --target FBZZTestsFluidAuto --target FBZZTestsEngineAuto --target FBZZTestsEditorAuto --target FBZZTestsGraphicsStandalone --target FBZZTestsCoreManual --target FBZZTestBench",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Tests (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build development development --target FBZZTestsMathAuto --target FBZZTestsCoreAuto --target FBZZTestsPhysicsAuto --target FBZZTestsFluidAuto --target FBZZTestsEngineAuto --target FBZZTestsEditorAuto --target FBZZTestsGraphicsStandalone --target FBZZTestsCoreManual --target FBZZTestBench",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Tests (Release)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build release release --target FBZZTestsMathAuto --target FBZZTestsCoreAuto --target FBZZTestsPhysicsAuto --target FBZZTestsFluidAuto --target FBZZTestsEngineAuto --target FBZZTestsEditorAuto --target FBZZTestsGraphicsStandalone --target FBZZTestsCoreManual --target FBZZTestBench",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },

        // @name スイート単位のビルドと実行
        // @note ${input:testSuite} は 1 回のタスク実行で 1 度だけ聞かれ、ビルドと実行へ同じ値が渡る。
        {
            "label": "Tests: Build Suite (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build debug debug --target ${input:testSuite}",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            // @note ctest を通さず exe を直接走らせ、落ちたケースの gtest 出力をそのまま読む。
            "label": "Tests: Run Suite (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" run debug ${input:testSuite}",
            "problemMatcher": []
        },
        {
            "label": "Tests: Build & Run Suite (Debug)",
            "dependsOn": [
                "Tests: Build Suite (Debug)",
                "Tests: Run Suite (Debug)"
            ],
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": []
        },
        {
            // @note 実行順に依存したテスト (TearDown の書き漏らし) は順序を混ぜないと出てこない。
            "label": "Tests: Shuffle Suite (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" run debug ${input:testSuite} --gtest_shuffle --gtest_repeat=10",
            "dependsOn": "Tests: Build Suite (Debug)",
            "group": "test",
            "problemMatcher": []
        },

        // @name ビジュアル検証ベンチ
        {
            "label": "Bench: Build (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build debug debug --target FBZZTestBench",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Bench: Build & Run (Debug)",
            "dependsOn": [
                "Bench: Build (Debug)",
                "Bench: Run (Debug)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Bench: Run (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" run debug FBZZTestBench",
            "problemMatcher": []
        },
        {
            "label": "Bench: Build & Run (Development)",
            "dependsOn": [
                "Bench: Build (Development)",
                "Bench: Run (Development)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Bench: Build (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build development development --target FBZZTestBench",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Bench: Run (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" run development FBZZTestBench",
            "problemMatcher": []
        },

        // @name カバレッジ
        // @note 行 (C0) は MSVC + OpenCppCoverage (普段用)、分岐・MC/DC は clang-cl + llvm-cov。計測対象は両系統で揃えてある。
        {
            // @pre winget install OpenCppCoverage.OpenCppCoverage。HTML / lcov は dotnet-reportgenerator-globaltool も要る。
            // @note 計測対象と出力先は Tools/Coverage/RunCoverage.ps1 が持つ (CI と共通)。
            "label": "Tests: Coverage (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\Coverage\\RunCoverage.ps1\" -BuildDir build/Debug -Config Debug",
            "dependsOn": "CMake: Build Tests (Debug)",
            "group": "test",
            "problemMatcher": []
        },
        {
            // @pre coverage preset は Ninja + clang-cl。VS インストーラーの «C++ Clang compiler for Windows» が要る。
            "label": "Coverage: Configure (clang-cl)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" configure coverage",
            "problemMatcher": "$msCompile"
        },
        {
            // @note build/Coverage へ分ける。build/Debug と共有すると計装済みと素のオブジェクトが混ざり、数字が再ビルド条件で変わる。
            "label": "Coverage: Build (clang-cl)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build coverage coverage --target FBZZTestsMathAuto --target FBZZTestsCoreAuto --target FBZZTestsPhysicsAuto --target FBZZTestsFluidAuto --target FBZZTestsEngineAuto --target FBZZTestsEditorAuto",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Coverage: Branch + MC/DC (clang-cl)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\Coverage\\RunCoverageLLVM.ps1\"",
            "dependsOn": "Coverage: Build (clang-cl)",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Coverage: Open Report",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Start-Process (Resolve-Path '${workspaceFolder}\\Artifacts\\Coverage\\report\\index.html')\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        },
        {
            "label": "Coverage: Open Report (Branch / MC/DC)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Start-Process (Resolve-Path '${workspaceFolder}\\Artifacts\\CoverageLLVM\\html\\index.html')\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        },
        {
            // @note ctest を通す。Core Manual は OS 状態を書き換えるので CTest 未登録で、ここでは走らない。
            "label": "Tests: Run (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" test debug",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": "CMake: Build Tests (Debug)",
            "problemMatcher": []
        },
        {
            "label": "Tests: Run (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" test development",
            "group": "test",
            "dependsOn": "CMake: Build Tests (Development)",
            "problemMatcher": []
        },
        {
            "label": "Tests: Run (Release)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" test release",
            "group": "test",
            "dependsOn": "CMake: Build Tests (Release)",
            "problemMatcher": []
        },

        // @name 共有 SDK の公開
        // @note 専用 preset を作らず通常 preset の成果物をそのまま SDK/<sdk-id>/ へ出す。開発用パスは DLL に焼かないので流用できる。
        {
            "label": "CMake: Build SDK (Debug)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build debug debug --target FBZZSDK",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build SDK (Development)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build development development --target FBZZSDK",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build SDK (Release)",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\Tools\\VcBuild.ps1\" build release release --target FBZZSDK",
            "group": "build",
            "dependsOn": "Kill: Engine Processes",
            "problemMatcher": "$msCompile"
        },

        // @name GameHub (Electron / TypeScript)
        {
            "label": "GameHub: Typecheck",
            "type": "npm",
            "script": "typecheck",
            "path": "Projects/GameHub",
            "problemMatcher": "$tsc"
        },
        {
            "label": "GameHub: Build (Debug)",
            "type": "npm",
            "script": "build:debug",
            "path": "Projects/GameHub",
            "group": "build",
            "dependsOn": "GameHub: Typecheck",
            "problemMatcher": []
        },
        {
            "label": "GameHub: Build (Development)",
            "type": "npm",
            "script": "build:development",
            "path": "Projects/GameHub",
            "group": "build",
            "dependsOn": "GameHub: Typecheck",
            "problemMatcher": []
        },
        {
            "label": "GameHub: Build (Release)",
            "type": "npm",
            "script": "build:release",
            "path": "Projects/GameHub",
            "group": "build",
            "dependsOn": "GameHub: Typecheck",
            "problemMatcher": []
        },
        {
            "label": "GameHub: Assemble Distribution (Debug)",
            "type": "npm",
            "script": "assemble:debug",
            "path": "Projects/GameHub",
            "problemMatcher": []
        },
        {
            "label": "GameHub: Assemble Distribution (Development)",
            "type": "npm",
            "script": "assemble:development",
            "path": "Projects/GameHub",
            "problemMatcher": []
        },
        {
            "label": "GameHub: Assemble Distribution (Release)",
            "type": "npm",
            "script": "assemble:release",
            "path": "Projects/GameHub",
            "problemMatcher": []
        },

        // @name 統合ビルド — GameHub から起動するまでの一式
        // @note GameHub は SDK/<sdk-id>/tools/ のエディターを起動する。SDK 公開 → Hub ビルドの順を固定し、片方だけ古い状態を防ぐ。
        {
            "label": "GameHub + SDK: Build (Debug)",
            "dependsOn": [
                "Kill: All FBZZ Processes",
                "CMake: Build SDK (Debug)",
                "GameHub: Build (Debug)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "GameHub + SDK: Build (Development)",
            "dependsOn": [
                "Kill: All FBZZ Processes",
                "CMake: Build SDK (Development)",
                "GameHub: Build (Development)"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "GameHub + SDK: Build (Release)",
            "dependsOn": [
                "Kill: All FBZZ Processes",
                "CMake: Build SDK (Release)",
                "GameHub: Build (Release)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },

        // @name 配布物の組み立て
        {
            "label": "Distribution: Assemble (Debug)",
            "dependsOn": [
                "GameHub + SDK: Build (Debug)",
                "GameHub: Assemble Distribution (Debug)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Distribution: Assemble (Development)",
            "dependsOn": [
                "GameHub + SDK: Build (Development)",
                "GameHub: Assemble Distribution (Development)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "Distribution: Assemble (Release)",
            "dependsOn": [
                "GameHub + SDK: Build (Release)",
                "GameHub: Assemble Distribution (Release)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },

        // @name EditorMcp (AI 連携サーバー)
        {
            "label": "EditorMcp: Build",
            "type": "npm",
            "script": "build",
            "path": "Projects/EditorMcp",
            "group": "build",
            "problemMatcher": "$tsc"
        },
        {
            "label": "EditorMcp: Test",
            "type": "npm",
            "script": "test",
            "path": "Projects/EditorMcp",
            "group": "test",
            "problemMatcher": "$tsc"
        }
    ],

    // @name タスク実行時に聞く値
    "inputs": [
        {
            "id": "testSuite",
            "type": "pickString",
            "description": "対象のテストスイート",
            "default": "FBZZTestsPhysicsAuto",
            "options": [
                {
                    "label": "Math — Vector / Quaternion / Matrix",
                    "value": "FBZZTestsMathAuto"
                },
                {
                    "label": "Core — アロケーター / Scheduler / TaskSystem / Signal / Logger / Time",
                    "value": "FBZZTestsCoreAuto"
                },
                {
                    "label": "Physics — GJK / EPA / Collider / AABB / BVH / XPBD",
                    "value": "FBZZTestsPhysicsAuto"
                },
                {
                    "label": "Fluid — 演算子評価 / GPU ステップ",
                    "value": "FBZZTestsFluidAuto"
                },
                {
                    "label": "Graphics — 単独パイプライン / DX12 描画",
                    "value": "FBZZTestsGraphicsStandalone"
                },
                {
                    "label": "Engine — RagdollRig",
                    "value": "FBZZTestsEngineAuto"
                },
                {
                    "label": "Editor — AI 連携 / import 判定 / Undo / プレハブ / 地形",
                    "value": "FBZZTestsEditorAuto"
                },
                {
                    "label": "Core Manual — Window / Cursor (OS 状態を書き換える)",
                    "value": "FBZZTestsCoreManual"
                }
            ]
        }
    ]
}
