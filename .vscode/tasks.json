{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": [
                    "/C",
                    "\"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" &&"
                ]
            }
        }
    },
    "tasks": [
        {
            "label": "CMake: Configure (Debug)",
            "type": "shell",
            "command": "cmake --preset debug",
            "group": "build",
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "CMake: Build (Debug)",
            "type": "shell",
            "command": "cmake --build --preset debug",
            "group": "build",
            "dependsOn": "CMake: Configure (Debug)",
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "CMake: Build GameHub (Debug)",
            "type": "shell",
            "command": "cmake --build --preset debug --target fbzz_hub fbzz_editor_launcher",
            "group": "build",
            "dependsOn": "CMake: Configure (Debug)",
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "CMake: Build EditorLauncher (Debug)",
            "type": "shell",
            "command": "cmake --build --preset debug --target fbzz_editor_launcher",
            "group": "build",
            "dependsOn": "CMake: Configure (Debug)",
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "CMake: Build Sandbox (Debug)",
            "type": "shell",
            "command": "cmake --build --preset debug --target sandbox",
            "group": "build",
            "dependsOn": "CMake: Configure (Debug)",
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "CMake: Build (Tests)",
            "type": "shell",
            "command": "cmake --build build/debug --target fbzz_tests",
            "group": "build",
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "CMake: Configure (Release)",
            "type": "shell",
            "command": "cmake --preset release",
            "group": "build",
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "CMake: Build (Release)",
            "type": "shell",
            "command": "cmake --build --preset release",
            "group": "build",
            "dependsOn": "CMake: Configure (Release)",
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "CMake: Build GameHub (Release)",
            "type": "shell",
            "command": "cmake --build --preset release --target fbzz_hub fbzz_editor_launcher",
            "group": { "kind": "build", "isDefault": true },
            "dependsOn": "CMake: Configure (Release)",
            "presentation": { "panel": "shared", "reveal": "always" }
        },
        {
            "label": "CMake: Build EditorLauncher (Release)",
            "type": "shell",
            "command": "cmake --build --preset release --target fbzz_editor_launcher",
            "group": "build",
            "dependsOn": "CMake: Configure (Release)",
            "presentation": { "panel": "shared", "reveal": "always" }
        }
    ]
}
