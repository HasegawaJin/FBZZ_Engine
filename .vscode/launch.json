// @file    launch.json
// @brief   Editor、ゲーム、テストのデバッグ起動構成。
// @author  Hasegawa Jin
// @date    2026-05-15
// @note Editor は起動前に同構成の SDK を公開し、SDK 配置へ直接デバッガーを付ける。
// @note SDK の版は CMake PROJECT_VERSION と揃え、版更新時にこの起動設定も更新する。
// @note FBZZ_SDK_ROOT と FBZZ_ENGINE_ASSET_ROOT は同じ公開 SDK を指す。
// @note FBZZ_SKIP_ENGINE_REBUILD は source tree の部分更新とデバッガーの離脱を抑止する。
// @note Sandbox、テスト、ベンチは build の検証用配置から起動する。
// @note GameHub は SDK Editor を detached 起動するため、必要時は Attach を使う。
// @see Docs/design/shared-engine-sdk.md
{
    "version": "0.2.0",
    "configurations": [
        // @note ------------------------------------------------------------------
        // @note エディター — 公開 SDK へ直接デバッグ起動
        // @note ------------------------------------------------------------------
        {
            "name": "FBZZEditor (Development)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/SDK/0.9.1/tools/Development/Editor/FBZZEditor.exe",
            "args": [
                "--project",
                "${input:fbzzProjectPath}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/SDK/0.9.1/tools/Development/Editor",
            "environment": [
                { "name": "FBZZ_SDK_ROOT", "value": "${workspaceFolder}/SDK/0.9.1" },
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/SDK/0.9.1/share/fbzz/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Editor (Development)",
            "presentation": { "group": "1_editor", "order": 1 }
        },
        {
            "name": "FBZZEditor (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/SDK/0.9.1/tools/Debug/Editor/FBZZEditor.exe",
            "args": [
                "--project",
                "${input:fbzzProjectPath}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/SDK/0.9.1/tools/Debug/Editor",
            "environment": [
                { "name": "FBZZ_SDK_ROOT", "value": "${workspaceFolder}/SDK/0.9.1" },
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/SDK/0.9.1/share/fbzz/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Editor (Debug)",
            "presentation": { "group": "1_editor", "order": 2 }
        },
        {
            // @note GPU リソースの漏れを追う日に使う。Development の速度のまま D3D 検証レイヤーを立てる。
            // @note 検証レイヤーは API 呼び出しごとに負荷が掛かるので、通常の Development 起動では
            // @note 立てない (立てるのはこの構成と Debug だけ)。
            "name": "FBZZEditor (Development + GPU Validation)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/SDK/0.9.1/tools/Development/Editor/FBZZEditor.exe",
            "args": [
                "--project",
                "${input:fbzzProjectPath}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/SDK/0.9.1/tools/Development/Editor",
            "environment": [
                { "name": "FBZZ_SDK_ROOT", "value": "${workspaceFolder}/SDK/0.9.1" },
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/SDK/0.9.1/share/fbzz/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" },
                { "name": "FBZZ_GPU_VALIDATION", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Editor (Development)",
            "presentation": { "group": "1_editor", "order": 3 }
        },
        {
            "name": "FBZZEditor (Development + DeveloperMode)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/SDK/0.9.1/tools/Development/Editor/FBZZEditor.exe",
            "args": [ "--project", "${input:fbzzProjectPath}", "--developer" ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/SDK/0.9.1/tools/Development/Editor",
            "environment": [
                { "name": "FBZZ_SDK_ROOT", "value": "${workspaceFolder}/SDK/0.9.1" },
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/SDK/0.9.1/share/fbzz/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Editor (Development)",
            "presentation": { "group": "1_editor", "order": 5 }
        },
        {
            "name": "FBZZEditor (Debug + DeveloperMode)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/SDK/0.9.1/tools/Debug/Editor/FBZZEditor.exe",
            "args": [ "--project", "${input:fbzzProjectPath}", "--developer" ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/SDK/0.9.1/tools/Debug/Editor",
            "environment": [
                { "name": "FBZZ_SDK_ROOT", "value": "${workspaceFolder}/SDK/0.9.1" },
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/SDK/0.9.1/share/fbzz/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Editor (Debug)",
            "presentation": { "group": "1_editor", "order": 6 }
        },
        {
            "name": "FBZZEditor (Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/SDK/0.9.1/tools/Release/Editor/FBZZEditor.exe",
            "args": [ "--project", "${input:fbzzProjectPath}" ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/SDK/0.9.1/tools/Release/Editor",
            "environment": [
                { "name": "FBZZ_SDK_ROOT", "value": "${workspaceFolder}/SDK/0.9.1" },
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/SDK/0.9.1/share/fbzz/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Editor (Release)",
            "presentation": { "group": "1_editor", "order": 7 }
        },
        {
            // @note GameHub から起動した Editor はデバッガーを持たないので、
            // @note 後からここでアタッチする。プロセス一覧から FBZZEditor.exe を選ぶ。
            "name": "Attach: FBZZ プロセス",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "requireExactSource": false,
            "presentation": { "group": "1_editor", "order": 4 }
        },

        // @note ------------------------------------------------------------------
        // @note ランタイム / テスト
        // @note ------------------------------------------------------------------
        {
            "name": "Sandbox (Development)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Development/Binaries/Development/Sandbox/Sandbox.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Development/Binaries/Development/Sandbox",
            "environment": [
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Sandbox (Development)",
            "presentation": { "group": "2_runtime", "order": 1 }
        },
        {
            "name": "Sandbox (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Binaries/Debug/Sandbox/Sandbox.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug/Binaries/Debug/Sandbox",
            "environment": [
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Sandbox (Debug)",
            "presentation": { "group": "2_runtime", "order": 2 }
        },
        {
            // @note --gtest_filter を渡したい時のために引数を対話入力にしてある。
            // @note 空 Enter で全テスト実行。
            "name": "Tests: Core Auto (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests/FBZZTestsCoreAuto.exe",
            "args": [
                "${input:gtestFilter}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests",
            "environment": [],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Tests (Debug)",
            "presentation": { "group": "2_runtime", "order": 3 }
        },
        {
            "name": "Tests: Math Auto (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests/FBZZTestsMathAuto.exe",
            "args": [
                "${input:gtestFilter}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests",
            "environment": [],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Tests (Debug)",
            "presentation": { "group": "2_runtime", "order": 4 }
        },
        {
            "name": "Tests: Physics Auto (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests/FBZZTestsPhysicsAuto.exe",
            "args": [
                "${input:gtestFilter}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests",
            "environment": [],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Tests (Debug)",
            "presentation": { "group": "2_runtime", "order": 5 }
        },
        {
            "name": "Tests: Engine Auto (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests/FBZZTestsEngineAuto.exe",
            "args": [
                "${input:gtestFilter}"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests",
            "environment": [],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Tests (Debug)",
            "presentation": { "group": "2_runtime", "order": 6 }
        },
        {
            // @note Window / Cursor の OS 状態を触るため CTest には登録されていない。
            // @note 手動で確認したい時だけここから起動する。
            "name": "Tests: Core Manual (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests/FBZZTestsCoreManual.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests",
            "environment": [],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "CMake: Build Tests (Debug)",
            "presentation": { "group": "2_runtime", "order": 7 }
        },
        {
            // @note ビジュアル検証ベンチ。合否はコードではなく目で判断する層。
            // @note DX11 固定で起動するので dxcompiler.dll は要らない。
            "name": "Bench: Visual (Development)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Development/Binaries/Development/Tests/FBZZTestBench.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Development/Binaries/Development/Tests",
            "environment": [
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "Bench: Build (Development)",
            "presentation": { "group": "2_runtime", "order": 8 }
        },
        {
            "name": "Bench: Visual (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests/FBZZTestBench.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug/Binaries/Debug/Tests",
            "environment": [
                { "name": "FBZZ_ENGINE_ASSET_ROOT", "value": "${workspaceFolder}/Assets" },
                { "name": "FBZZ_SKIP_ENGINE_REBUILD", "value": "1" }
            ],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "Bench: Build (Debug)",
            "presentation": { "group": "2_runtime", "order": 9 }
        },

        // @note ------------------------------------------------------------------
        // @note GameHub — 実際のユーザー起動経路 (Editor にはデバッガーが付かない)
        // @note ------------------------------------------------------------------
        {
            "name": "GameHub + SDK (Development)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Projects/GameHub/out/Development/FBZZGameHub-win32-x64/FBZZGameHub.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Projects/GameHub/out/Development/FBZZGameHub-win32-x64",
            "environment": [],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "GameHub + SDK: Build (Development)",
            "postDebugTask": "Kill: All FBZZ Processes",
            "presentation": { "group": "3_hub", "order": 1 }
        },
        {
            "name": "GameHub + SDK (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Projects/GameHub/out/Debug/FBZZGameHub-win32-x64/FBZZGameHub.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Projects/GameHub/out/Debug/FBZZGameHub-win32-x64",
            "environment": [],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "GameHub + SDK: Build (Debug)",
            "postDebugTask": "Kill: All FBZZ Processes",
            "presentation": { "group": "3_hub", "order": 2 }
        },
        {
            "name": "GameHub + SDK (Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Projects/GameHub/out/Release/FBZZGameHub-win32-x64/FBZZGameHub.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Projects/GameHub/out/Release/FBZZGameHub-win32-x64",
            "environment": [],
            "console": "integratedTerminal",
            "requireExactSource": false,
            "preLaunchTask": "GameHub + SDK: Build (Release)",
            "postDebugTask": "Kill: All FBZZ Processes",
            "presentation": { "group": "3_hub", "order": 3 }
        },

        // @note ------------------------------------------------------------------
        // @note ツール
        // @note ------------------------------------------------------------------
        {
            "name": "EditorMcp Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/Projects/EditorMcp/dist/stdio.js",
            "cwd": "${workspaceFolder}/Projects/EditorMcp",
            "console": "integratedTerminal",
            "env": {
                "FBZZ_MCP_PERMISSION": "write"
            },
            "skipFiles": [
                "<node_internals>/**"
            ],
            "preLaunchTask": "EditorMcp: Build",
            "presentation": { "group": "4_tools", "order": 1 }
        }
    ],
    "inputs": [
        {
            // @note 既定はリポジトリ同梱のサンプルプロジェクト。
            // @note 空プロジェクトから確認したい時は Projects/GameHub/Templates/standard を指定する。
            "id": "fbzzProjectPath",
            "type": "promptString",
            "description": "FBZZ プロジェクトフォルダー",
            "default": "${workspaceFolder}/GreenWare"
        },
        {
            "id": "gtestFilter",
            "type": "promptString",
            "description": "GoogleTest フィルター (空なら全実行)",
            "default": "--gtest_filter=*"
        }
    ]
}
