# @file    .gitignore
# @brief   再生成できる出力と個人設定を Git の追跡対象から除く。
# @author  Hasegawa Jin
# @date    2026-05-15
# @note Build
build/
out/
build_log.txt
.cache/
/SDK/
# @note レポート類の置き場。リポジトリ直下 (coverage) と、各ゲームプロジェクト直下
# @note (エディターが吐く RenderGraph の構成テキストなど) の両方に出る。
Artifacts/
# @note OpenCppCoverage が計測のたびに作業ディレクトリへ吐く実行ログ。
LastCoverageResults.log
# @note ゲームプロジェクトの配布ビルド出力。exe / dll だけでなく、その隣へ複製される
# @note EngineAssets / Library まで丸ごと入るため (GreenWare で 480MB) ディレクトリごと除外する。
Binaries/
# @note BuildSettings.outputDirectory の既定先 (<Project>/Builds/<name>)。
# @note 複製された Assets 配下は .toml / .meta / .scene など拡張子ルールに掛からない
# @note ファイルも持つため、上の Binaries/ と同じ理由でディレクトリごと除外する。
Builds/
# @note DCC からの書き出しを Assets へ配備する前に一度受ける中継置き場。
# @note 配備が済めば Assets 側が正本になり、ここは同じ FBX の二重持ちにしかならない。
/Temp/
# @note 一回きりのスクリプト・調査用コードの置き場 (AGENTS.md «ツールの置き場所»)。
# @note Tools / DevTools / <Project>/Tools は索引で入場を管理し、ここへ置いたものは履歴に残さない。
Scratch/

# @note CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CMakeUserPresets.json

# @note Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# @note VSCode (個人設定のみ除外、共有設定は追跡する)
.vscode/settings.json
.vscode/*.code-workspace

# @note Binaries
*.exe
*.dll
*.lib
*.a
*.o
*.obj
*.pdb
*.ilk
*.exp
# @note コンパイル済みシェーダーは HLSL から再生成できるため追跡しない。
*.cso

# @note ThirdParty の lib / dll / exp は通常は追跡しないが、
# @note Assimp / DirectXTex のプリコンパイル済みバイナリはリポジトリに含める
!ThirdParty/**/*.lib
!ThirdParty/**/*.dll
!ThirdParty/**/*.exp

# @note imgui.ini (ImGui の設定ファイル)
imgui.ini
editor_config/hub_imgui.ini

# @note プロジェクト内 (<Project>/Assets/EditorConfig/) のエディター個人設定。
# @note ウィンドウ配置と Play 中の一時退避で、触った人の分だけ毎回書き換わる。
# @note 共有する意味が無いうえ、追跡すると全員が同じ行で衝突し続ける。
# @note editor_settings.toml は起動シーン等の共有設定を持つので追跡したままにする。
**/Assets/EditorConfig/imgui_layout.ini
**/Assets/EditorConfig/vfx_editor.ini
**/Assets/EditorConfig/.playmode_snapshot.scene
# @note 本体を追跡しないので .meta も持たない (孤児 .meta を作らないため)。
**/Assets/EditorConfig/imgui_layout.ini.meta
**/Assets/EditorConfig/vfx_editor.ini.meta
**/Assets/EditorConfig/.playmode_snapshot.scene.meta

# @note Claude Code — 個人設定は追跡せず、全員に効くフック・権限 (settings.json) とスキルだけ共有する
.claude/*
!.claude/settings.json
!.claude/skills/

# @note OS
.DS_Store
Thumbs.db

# @note エディターの個人設定ファイル
/editor_config

# @note ThirdParty dependencies are vendored and should be tracked completely.
!ThirdParty/
!ThirdParty/**

# @note Library — import 生成物 (baked) のキャッシュ。ソースから再生成できるため追跡しない
**/Library/

# @note Saved — クラッシュレポート (Docs/design/crash-report.md) など実行時に書くもの
**/Saved/

# @note .fbzz — エディターのプロジェクトローカル作業領域。
# @note Trash/ には Asset Browser で削除したアセットの実体が退避される (自動削除しない) ため、
# @note 追跡すると「消したはずのもの」が履歴に残り続ける。
**/.fbzz/

# @note Assets — 大容量バイナリ素材のみ除外 (10MB 超の恐れがあるもの)
# @note **/Assets/** とすることで Projects/GameHub/Templates/standard/Assets/ 等にも適用
# @note テキスト系 (シェーダー / スクリプト / マテリアル定義 / シーン) は追跡する
**/Assets/**/*.fbx
**/Assets/**/*.dds
**/Assets/**/*.png
**/Assets/**/*.jpg
**/Assets/**/*.jpeg
**/Assets/**/*.bmp
**/Assets/**/*.tga
**/Assets/**/*.hdr
**/Assets/**/*.exr
**/Assets/**/*.mp3
**/Assets/**/*.wav
**/Assets/**/*.ogg
# @note .meta は追跡する: AssetDatabase の GUID を保持するため (Unity と同じ)。
# @note クローン先で GUID が再発行されると guid: 参照が全て切れるので必ずコミットする。

# @note 例外: GameHub のテンプレートだけは .meta を持たない。
# @note テンプレートは «内容» を配るもので、guid (そのプロジェクト内の識別子) は配れない。
# @note 新規プロジェクトでは .meta が作り直されて guid が変わるため、テンプレートに
# @note guid を残すと参照が全て切れる (実際 Player.animcontroller が一度そうなった)。
# @note テンプレート内の参照は素のパスで持ち、初回保存でそのプロジェクトの guid へ
# @note 再エンコードさせる。.meta 自体は AssetDatabase が起動時に自動生成する。
Projects/GameHub/Templates/**/*.meta
**/Assets/**/*.mesh
**/Assets/**/*.fzasset
**/Assets/**/*.skel
**/Assets/**/*.anim
**/Assets/**/*.ibl
**/Assets/**/*.cso
**/Assets/**/compile_log.txt
**/Assets/**/compile_ui_log.txt

# @note GreenWare だけは例外で素材を追跡する (Git LFS 経由。対象は .gitattributes)。
# @note 素材が無いと clone しても GreenWare が起動せず、公開する意味が無い。
# @note 除外したままなのはベイク出力 (.fzasset / .anim / .skel / .cso / .ibl) と
# @note IBL の .dds — いずれもソースから再生成でき、LFS は差分を持たないため
# @note 焼き直すたびに旧版のフルコピーが無料枠を食う。
!GreenWare/Assets/**/*.fbx
!GreenWare/Assets/**/*.png
!GreenWare/Assets/**/*.jpg
!GreenWare/Assets/**/*.jpeg
!GreenWare/Assets/**/*.bmp
!GreenWare/Assets/**/*.tga
!GreenWare/Assets/**/*.hdr
!GreenWare/Assets/**/*.exr
!GreenWare/Assets/**/*.wav
!GreenWare/Assets/**/*.mp3
!GreenWare/Assets/**/*.ogg

# @note DCC の作業ファイル置き場 (.blend)。MiniBotC と Boss03 だけで 4.5GB あり、
# @note LFS の無料枠 (1GB) にも GitHub の推奨リポジトリサイズにも収まらない。
# @note エンジンは読まないので、clone 側は Assets/ に配備済みの FBX だけで動く。
GreenWare/Assets/_src/
GreenWare/Assets/_src.meta

# @note モデル制作の記録 (レンダー画像・検証動画・Tripo への入力 zip)。112MB。
# @note Assets/ の外なので LFS の対象にもならず、通常 blob で履歴に積み上がる。
Docs/Art/

# @note Projects 内の大容量アセット (100MB 超) — GitHub 上限のため除外
Projects/GameHub/Templates/standard/Assets/Nature/Tree/**

# @note Python bytecode (GreenWare/Tools/BlenderExport など)
__pycache__/
*.pyc

# @note 手動バックアップファイル
*.bak
*.bak_*
*.bisect_backup

# @note 作業中の退避ディレクトリ。差し替え前のシーン・スクリプトの旧版を置く場所で、
# @note 手元でしか意味を持たない。追跡すると公開リポジトリに旧版が二重に残り続ける。
_session_backup_*/
