# Build
build/
out/
build_log.txt
.cache/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CMakeUserPresets.json

# Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# VSCode (個人設定のみ除外、共有設定は追跡する)
.vscode/settings.json
.vscode/*.code-workspace

# Binaries
*.exe
*.dll
*.lib
*.a
*.o
*.obj
*.pdb
*.ilk
*.exp

# ThirdParty の lib / dll / exp は通常は追跡しないが、
# Assimp / DirectXTex のプリコンパイル済みバイナリはリポジトリに含める
!ThirdParty/**/*.lib
!ThirdParty/**/*.dll
!ThirdParty/**/*.exp

# imgui.ini (ImGui の設定ファイル)
imgui.ini
editor_config/hub_imgui.ini

# Claude Code (ローカル設定)
.claude/

# OS
.DS_Store
Thumbs.db

# エディターの個人設定ファイル
/editor_config

# ThirdParty dependencies are vendored and should be tracked completely.
!ThirdParty/
!ThirdParty/**

# Assets — シェーダー/シーン/テクスチャ/マテリアル等すべて Git 管理対象外
# ローカルのみで管理する。重要ファイルは別途バックアップすること。
Assets/

# Projects 内の大容量アセット (100MB 超) — GitHub 上限のため除外
Projects/GameHub/Templates/standard/Assets/Nature/Tree/**
