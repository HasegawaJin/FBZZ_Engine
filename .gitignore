# Third-party libraries (ImGui は未導入のため除外)
third_party/ImGui/

# third_party の lib / dll / exp は通常は追跡しないが、
# Assimp / DirectXTex のプリコンパイル済みバイナリはリポジトリに含める
!third_party/**/*.lib
!third_party/**/*.dll
!third_party/**/*.exp

# imgui.ini (ImGui の設定ファイル)
imgui.ini

