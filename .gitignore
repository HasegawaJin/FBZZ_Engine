# Build
build/
out/
build_log.txt
.cache/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# VSCode (個人設定のみ除外、共有設定は追跡する)
.vscode/settings.json
.vscode/*.code-workspace

# Binaries
*.exe
*.dll
*.lib
*.a
*.o
*.obj
*.pdb
*.ilk
*.exp

# ThirdParty の lib / dll / exp は通常は追跡しないが、
# Assimp / DirectXTex のプリコンパイル済みバイナリはリポジトリに含める
!ThirdParty/**/*.lib
!ThirdParty/**/*.dll
!ThirdParty/**/*.exp

# imgui.ini (ImGui の設定ファイル)
imgui.ini

# コンパイル済みシェーダー (dxc でビルド時生成)
Assets/shaders/compiled/

# Claude Code (ローカル設定)
.claude/

# OS
.DS_Store
Thumbs.db

# エディターの個人設定ファイル
/editor_config
