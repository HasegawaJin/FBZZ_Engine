# Build
build/
out/
build_log.txt
.cache/
/SDK/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CMakeUserPresets.json

# Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# VSCode (個人設定のみ除外、共有設定は追跡する)
.vscode/settings.json
.vscode/*.code-workspace

# Binaries
*.exe
*.dll
*.lib
*.a
*.o
*.obj
*.pdb
*.ilk
*.exp

# ThirdParty の lib / dll / exp は通常は追跡しないが、
# Assimp / DirectXTex のプリコンパイル済みバイナリはリポジトリに含める
!ThirdParty/**/*.lib
!ThirdParty/**/*.dll
!ThirdParty/**/*.exp

# imgui.ini (ImGui の設定ファイル)
imgui.ini
editor_config/hub_imgui.ini

# Claude Code (ローカル設定)
.claude/

# OS
.DS_Store
Thumbs.db

# エディターの個人設定ファイル
/editor_config

# ThirdParty dependencies are vendored and should be tracked completely.
!ThirdParty/
!ThirdParty/**

# Library — import 生成物 (baked) のキャッシュ。ソースから再生成できるため追跡しない
**/Library/

# Assets — 大容量バイナリ素材のみ除外 (10MB 超の恐れがあるもの)
# **/Assets/** とすることで Projects/GameHub/Templates/standard/Assets/ 等にも適用
# テキスト系 (シェーダー / スクリプト / マテリアル定義 / シーン) は追跡する
**/Assets/**/*.fbx
**/Assets/**/*.dds
**/Assets/**/*.png
**/Assets/**/*.jpg
**/Assets/**/*.jpeg
**/Assets/**/*.bmp
**/Assets/**/*.tga
**/Assets/**/*.hdr
**/Assets/**/*.exr
**/Assets/**/*.mp3
**/Assets/**/*.wav
**/Assets/**/*.ogg
# .meta は追跡する: AssetDatabase の GUID を保持するため (Unity と同じ)。
# クローン先で GUID が再発行されると guid: 参照が全て切れるので必ずコミットする。
**/Assets/**/*.mesh
**/Assets/**/*.fzasset
**/Assets/**/*.skel
**/Assets/**/*.anim
**/Assets/**/*.ibl
**/Assets/**/*.cso
**/Assets/**/compile_log.txt
**/Assets/**/compile_ui_log.txt

# Projects 内の大容量アセット (100MB 超) — GitHub 上限のため除外
Projects/GameHub/Templates/standard/Assets/Nature/Tree/**

# Python bytecode (Tools/BlenderExport など)
__pycache__/
*.pyc

# 手動バックアップファイル
*.bak
*.bak_*
